---
interface Props { heading: string; body: string; href: string; label: string; affiliate?: boolean; }
const { heading, body, href, label, affiliate = false } = Astro.props;
---
<aside class="blog-offer" aria-label={heading}>
  <h3>{heading}</h3>
  <p>{body}</p>
  {affiliate && <p class="disclosure">Affiliate link: Dudela may earn a commission if you purchase through this link.</p>}
  <a class="btn btn-primary" href={href} rel={affiliate ? "sponsored noopener" : undefined}>{label} <span aria-hidden="true">→</span></a>
</aside>
<style>
  .blog-offer { padding: 1.5rem; margin: 2.25rem 0; background: var(--bg-light-raised); border: 1px solid var(--border-light); border-radius: var(--radius-md); }
  .blog-offer h3 { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; margin: 0 0 .75rem; }
  .blog-offer .disclosure { font-size: .85rem; }
  .blog-offer a.btn { color: var(--forest-900, #12180f); white-space: normal; text-align: center; max-width: 100%; }
</style>
