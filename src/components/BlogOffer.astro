---
interface Props { heading: string; body: string; href: string; label: string; affiliate?: boolean; }
const { heading, body, href, label, affiliate = false } = Astro.props;
---
<!-- REWRITTEN 2026-09-11: the affiliate line used to open with "Affiliate
     link:" in normal body-text size/weight — same font as the pitch above
     it, so it read as a second, contradicting sentence about the same
     recommendation ("here's a great thing" / "also this is an ad") right
     before the button, which worked against clicking through. Same
     substance (still discloses it's an affiliate link, still says a
     commission may be earned, still sits right next to the link per FTC's
     "clear and conspicuous, near the link" standard — nothing about the
     legal requirement changed) but now small and quiet like the merch
     page's affiliate banner (see merch.astro), not competing with the
     actual pitch for attention. -->
<aside class="blog-offer" aria-label={heading}>
  <h3>{heading}</h3>
  <p>{body}</p>
  {affiliate && <p class="disclosure">We're an affiliate partner — this link may earn us a small commission at no extra cost to you.</p>}
  <a class="btn btn-primary" href={href} rel={affiliate ? "sponsored noopener" : undefined}>{label} <span aria-hidden="true">→</span></a>
</aside>
<style>
  .blog-offer { padding: 1.5rem; margin: 2.25rem 0; background: var(--bg-light-raised); border: 1px solid var(--border-light); border-radius: var(--radius-md); }
  .blog-offer h3 { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; margin: 0 0 .75rem; }
  .blog-offer .disclosure { margin: .6rem 0 0; font-size: .68rem; line-height: 1.4; color: var(--text-on-light-muted, inherit); opacity: .75; }
  .blog-offer a.btn { color: var(--forest-900, #12180f); white-space: normal; text-align: center; max-width: 100%; }
</style>
