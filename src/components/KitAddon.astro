---
// The $17 add-on step for the Prep Kit (added 2026-10-19). Drop this on any
// page with a "Get the Prep Kit" link. It catches clicks on links to
// /api/create-checkout-session?product=prep-kit and asks once:
// add Her Copy + Delivery Room Pack for $17? "Yes" goes to Stripe with
// &addon=1 (a second line item), "No" goes to the plain $37 checkout.
// Without JavaScript the link still works and goes straight to checkout.
---
<dialog id="kit-addon" class="kit-addon" aria-labelledby="kit-addon-title">
  <form method="dialog" class="ka-close-form"><button class="ka-x" aria-label="Close">&times;</button></form>
  <p class="ka-eyebrow">Before checkout</p>
  <h2 id="kit-addon-title">Add the two things dads ask for next?</h2>
  <div class="ka-items">
    <div class="ka-item">
      <img src="/images/addons/her-copy.jpg" alt="Her Copy cover" width="120" height="155" loading="lazy" />
      <div>
        <h3>Her Copy <span>$19</span></h3>
        <p>Her side of the plan. The same worksheets, written for her, so you're not guessing what she needs. Fill them out separately, then compare.</p>
      </div>
    </div>
    <div class="ka-item">
      <img src="/images/addons/delivery-pack.jpg" alt="Delivery Room Pack wallet card and phone wallpaper" width="120" height="155" loading="lazy" />
      <div>
        <h3>The Delivery Room Pack <span>$12</span></h3>
        <p>Two wallet cards and three lock-screen wallpapers: your job in the room, what to ask before big decisions, and what to do if the plan changes.</p>
      </div>
    </div>
  </div>
  <a class="btn btn-primary ka-yes" id="ka-yes" href="#">Yes, add both for $17 <small>(save $14)</small></a>
  <a class="ka-no" id="ka-no" href="#">No thanks, just the kit ($37)</a>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById("kit-addon");
    if (!dlg || typeof dlg.showModal !== "function") return;
    var base = "";
    document.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest('a[href*="create-checkout-session?product=prep-kit"]');
      if (!a || a.id === "ka-yes" || a.id === "ka-no") return;
      e.preventDefault();
      base = a.getAttribute("href").replace(/&addon=1/, "");
      document.getElementById("ka-yes").href = base + "&addon=1";
      document.getElementById("ka-no").href = base;
      dlg.showModal();
    });
    document.getElementById("ka-yes").addEventListener("click", function () {
      if (window.fbq) fbq("track", "AddToCart", { value: 17, currency: "USD", content_name: "Her Copy + Delivery Room Pack" });
    });
    dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
  })();
</script>

<style is:global>
  .kit-addon { width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 32px); overflow-y: auto; border: 0; border-radius: 14px; padding: 1.75rem 1.5rem 1.4rem; background: #faf6ee; color: #1c2319; box-shadow: 0 40px 90px -30px rgba(0,0,0,.6); }
  .kit-addon::backdrop { background: rgba(10, 14, 8, 0.72); }
  .kit-addon .ka-close-form { position: absolute; top: 0.5rem; right: 0.6rem; margin: 0; }
  .kit-addon .ka-x { background: none; border: 0; font-size: 1.8rem; line-height: 1; color: #5d6655; cursor: pointer; padding: 0.25rem 0.5rem; }
  .kit-addon .ka-eyebrow { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; color: #a3492b; margin: 0 0 0.4rem; }
  .kit-addon h2 { font-family: var(--font-display); font-size: clamp(1.4rem, 4.5vw, 1.8rem); line-height: 1.15; margin: 0 0 1.1rem; color: #12180f; }
  .kit-addon .ka-items { display: grid; gap: 0.9rem; margin-bottom: 1.25rem; }
  .kit-addon .ka-item { display: grid; grid-template-columns: 84px 1fr; gap: 0.9rem; align-items: start; background: #fff; border: 1px solid #ece3d1; border-radius: 10px; padding: 0.8rem; }
  .kit-addon .ka-item img { width: 84px; height: auto; border-radius: 4px; display: block; }
  .kit-addon h3 { font-family: var(--font-display); font-size: 1.12rem; margin: 0 0 0.25rem; color: #12180f; }
  .kit-addon h3 span { font-family: var(--font-label); font-size: 0.8rem; color: #5d6655; text-decoration: line-through; margin-left: 0.35rem; }
  .kit-addon .ka-item p { font-size: 0.88rem; line-height: 1.45; margin: 0; color: #4a5243; }
  .kit-addon .ka-yes { display: block; width: 100%; text-align: center; }
  .kit-addon .ka-yes small { font-weight: 400; opacity: 0.8; }
  .kit-addon .ka-no { display: block; text-align: center; margin-top: 0.85rem; font-size: 0.9rem; color: #5d6655; }
</style>
