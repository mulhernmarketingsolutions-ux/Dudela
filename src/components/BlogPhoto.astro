---
// Real photo counterpart to PhotoPlaceholder — same aspect-ratio/margin
// footprint in the post flow, swapped in once a placeholder's scene has a
// sourced photo. Sourced from Pexels (free, no attribution required); alt
// text carries the description instead of a visible credit line, matching
// how the site's other stock photos (turn.astro's Unsplash shots) are
// already handled.
export interface Props {
  src: string;
  alt: string;
  ratio?: string; // e.g. "16/9", "4/5"
  class?: string;
  position?: string; // object-position, e.g. "left center" -- for source photos
                      // whose subject sits off-center, so a cover-crop doesn't
                      // cut into it
}
const { src, alt, ratio = "4/5", class: klass = "", position = "center" } = Astro.props;
---
<img
  class={`blog-photo ${klass}`}
  style={`aspect-ratio: ${ratio}; object-position: ${position};`}
  src={src}
  alt={alt}
  loading="lazy"
/>

<style>
  .blog-photo {
    width: 100%;
    display: block;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin: 2rem 0;
  }
</style>
