---
// id values must match the `id` on each stage in Roadmap.astro's `stages`
// array -- these used to be slugified from the label text (e.g. "New Dad"
// -> "new-dad"), which doesn't match Roadmap's actual ids ("first-night",
// "8wk", "third-tri", "sleep-regression", etc). Roadmap.astro silently
// no-ops on an unknown id (selectStage() returns false), so every button
// except "Hospital" landed on whatever the default panel happened to be
// instead of the stage it named. Mapped by hand here since these six
// broad buckets don't line up 1:1 with Roadmap's more granular stages.
const stages = [
  { label: "Trying to Conceive", id: "ttc" },
  { label: "First Trimester", id: "8wk" },
  { label: "Third Trimester", id: "third-tri" },
  { label: "Hospital", id: "hospital" },
  { label: "New Dad", id: "first-night" },
  { label: "Sleep", id: "sleep-regression" },
];
---
<section class="stage-picker section-light">
  <div class="container stage-picker-inner">
    <h2>Where are you today?</h2>
    <div class="stage-options">
      {stages.map((s) => (
        <a href={`/prepare?stage=${encodeURIComponent(s.id)}#roadmap`} class="stage-option">
          {s.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .stage-picker {
    padding: var(--space-6) 0 var(--space-7);
    text-align: center;
  }
  .stage-picker h2 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    margin: 0 0 2.5rem;
  }
  .stage-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }
  .stage-option {
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-light);
    text-decoration: none;
    color: var(--text-on-light);
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .stage-option:hover {
    background: var(--forest-800);
    color: var(--cream-100);
    border-color: var(--forest-800);
  }
</style>
