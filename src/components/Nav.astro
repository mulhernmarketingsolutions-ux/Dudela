---
// Single Feather-style "user" glyph, same stroke pattern used for icons
// elsewhere on the site (Roadmap.astro, member/dashboard.astro) — just the
// one-person icon since this is specifically the "log in / my account"
// entry point, not the multi-person "Circle" icon used in the dashboard.
const ICONS = {
  user: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  // Plain mic capsule + stand, built from basic shapes rather than a
  // copy-pasted icon-set path — same stroke-based look as the user glyph
  // above (round caps/joins, currentColor), just simple enough to not need
  // exact source data.
  mic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/></svg>`,
};

// Optional — only pages that already resolved the visitor's session via
// getAuthedMember (the SSR /member/* pages) can pass this in. Marketing
// pages are prerendered statically and have no per-request cookie access,
// so they can't know auth state at build time — they fall back to the
// always-safe "Member Login" default, same as before.
//
// When authed, this points at the dashboard, not logout — an earlier
// version pointed the icon straight at /api/auth/logout, so clicking the
// "I'm logged in" icon from anywhere on the site silently signed the
// visitor out and dropped them back on the login screen, which is the
// opposite of what a person expects from tapping their own account icon.
// Logging out stays a deliberate, separate action (the "Log out" link on
// the dashboard itself) rather than the single click target of the icon.
export interface Props {
  isAuthed?: boolean;
}
const { isAuthed = false } = Astro.props;
const accountHref = isAuthed ? "/member/dashboard" : "/member/login";
const accountLabel = isAuthed ? "My Account" : "Member Login";
---
<header class="nav" id="site-nav" data-server-authed={isAuthed ? "1" : "0"}>
  <div class="nav-backdrop" aria-hidden="true"></div>

  <div class="container nav-inner">
    <a href="/" class="wordmark" aria-label="Dudela — home">
      <span class="wordmark-disc" aria-hidden="true"></span>
      <img src="/logo/dudela-logo-white-full.png" alt="Dudela" class="wordmark-logo" />
    </a>

    <nav class="links">
      <!-- Dropped Resources and Community from here — Resources duplicated
           Prepare (the roadmap already routes to everything Resources
           lists, and Resources' own copy pointed back to Prepare as "the
           real starting point"), and Community had no content of its own
           beyond testimonials that now live directly on the Spit-Up
           Society page, right above its CTA. Both pages still exist for
           direct/old links, they just don't compete for a nav slot. -->
      <a href="/prepare">Prepare</a>
      <a href="/podcast">Podcast</a>
      <a href="/workshop">Workshop</a>
      <a href="/merch">Merch</a>
      <!-- The full pricing ladder (Guide → Kit → Workshop → Spit-Up
           Society → Cohort → Coaching) — added so it's still reachable
           now that the "Join" button below points straight at the
           membership instead of this overview. -->
      <a href="/join">Pricing</a>
      <a href="/about">About</a>
      <!-- The Turn had no site-wide entry point at all before this — only
           reachable via the Footer or by clicking deep into the Roadmap's
           "6 Months" stage. It's the highest-value offer on the site, so it
           gets its own nav slot like everything else, not just a mention
           buried in the pricing ladder. -->
      <a href="/turn" class="nav-turn-link">The Turn</a>
    </nav>

    <div class="nav-right">
      <!-- Always points here regardless of login state — /member/login
           itself redirects an already-authed member straight to
           /member/dashboard, so this one link works for both "I need to
           log in" and "take me to my account" without Nav.astro needing
           to know the visitor's session (it's rendered on prerendered
           static pages too, where per-request cookies aren't available). -->
      <a href={accountHref} class="member-link">{accountLabel}</a>
      <!-- Same link as above, but a plain person icon sitting right next
           to the hamburger on mobile so "I already have an account" is
           visible at a glance instead of buried inside the menu. The text
           link stays inside the mobile menu too — this doesn't replace it,
           just gives it a visible entry point on small screens. -->
      <a href={accountHref} class="mobile-member-icon" aria-label={accountLabel} set:html={ICONS.user} />
      <!-- Branded voicemail entry point — replaces the old SpeakPipe
           floating tab, which used to render on every page and, on mobile,
           could sit right on top of /merch's checkout bar. This is a plain
           nav button instead of another floating element: it's on the
           already-fixed header, so it can't ever overlap page content the
           way a separately-floating widget could. Links to /voicemail
           ("Ask Another Dad"), the one page that actually loads the real
           SpeakPipe recorder now (see BaseLayout's showVoicemailWidget
           prop). Icon-only + tooltip on desktop to match the compact
           member icon next to it; full label inside the mobile menu. -->
      <a href="/voicemail" class="voicemail-link" aria-label="Leave a voicemail" title="Leave a voicemail" set:html={ICONS.mic} />
      <!-- Points straight at the $5/mo Spit-Up Society signup, not the
           full pricing ladder — "Join" sitting next to "Member Login"
           reads as "become a member," and the Society is the membership
           this whole portal is built around. The ladder is still one
           click away via "Pricing" above. -->
      <a href="/join/spit-up-society" class="btn btn-primary join-btn">Join</a>
      <button type="button" class="hamburger" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <a href="/prepare">Prepare</a>
    <a href="/podcast">Podcast</a>
    <a href="/workshop">Workshop</a>
    <a href="/merch">Merch</a>
    <a href="/join">Pricing</a>
    <a href="/about">About</a>
    <a href="/turn" class="nav-turn-link">The Turn</a>
    <!-- Only one button belongs inside the open menu. Join already sits
         pinned in nav-right (z-index above this overlay), so it stays
         visible the whole time the menu is open — no need to duplicate it
         down here. Member Login is the one thing worth surfacing as its
         own button, with the same person icon used outside for continuity. -->
    <a href={accountHref} class="mobile-member-btn" set:html={`${ICONS.user} ${accountLabel}`} />
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 1.1rem 0;
    background: transparent;
    transition: background 0.3s var(--ease-out), padding 0.3s var(--ease-out), backdrop-filter 0.3s ease;
  }
  .nav.scrolled,
  .nav.menu-open {
    padding: 0.75rem 0;
  }
  /* The scrolled background/blur lives on a dedicated absolutely-positioned
     div (sized to inset:0 of the header) rather than on .nav itself, and
     rather than a pseudo-element with a hand-tuned negative inset. Putting
     backdrop-filter directly on .nav (or sizing a pseudo-element with a
     fixed negative inset that doesn't track the header's real content
     height) creates a problem: filter on .nav creates a new containing
     block for its `position: fixed` children — .mobile-menu is one of
     those — breaking the mobile menu's full-screen overlay the instant it
     opens. Sizing this backdrop to inset:0 of the header avoids that — it
     always matches the header's real box exactly. */
  .nav-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: background 0.3s var(--ease-out), backdrop-filter 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled .nav-backdrop,
  .nav.menu-open .nav-backdrop {
    background: rgba(42, 51, 34, 0.94);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(245, 239, 227, 0.08);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }
  /* The green disc is a plain CSS circle sitting behind the logo, not part
     of the logo art itself. That way the fist-bump + wordmark image never
     changes at all — same file, same size, same position — while scrolling
     only fades/shrinks the disc behind it away, so it reads as "the badge's
     circle melts into the nav bar" rather than a logo swap. */
  .wordmark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }
  .wordmark-disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #6d7d5b;
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .nav.scrolled .wordmark-disc {
    opacity: 0;
    transform: scale(0.8);
  }
  .wordmark-logo {
    position: relative;
    z-index: 1;
    height: 34px;
    width: auto;
    display: block;
  }
  .links {
    display: none;
    gap: 2rem;
    font-family: var(--font-label);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .links a {
    color: rgba(245, 239, 227, 0.85);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .links a:hover {
    opacity: 0.7;
  }
  /* Amber matches the "highlight" treatment used everywhere else on the site
     for The Turn (Footer's footer-highlight, the roadmap's paid-resource
     styling) — same visual language, so it reads as the standout offer here
     too instead of blending into the other plain nav links. */
  .links a.nav-turn-link,
  .mobile-menu a.nav-turn-link {
    color: var(--amber-500);
    font-weight: 700;
  }
  .links a.nav-turn-link:hover {
    opacity: 0.85;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .join-btn {
    padding: 0.6rem 1.3rem;
    font-size: 0.85rem;
  }
  .member-link {
    display: none;
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(245, 239, 227, 0.85);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .member-link:hover {
    opacity: 0.7;
  }
  .mobile-member-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--cream-100);
    flex-shrink: 0;
  }
  /* :global() is required here — this SVG is injected via set:html as a raw
     string, so Astro never stamps it with this component's scoped
     data-astro-cid attribute. A plain (scoped) `.mobile-member-icon svg`
     selector silently never matches that real element, which is why the
     icon rendered with no visible glyph (just its 32px box) — no width/
     height ever reached the actual <svg>, and inline SVG with only a
     viewBox and no sizing collapses to nothing in Safari. */
  .mobile-member-icon :global(svg) {
    width: 20px;
    height: 20px;
    display: block;
  }
  /* Hides once the menu is open — the same icon reappears on the Member
     Login button inside the open menu, so keeping this one visible too
     would just duplicate it right next to its own twin. */
  .nav.menu-open .mobile-member-icon {
    display: none;
  }
  /* Branded voicemail button — icon-only with a tooltip, same footprint as
     .mobile-member-icon next to it, but with its own amber ring so it
     reads as a distinct call-to-action rather than blending into the
     plain nav icons. Visible at every width (no breakpoint toggling the
     way member-link/mobile-member-icon swap for each other) since it
     doesn't have a text-label counterpart to hand off to on desktop. */
  .voicemail-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid var(--amber-500);
    color: var(--amber-500);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .voicemail-link:hover {
    background: var(--amber-500);
    color: var(--forest-900, #12180f);
  }
  .voicemail-link :global(svg) {
    width: 17px;
    height: 17px;
    display: block;
  }
  .mobile-member-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-label) !important;
    font-size: 1rem !important;
    font-weight: 600;
    color: var(--cream-100) !important;
    text-decoration: none;
    border: 1.5px solid rgba(245, 239, 227, 0.5);
    border-radius: 999px;
    padding: 0.75rem 1.85rem;
    margin-top: 1.25rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .mobile-member-btn:hover {
    border-color: var(--cream-100);
    background: rgba(245, 239, 227, 0.08);
  }
  .mobile-member-btn :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--cream-100);
    transition: transform 0.25s var(--ease-out), opacity 0.2s ease;
  }
  .nav.menu-open .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav.menu-open .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .nav.menu-open .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 0;
    /* Was z-index:5 — higher than .nav-inner's z-index:2, so the open
       overlay painted OVER the header row and hid the hamburger/X control
       that's supposed to close it. Sitting below nav-inner (but still
       above nav-backdrop's -1) keeps the logo + close control visible on
       top of the open menu. */
    z-index: 1;
    background: var(--forest-900);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Was justify-content:center with no overflow handling — fine when
       the menu was 7 links, but Member Login + Join brought it to 9
       stacked items, which runs past the fold on shorter phones with no
       way to reach the top items. flex-start + its own scroll fixes
       that; top padding clears the fixed header sitting above it. */
    justify-content: flex-start;
    padding: 6.5rem 1.5rem 3rem;
    gap: 1.15rem;
    overflow-y: auto;
    transform: translateY(-100%);
    transition: transform 0.35s var(--ease-out);
  }
  .nav.menu-open .mobile-menu {
    transform: translateY(0);
  }
  .mobile-menu a {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--cream-100);
    text-decoration: none;
  }
  @media (min-width: 860px) {
    .links {
      display: flex;
    }
    .member-link {
      display: inline-flex;
    }
    .mobile-member-icon {
      display: none;
    }
    .hamburger {
      display: none;
    }
    .mobile-menu {
      display: none;
    }
    /* When a visitor is actually logged in (confirmed either server-side on
       the /member/* pages, or client-side via the session check below on
       everywhere else), swap the "Member Login" text link for the same
       plain icon used on mobile — at desktop width too, not just small
       screens. Nested inside this same breakpoint so it only overrides the
       two rules right above it, rather than needing !important. */
    .nav.is-authed .member-link {
      display: none;
    }
    .nav.is-authed .mobile-member-icon {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const hamburger = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 60) nav.classList.add("scrolled");
    else nav.classList.remove("scrolled");
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  function closeMenu() {
    nav?.classList.remove("menu-open");
    hamburger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  function toggleMenu() {
    const isOpen = nav?.classList.toggle("menu-open");
    hamburger?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    document.body.style.overflow = isOpen ? "hidden" : "";
  }

  hamburger?.addEventListener("click", toggleMenu);
  mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Marketing pages (prerendered/static) render with isAuthed defaulted to
  // false — they have no per-request cookie access at build time (see the
  // comment on the isAuthed prop above), so they can't know a visitor is
  // actually logged in. This is the fix: a cheap client-side check against
  // the same session cookie, so "Member Login" turns into the logged-in
  // icon (and stops asking someone who's already signed in to log in again)
  // no matter which page they land on. Skipped entirely when the page
  // already resolved this server-side (/member/* pages pass isAuthed
  // directly) — no need to double-check what's already known.
  if (nav?.dataset.serverAuthed === "0") {
    fetch("/api/auth/session")
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data?.authed) return;
        nav.classList.add("is-authed");
        // Dashboard, not logout — clicking your own account icon should take
        // you into the member area, not silently sign you out.
        const dashboardHref = "/member/dashboard";
        document.querySelectorAll<HTMLAnchorElement>(".member-link, .mobile-member-icon").forEach((el) => {
          el.setAttribute("href", dashboardHref);
          el.setAttribute("aria-label", "My Account");
        });
        const memberLink = document.querySelector(".member-link");
        if (memberLink) memberLink.textContent = "My Account";
        const mobileBtn = document.querySelector<HTMLAnchorElement>(".mobile-member-btn");
        if (mobileBtn) {
          mobileBtn.setAttribute("href", dashboardHref);
          const label = mobileBtn.querySelector("svg")?.outerHTML || "";
          mobileBtn.innerHTML = `${label} My Account`;
        }
      })
      .catch(() => {
        // Session check failing (offline, cold Worker, etc.) just leaves the
        // page showing "Member Login" — the same safe default it already
        // rendered with, not a broken state.
      });
  }
</script>
