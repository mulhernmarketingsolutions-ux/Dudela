---
// Single Feather-style "user" glyph, same stroke pattern used for icons
// elsewhere on the site (Roadmap.astro, member/dashboard.astro) — just the
// one-person icon since this is specifically the "log in / my account"
// entry point, not the multi-person "Circle" icon used in the dashboard.
const ICONS = {
  user: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
};
---
<header class="nav" id="site-nav">
  <div class="nav-backdrop" aria-hidden="true"></div>
  <div class="announce-banner" id="announce-banner">
    <a href="/join/spit-up-society" class="announce-link">
      <span class="announce-text">
        <strong>The Spit-Up Society is open.</strong>
        <span class="announce-detail">First live Q&amp;A — Aug 4 @ 7pm.</span>
      </span>
      <span class="announce-cta">Join now &rarr;</span>
    </a>
    <button type="button" class="announce-close" id="announce-close" aria-label="Dismiss announcement">&times;</button>
  </div>

  <div class="container nav-inner">
    <a href="/" class="wordmark" aria-label="Dudela — home">
      <span class="wordmark-disc" aria-hidden="true"></span>
      <img src="/logo/dudela-logo-white-full.png" alt="Dudela" class="wordmark-logo" />
    </a>

    <nav class="links">
      <a href="/prepare">Prepare</a>
      <a href="/community">Community</a>
      <a href="/podcast">Podcast</a>
      <a href="/resources">Resources</a>
      <a href="/workshop">Workshop</a>
      <a href="/merch">Merch</a>
      <a href="/about">About</a>
    </nav>

    <div class="nav-right">
      <!-- Always points here regardless of login state — /member/login
           itself redirects an already-authed member straight to
           /member/dashboard, so this one link works for both "I need to
           log in" and "take me to my account" without Nav.astro needing
           to know the visitor's session (it's rendered on prerendered
           static pages too, where per-request cookies aren't available). -->
      <a href="/member/login" class="member-link">Member Login</a>
      <!-- Same link as above, but a plain person icon sitting right next
           to the hamburger on mobile so "I already have an account" is
           visible at a glance instead of buried inside the menu. The text
           link stays inside the mobile menu too — this doesn't replace it,
           just gives it a visible entry point on small screens. -->
      <a href="/member/login" class="mobile-member-icon" aria-label="Member Login" set:html={ICONS.user} />
      <a href="/join" class="btn btn-primary join-btn">Join</a>
      <button type="button" class="hamburger" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <a href="/prepare">Prepare</a>
    <a href="/community">Community</a>
    <a href="/podcast">Podcast</a>
    <a href="/resources">Resources</a>
    <a href="/workshop">Workshop</a>
    <a href="/merch">Merch</a>
    <a href="/about">About</a>
    <a href="/member/login" class="mobile-member-link">Member Login</a>
    <a href="/join" class="btn btn-primary mobile-join">Join</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 1.1rem 0;
    background: transparent;
    transition: background 0.3s var(--ease-out), padding 0.3s var(--ease-out), backdrop-filter 0.3s ease;
  }
  .nav.scrolled,
  .nav.menu-open {
    padding: 0.75rem 0;
  }
  /* The scrolled background/blur lives on a dedicated absolutely-positioned
     div (sized to inset:0 of the header) rather than on .nav itself, and
     rather than a pseudo-element with a hand-tuned negative inset. Putting
     backdrop-filter directly on .nav (or sizing a pseudo-element with a
     fixed negative inset that doesn't track the header's real content
     height) creates two problems: (1) filter on .nav creates a new
     containing block for its `position: fixed` children — .mobile-menu is
     one of those — breaking the mobile menu's full-screen overlay the
     instant it opens; (2) a fixed inset can bleed into the announce banner
     above it once scrolled padding shrinks, "scrunching" the banner. Sizing
     this backdrop to inset:0 of the header avoids both — it always matches
     the header's real box (banner + nav row) exactly. */
  .nav-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: background 0.3s var(--ease-out), backdrop-filter 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled .nav-backdrop,
  .nav.menu-open .nav-backdrop {
    background: rgba(42, 51, 34, 0.94);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(245, 239, 227, 0.08);
  }
  .announce-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--amber-500);
    padding: 0.5rem 2.25rem 0.5rem 1rem;
    position: relative;
    text-align: center;
  }
  .nav.announce-hidden .announce-banner {
    display: none;
  }
  .announce-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--forest-900);
    font-family: var(--font-label);
    font-size: 0.82rem;
    max-width: 100%;
    overflow: hidden;
  }
  .announce-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .announce-text strong {
    font-weight: 800;
  }
  .announce-detail {
    margin-left: 0.4rem;
  }
  .announce-cta {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  @media (max-width: 560px) {
    .announce-banner {
      padding: 0.45rem 2.1rem 0.45rem 0.75rem;
    }
    .announce-link {
      font-size: 0.72rem;
      gap: 0.4rem;
    }
    .announce-detail {
      display: none;
    }
    .announce-cta {
      font-size: 0.72rem;
    }
  }
  .announce-close {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--forest-900);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    padding: 0.25rem;
  }
  .announce-close:hover {
    opacity: 1;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }
  /* The green disc is a plain CSS circle sitting behind the logo, not part
     of the logo art itself. That way the fist-bump + wordmark image never
     changes at all — same file, same size, same position — while scrolling
     only fades/shrinks the disc behind it away, so it reads as "the badge's
     circle melts into the nav bar" rather than a logo swap. */
  .wordmark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }
  .wordmark-disc {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #6d7d5b;
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .nav.scrolled .wordmark-disc {
    opacity: 0;
    transform: scale(0.8);
  }
  .wordmark-logo {
    position: relative;
    z-index: 1;
    height: 34px;
    width: auto;
    display: block;
  }
  .links {
    display: none;
    gap: 2rem;
    font-family: var(--font-label);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .links a {
    color: rgba(245, 239, 227, 0.85);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .links a:hover {
    opacity: 0.7;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .join-btn {
    padding: 0.6rem 1.3rem;
    font-size: 0.85rem;
  }
  .member-link {
    display: none;
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(245, 239, 227, 0.85);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .member-link:hover {
    opacity: 0.7;
  }
  .mobile-member-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--cream-100);
    flex-shrink: 0;
  }
  .mobile-member-icon svg {
    width: 20px;
    height: 20px;
  }
  .mobile-member-link {
    font-family: var(--font-label) !important;
    font-size: 0.95rem !important;
    font-weight: 600;
    color: rgba(245, 239, 227, 0.7) !important;
    padding-top: 1rem;
    border-top: 1px solid rgba(245, 239, 227, 0.12);
    width: 70%;
    text-align: center;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }
  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--cream-100);
    transition: transform 0.25s var(--ease-out), opacity 0.2s ease;
  }
  .nav.menu-open .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav.menu-open .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .nav.menu-open .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 0;
    /* Was z-index:5 — higher than .nav-inner's z-index:2, so the open
       overlay painted OVER the header row and hid the hamburger/X control
       that's supposed to close it. Sitting below nav-inner (but still
       above nav-backdrop's -1) keeps the logo + close control visible on
       top of the open menu. */
    z-index: 1;
    background: var(--forest-900);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Was justify-content:center with no overflow handling — fine when
       the menu was 7 links, but Member Login + Join brought it to 9
       stacked items, which runs past the fold on shorter phones with no
       way to reach the top items. flex-start + its own scroll fixes
       that; top padding clears the fixed header sitting above it. */
    justify-content: flex-start;
    padding: 6.5rem 1.5rem 3rem;
    gap: 1.15rem;
    overflow-y: auto;
    transform: translateY(-100%);
    transition: transform 0.35s var(--ease-out);
  }
  .nav.menu-open .mobile-menu {
    transform: translateY(0);
  }
  .mobile-menu a {
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--cream-100);
    text-decoration: none;
  }
  .mobile-join {
    font-family: var(--font-label);
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 860px) {
    .links {
      display: flex;
    }
    .member-link {
      display: inline-flex;
    }
    .mobile-member-icon {
      display: none;
    }
    .hamburger {
      display: none;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const hamburger = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const announceClose = document.getElementById("announce-close");

  const ANNOUNCE_KEY = "dudela-announce-dismissed-spit-up-society-aug4";
  try {
    if (localStorage.getItem(ANNOUNCE_KEY)) {
      nav?.classList.add("announce-hidden");
    }
  } catch {}

  announceClose?.addEventListener("click", () => {
    nav?.classList.add("announce-hidden");
    try {
      localStorage.setItem(ANNOUNCE_KEY, "1");
    } catch {}
  });

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 60) nav.classList.add("scrolled");
    else nav.classList.remove("scrolled");
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  function closeMenu() {
    nav?.classList.remove("menu-open");
    hamburger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  function toggleMenu() {
    const isOpen = nav?.classList.toggle("menu-open");
    hamburger?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    document.body.style.overflow = isOpen ? "hidden" : "";
  }

  hamburger?.addEventListener("click", toggleMenu);
  mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
