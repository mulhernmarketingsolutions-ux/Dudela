---
// /babysense: landing page for traffic sent by BabySense as part of the
// cross-promo (Oct 2026). These visitors don't know Dudela yet, so the page
// leads with who we are, captures email on the free guide, then the podcast,
// then closes the loop with John's own BabySense monitor + affiliate link.
//
// VIDEO: John's intro, 720x1280 H.264 in /public/videos/. Set VIDEO_SRC to null
// to fall back to the founder photo.
import BaseLayout from "../layouts/BaseLayout.astro";
import { episodes, SPOTIFY_URL, APPLE_URL } from "../data/episodes.js";
import { GIVEAWAY, giveawayState, BABYSENSE_CODE } from "../data/babysenseGiveaway";

// Rendered on request (not at build) so the giveaway switches on and off
// by itself on the dates in data/babysenseGiveaway.ts.
export const prerender = false;
const state = giveawayState();
const open = state === "open";

const VIDEO_SRC: string | null = "/videos/babysense-intro.mp4";
const AFFILIATE_URL = "https://babymonitordirectllc.pxf.io/rEq1o3";

// Picked for BabySense's audience: the episode with BabySense's own CEO,
// the most-listened episode, and John's twins episode (ties to the
// monitor story).
const picks = [
  "Baby Tech & Fatherhood with Babysense CEO Elad Erdan",
  "What Should I Focus On Right Now? Pregame for Fatherhood Before Baby Arrives",
  "Surviving Twins: What the First Year Actually Looks Like",
];
// Episode-specific Apple link when we have one, otherwise the Podbean episode page.
const featured = picks
  .map(t => episodes.find(ep => ep.title === t))
  .filter(Boolean)
  .map(ep => ({ ...ep, href: ep.apple !== APPLE_URL ? ep.apple : ep.link }));
---
<BaseLayout title="Welcome from BabySense | Dudela" description="Two dads helping expecting and first-time dads get ready. Free guide, podcast, and the baby monitor we actually use.">
  <header><a href="/" aria-label="Dudela home"><img src="/logo/dudela-logo-white-full.png" alt="Dudela" width="128" /></a><span>Turn scared dudes into steady dads</span></header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        {open
          ? <a class="live" href="#guide"><span class="dot"></span>Live giveaway · Win a BabySense Pro</a>
          : <p class="eyebrow">Welcome, BabySense family</p>}
        <h1>Turn scared dudes into steady dads.</h1>
        <p class="sub">We're John and Mike, two Denver dads behind The Dudela Co. We help expecting and first-time dads get ready for the biggest job they'll ever have, with practical tools, a podcast, and zero fluff.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#guide">{open ? "Enter to win a BabySense Pro" : "Get the free guide"} <span aria-hidden="true">↓</span></a>
          <a class="btn btn-quiet" href="#podcast">Listen to the podcast</a>
        </div>
      </div>
      <div class="hero-media">
        {VIDEO_SRC ? (
          <div class="player" data-player>
            <video src={VIDEO_SRC} poster="/videos/babysense-intro-poster.jpg" playsinline preload="none" aria-label="Intro video from John"></video>
            <button class="play" type="button" aria-label="Play John's 47-second intro">
              <span class="ring"></span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
            </button>
            <div class="player-label"><strong>Meet John</strong><span>47 sec · sound on</span></div>
          </div>
        ) : <img src="/images/founder-john.jpg" alt="John Mulhern, co-founder of Dudela" />}
      </div>
    </section>

    <section class={`offer reveal${open ? " is-open" : ""}`} id="guide" aria-label={open ? "BabySense Pro giveaway" : "Free Dad Prep Guide"}>
      <div class="visual">
        {open ? (
          <div class="prize-wrap">
            <div class="prize-photo">
              <span class="sticker" aria-hidden="true">Win<br />it</span>
              <img src={GIVEAWAY.prizeImage} alt="BabySense Pro video baby monitor with camera and split-screen parent unit" />
            </div>
            <div class="countdown" data-end={GIVEAWAY.end.toISOString()} aria-label="Time left to enter">
              <div><b data-d>--</b><i>days</i></div>
              <div><b data-h>--</b><i>hrs</i></div>
              <div><b data-m>--</b><i>min</i></div>
              <div><b data-s>--</b><i>sec</i></div>
            </div>
            <p class="prize-note">Shipped free by BabySense · Winner drawn Oct 28</p>
          </div>
        ) : (
          <img class="cover" src="/images/free-guide-cover.png" alt="15 Things Every Dad Should Do Before the Baby Arrives cover" />
        )}
      </div>
      <div class="details">
        {open ? (
          <>
            <p class="eyebrow">Giveaway · Ends {GIVEAWAY.endLabel.replace(/, 2026$/, "")}</p>
            <h2 class="win-h"><em>Win</em> a BabySense Pro.</h2>
            <ol class="steps">
              <li><span>1</span><div>Enter your email below.</div></li>
              <li><span>2</span><div>Follow <a href={GIVEAWAY.instagram} target="_blank" rel="noopener">{GIVEAWAY.instagramHandle}</a> on Instagram.</div></li>
            </ol>
          </>
        ) : (
          <>
            <p class="eyebrow">Free Dad Prep Guide</p>
            <h2>15 Things Every Dad Should Do Before the Baby Arrives</h2>
            {state === "before" && <p class="notice">Heads up: our BabySense Pro giveaway opens {GIVEAWAY.startLabel.replace(/, 2026$/, "")}. Grab the guide now and come back then to enter.</p>}
            {state === "closed" && <p class="notice">The BabySense Pro giveaway has closed. Thanks to everyone who entered. The guide is still free.</p>}
            <ul>
              <li><span aria-hidden="true">✓</span>Practical steps for your head, home, and partnership</li>
              <li><span aria-hidden="true">✓</span>Conversation starters to use with your partner</li>
              <li><span aria-hidden="true">✓</span>A clear place to start before baby arrives</li>
            </ul>
          </>
        )}
        <form id="offer-form" data-download="/downloads/dudela-15-things.pdf" data-giveaway={open ? "1" : undefined}>
          <input type="hidden" name="magnet" value={open ? "babysense-giveaway" : "babysense-free-guide"} />
          <input type="hidden" name="source" value="/babysense" />
          <label for="email">{open ? "Your email" : "Where should we send it?"}</label>
          <input id="email" type="email" name="email" autocomplete="email" placeholder="Your email address" required />
          <button type="submit" class={`btn btn-primary${open ? " shine" : ""}`}>{open ? "Enter the giveaway" : "Send me the free guide"} <span aria-hidden="true">↗</span></button>
          {open && <p class="bonus"><strong>Bonus:</strong> our free Dad Prep Guide lands in your inbox the second you enter.</p>}
          <p class="fine">
            {open
              ? <>Entering joins the Dudela newsletter. Unsubscribe anytime. No purchase necessary. <a href="/babysense/rules">Official rules</a>.</>
              : "We'll send your free guide and Dudela emails. Unsubscribe anytime."}
          </p>
          <p id="status" role="status" aria-live="polite"></p>
        </form>
        <p class="forward"><strong>Mom here?</strong> {open ? "Enter, then forward the guide to him." : "Grab it and forward it to him."} Most dads won't ask for directions, but they'll read a list.</p>
      </div>
    </section>

    <section class="podcast reveal" id="podcast">
      <p class="eyebrow">The Dudela Podcast</p>
      <h2>Real talk from two dads who've been there.</h2>
      <div class="eps">
        {featured.map(ep => (
          <a class="ep" href={ep.href} target="_blank" rel="noopener">
            <img src={ep.img} alt="" loading="lazy" />
            <div><span class="ep-num">{ep.number ? `Episode ${ep.number}` : "Bonus"}</span><h3>{ep.title}</h3></div>
          </a>
        ))}
      </div>
      <div class="listen">
        <a class="btn btn-quiet" href={SPOTIFY_URL} target="_blank" rel="noopener">Spotify</a>
        <a class="btn btn-quiet" href={APPLE_URL} target="_blank" rel="noopener">Apple Podcasts</a>
        <a class="btn btn-quiet" href="/podcast">All episodes</a>
      </div>
    </section>

    <section class="monitor reveal">
      <img src="/images/babysense-touch-smart-wifi-baby-monitor-with-7-touchscreen-2-cam-5034224.webp" alt="BabySense video baby monitor with touchscreen display and app" loading="lazy" />
      <div>
        <p class="eyebrow">The monitor in our house</p>
        <h2>We bought ours before the twins came home.</h2>
        <p>When Viv and I found out we were having twins, a BabySense monitor was one of the first things we got. It's still the one we'd point another dad toward.</p>
        <p class="code">Use code <strong>{BABYSENSE_CODE}</strong> for 10% off.</p>
        <a class="btn btn-primary" href={AFFILIATE_URL} target="_blank" rel="sponsored noopener">See BabySense monitors <span aria-hidden="true">→</span></a>
        <p class="fine">We're a BabySense affiliate partner. This link may earn us a small commission at no extra cost to you.</p>
      </div>
    </section>
  </main>

  <footer><span>© {new Date().getFullYear()} The Dudela Co.</span><a href="/">thedudelaco.com</a><a href="/terms">Terms</a><a href="mailto:dude@thedudelaco.com">Need a hand?</a></footer>
</BaseLayout>

<script>
  // Video: custom poster + play button; native controls appear once playing.
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const video = player.querySelector("video")!;
    const play = () => {
      player.classList.add("playing");
      video.controls = true;
      video.play().catch(() => { player.classList.remove("playing"); video.controls = false; });
    };
    player.querySelector(".play")!.addEventListener("click", play);
    video.addEventListener("ended", () => {
      player.classList.remove("playing");
      video.controls = false;
      player.querySelector(".player-label span")!.textContent = "Watch again";
    });
  });

  // Countdown to the end of the giveaway entry window.
  const countdown = document.querySelector<HTMLElement>(".countdown");
  if (countdown) {
    const end = new Date(countdown.dataset.end!).getTime();
    const pad = (n: number) => String(n).padStart(2, "0");
    const set = (k: string, v: string) => (countdown.querySelector(`[data-${k}]`)!.textContent = v);
    const tick = () => {
      const left = Math.max(0, end - Date.now());
      set("d", String(Math.floor(left / 864e5)));
      set("h", pad(Math.floor(left / 36e5) % 24));
      set("m", pad(Math.floor(left / 6e4) % 60));
      set("s", pad(Math.floor(left / 1e3) % 60));
    };
    tick();
    setInterval(tick, 1000);
  }

  // Fade sections up as they scroll in. Only hides them once JS is running,
  // so the page still shows everything if scripts fail.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-reveal");
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  }

  const form = document.querySelector<HTMLFormElement>("#offer-form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const status = document.querySelector<HTMLElement>("#status")!;
    const body = new FormData(form);
    const query = new URLSearchParams(location.search);
    const attribution = new URLSearchParams();
    for (const key of ["utm_source", "utm_medium", "utm_campaign", "utm_content"]) {
      const value = query.get(key);
      if (value) attribution.set(key, value.slice(0, 100));
    }
    body.set("source", location.pathname + (attribution.size ? `?${attribution}` : ""));
    button.disabled = true;
    status.textContent = "Getting your download ready…";
    try {
      const response = await fetch("/api/lead-magnet", { method: "POST", body });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error("delivery");
      const entered = form.dataset.giveaway === "1";
      status.textContent = data.warnings?.includes("confirmation-email")
        ? "We couldn't send the email. Your download is ready below."
        : entered
          ? "You're entered. Last step: follow @the_dudela_official on Instagram. Your free guide is in your inbox, or download it here."
          : "You're all set. Check your inbox, or download it here.";
      const link = document.createElement("a");
      link.href = form.dataset.download!;
      link.textContent = "Get your free download";
      link.style.display = "block";
      status.append(link);
      button.textContent = entered ? "You\u2019re entered" : "Your download is ready";
      form.querySelector<HTMLInputElement>("#email")!.disabled = true;
    } catch {
      status.textContent = "We couldn't send that. Please try again.";
      button.disabled = false;
    }
  });
</script>

<style>
  :global(body){background:var(--cream-100);color:var(--forest-900)}
  header{background:var(--forest-800);color:var(--text-on-dark-muted);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px max(24px,calc((100vw - 1060px)/2))}
  header img{height:44px;width:auto}
  header span{font-size:11px;letter-spacing:.12em;text-transform:uppercase}
  main{max-width:1060px;margin:auto;padding:48px 24px 24px}
  .eyebrow{font-family:var(--font-label);font-size:11px;text-transform:uppercase;letter-spacing:.16em;font-weight:700;color:var(--text-on-light-muted);margin:0}
  h1{font-family:var(--font-display);font-weight:400;font-size:clamp(42px,6vw,68px);line-height:1.03;margin:16px 0}
  h2{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,3.6vw,38px);line-height:1.1;margin:12px 0 16px}
  .sub{color:var(--text-on-light-muted);font-size:17px;line-height:1.7;max-width:52ch}
  .btn-quiet{border:1px solid var(--forest-500);color:var(--forest-900);background:transparent}
  .btn-quiet:hover{background:var(--cream-200)}

  .hero{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;align-items:center;margin-bottom:64px}
  .hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .hero-media{justify-self:center;width:100%;max-width:340px;aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:var(--forest-800);box-shadow:10px 14px 0 var(--cream-300)}
  .hero-media>img{width:100%;height:100%;object-fit:cover;display:block}
  .player{position:relative;width:100%;height:100%;cursor:pointer}
  .player video{width:100%;height:100%;object-fit:cover;display:block;background:var(--forest-800)}
  .player::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(18,24,15,.78) 0%,rgba(18,24,15,0) 42%);pointer-events:none;transition:opacity .3s}
  .play{position:absolute;left:50%;top:50%;width:84px;height:84px;margin:-42px 0 0 -42px;border-radius:50%;border:0;background:var(--amber-500);color:var(--black);display:grid;place-items:center;cursor:pointer;z-index:2;box-shadow:0 12px 30px rgba(0,0,0,.35);transition:transform .35s var(--ease-out),background .2s}
  .play svg{width:34px;height:34px;fill:currentColor;margin-left:5px}
  .play .ring{position:absolute;inset:0;border-radius:50%;border:2px solid var(--amber-500);animation:ring 2.2s var(--ease-out) infinite}
  .player:hover .play{transform:scale(1.08);background:var(--amber-600)}
  .player-label{position:absolute;left:20px;right:20px;bottom:18px;z-index:2;color:var(--cream-100);display:flex;flex-direction:column;gap:2px;pointer-events:none;transition:opacity .3s}
  .player-label strong{font-family:var(--font-display);font-weight:400;font-size:28px;line-height:1}
  .player-label span{font-family:var(--font-label);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-on-dark-muted)}
  .player.playing .play,.player.playing .player-label,.player.playing::after{opacity:0;pointer-events:none}
  .player.playing{cursor:default}
  @keyframes ring{0%{transform:scale(1);opacity:.9}100%{transform:scale(1.6);opacity:0}}

  .live{display:inline-flex;align-items:center;gap:10px;background:var(--forest-800);color:var(--cream-100);font-family:var(--font-label);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:9px 16px 9px 12px;border-radius:999px;text-decoration:none;transition:transform .25s var(--ease-out)}
  .live:hover{transform:translateY(-1px)}
  .dot{width:9px;height:9px;border-radius:50%;background:var(--amber-500);box-shadow:0 0 0 0 rgba(226,125,37,.7);animation:pulse 1.8s infinite}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(226,125,37,.7)}70%{box-shadow:0 0 0 10px rgba(226,125,37,0)}100%{box-shadow:0 0 0 0 rgba(226,125,37,0)}}

  .win-h{font-size:clamp(34px,4.4vw,48px)!important}
  .win-h em{font-style:italic;color:var(--amber-600)}
  .prize-wrap{width:100%;max-width:340px}
  .prize-photo{position:relative;background:#fff;border-radius:12px;padding:22px;box-shadow:10px 14px 0 #b4bcaa;transition:transform .5s var(--ease-out)}
  .offer:hover .prize-photo{transform:translateY(-4px) rotate(-.6deg)}
  .prize-photo img{width:100%;aspect-ratio:1;object-fit:contain;display:block}
  .sticker{position:absolute;top:-18px;right:-14px;z-index:2;width:78px;height:78px;border-radius:50%;background:var(--amber-500);color:var(--black);display:grid;place-items:center;text-align:center;font-family:var(--font-display);font-style:italic;font-size:24px;line-height:.9;transform:rotate(12deg);box-shadow:0 8px 18px rgba(28,35,25,.25);animation:wobble 3.2s ease-in-out infinite}
  @keyframes wobble{0%,100%{transform:rotate(12deg) scale(1)}50%{transform:rotate(4deg) scale(1.07)}}
  .prize-note{font-size:12px;color:#4a5540;text-align:center;margin:12px 0 0}
  .countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:22px 0 0}
  .countdown div{background:var(--forest-800);border-radius:6px;padding:8px 4px;text-align:center}
  .countdown b{display:block;font-family:var(--font-label);font-size:22px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--cream-100)}
  .countdown i{font-style:normal;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-on-dark-muted)}
  .shine{position:relative;overflow:hidden}
  .shine::after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:40%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg);animation:shine 3.6s ease-in-out infinite}
  @keyframes shine{0%,60%{left:-60%}100%{left:130%}}

  :global(.js-reveal) .reveal{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease-out),transform .8s var(--ease-out)}
  :global(.js-reveal) .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion: reduce){
    .play .ring,.dot,.shine::after,.sticker{animation:none}
  }

  .offer{display:grid;grid-template-columns:1fr 1.2fr;border:1px solid var(--cream-300);border-radius:12px;overflow:hidden;background:#fffaf1;margin-bottom:72px;scroll-margin-top:24px}
  .visual{background:#dce0d2;display:flex;align-items:center;justify-content:center;padding:36px}
  .cover{max-height:360px;max-width:100%;object-fit:contain;box-shadow:8px 12px 20px #1c231922;transform:rotate(-3deg)}
  .details{padding:36px}
  ul{list-style:none;padding:0;margin:18px 0 24px}
  li{display:flex;gap:12px;font-size:14px;margin:10px 0}
  li span{color:var(--forest-500)}
  label{font-size:13px;display:block;margin-bottom:8px}
  input[type=email]{width:100%;background:#fff;border:1px solid #b9b5a7;border-radius:4px;padding:14px;font:inherit;font-size:16px;margin-bottom:12px}
  form .btn{display:flex;width:100%;justify-content:space-between;padding:16px 20px}
  button:disabled{opacity:.6;cursor:default}
  .fine{font-size:11px;color:var(--text-on-light-muted);line-height:1.6;margin:12px 0 0}
  #status{font-size:13px}
  .steps{list-style:none;padding:0;margin:18px 0 24px}
  .steps li{display:flex;gap:12px;align-items:baseline;font-size:15px;line-height:1.5;margin:12px 0}
  .steps li span{flex:none;width:24px;height:24px;border-radius:50%;background:var(--forest-800);color:var(--cream-100);font-size:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center}
  .steps a,.fine a{color:var(--rust-600);overflow-wrap:anywhere}
  .offer>*,.monitor>*,.hero>*{min-width:0}
  .notice{font-size:14px;line-height:1.6;background:var(--cream-200);border-radius:6px;padding:12px 14px;margin:0 0 8px}
  .bonus{font-size:14px;line-height:1.5;margin:14px 0 0}
  .visual{flex-direction:column}
  .code{color:var(--cream-100)!important;margin:-8px 0 18px!important}
  .code strong{color:var(--amber-500);letter-spacing:.04em}
  .forward{font-size:14px;line-height:1.6;margin:22px 0 0;padding-top:18px;border-top:1px solid var(--cream-300)}

  .podcast{margin-bottom:72px;scroll-margin-top:24px}
  .eps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:24px 0}
  .ep{display:flex;flex-direction:column;background:#fffaf1;border:1px solid var(--cream-300);border-radius:10px;overflow:hidden;text-decoration:none;color:inherit;transition:transform .2s var(--ease-out)}
  .ep:hover{transform:translateY(-2px)}
  .ep img{width:100%;aspect-ratio:1;object-fit:cover}
  .ep div{padding:16px}
  .ep-num{font-family:var(--font-label);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-on-light-muted)}
  .ep h3{font-size:16px;line-height:1.35;font-weight:600;margin:6px 0 0}
  .listen{display:flex;gap:10px;flex-wrap:wrap}

  .monitor{display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:center;background:var(--forest-800);color:var(--text-on-dark);border-radius:12px;padding:40px;margin-bottom:48px}
  .monitor img{width:100%;border-radius:8px;background:#fff}
  .monitor .eyebrow,.monitor .fine{color:var(--text-on-dark-muted)}
  .monitor p:not(.eyebrow):not(.fine){color:var(--text-on-dark-muted);line-height:1.7;margin:0 0 24px}

  footer{max-width:1060px;margin:auto;padding:24px;border-top:1px solid var(--cream-300);display:flex;gap:24px;flex-wrap:wrap;font-size:11px;color:var(--text-on-light-muted)}
  footer span{margin-right:auto}
  footer a{color:inherit}

  @media(max-width:760px){
    main{padding-top:32px}
    header span{display:none}
    .hero{grid-template-columns:1fr;gap:32px;margin-bottom:48px}
    .hero-media{max-width:280px}
    .offer,.monitor{grid-template-columns:1fr}
    .visual{padding:28px;order:2}
    .cover{max-height:240px}
    .prize-wrap{max-width:260px}
    .offer.is-open .visual{order:0;padding:30px 28px 22px}
