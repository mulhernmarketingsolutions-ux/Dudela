---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

// The Steady Dad Cohort never actually launched — no confirmed date, no
// signups (checked the Loops audience 2026-09-17: zero contacts tagged
// "Lead – Steady Dad Cohort"), so there's nothing to preserve by keeping
// the old waitlist page live. Retiring it from active promotion rather
// than deleting the route, since it may still be linked from old posts —
// visitors land somewhere honest instead of a 404 or a stale October 2026
// promise. Repurposed toward the two offers that actually run today: the
// live Workshop and 1:1 coaching with The Turn.
---
<BaseLayout
  title="Steady Dad Cohort — Dudela"
  description="The group cohort isn't running right now. Here's what's actually available today: the live Workshop and 1:1 coaching with The Turn."
>
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Steady Dad Cohort</p>
      <h1>The group cohort isn't running right now.</h1>
      <p class="hero-sub">
        We floated a live group program — dads going through the framework together — but it
        never actually launched, and we don't have a date to give you. Rather than leave you on a
        waitlist for something that isn't happening, here's what's real today.
      </p>

      <div class="resources-row">
        <a href="/workshop" class="btn btn-primary">Live Workshop, $100 &rarr;</a>
        <a href="/turn" class="btn btn-ghost">1:1 with The Turn &rarr;</a>
      </div>
      <p class="turn-note">
        Want something free first? <a href="/guide">Get the Dad Prep Guide</a> or
        <a href="/kit">the Prep Kit</a>.
      </p>
    </div>
  </section>

  <section class="details section-light">
    <div class="container details-grid">
      <div><h3>Live Workshop</h3><p>A 90-minute live session with John and Mike. Real questions, real answers, no script.</p></div>
      <div><h3>The Turn</h3><p>1:1 coaching if you want direct, personal access instead of a group setting.</p></div>
      <div><h3>If the cohort comes back</h3><p>We'll announce it through the newsletter and podcast first — no waitlist to manage in the meantime.</p></div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 4rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1.25rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
  }
  .resources-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .resources-row .btn-ghost {
    color: var(--cream-100);
  }
  .turn-note {
    margin-top: 1.25rem;
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
  }
  .turn-note a {
    color: var(--amber-500);
    font-weight: 700;
  }
  .details {
    padding: var(--space-6) 0;
  }
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .details-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }
  .details-grid p {
    color: var(--text-on-light-muted);
    margin: 0;
    font-size: 0.92rem;
  }
</style>
