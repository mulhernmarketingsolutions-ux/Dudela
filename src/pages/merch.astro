---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { countMerchOrders } from "../lib/db";
import { getAuthedMember } from "../lib/auth";

const env = (Astro.locals as any).runtime.env;

// Nudge (not a requirement) for Spit-Up Society members to log in before
// buying — that's what makes create-checkout-session.ts attach the purchase
// to their existing Stripe customer so it shows up in their billing portal.
// Checkout stays open to everyone logged out or not; requiring login would
// lock out anyone who isn't already a paying member, which is the opposite
// of what a merch drop is for.
const member = await getAuthedMember(Astro.cookies, env);

// Source of truth for what's buyable lives in lib/printful.ts (HAT_CATALOG) — this
// mirrors it, grouped by design so the page can show one card per design with a
// color picker inside it, instead of one flat card per color (easier to compare,
// and matches how John actually thinks about these: 2 designs, pick your color).
//
// Per John: The Classic (the arched, flipped wordmark) is the original design —
// Fist Bump is the newer one. The original cream/green-bill Classic mockup
// had its wordmark stitched in green thread, which clashed against the green
// bill — John fixed it by re-stitching in rust orange (same accent used on
// White/Cream-Black-bill) and re-shot it front + a 3/4 angle side view. It's
// the hero color for The Classic now (shown by default) — Fist Bump doesn't
// have an equivalent green colorway back yet, so it stays at 3 colors.
//
// missingLabel: each design has its own real-photo gap right now (see comment
// on each color below for exactly what's missing) — shown as an honest
// "coming soon" placeholder instead of a mismatched or low-quality photo.
const DESIGNS = [
  {
    key: "upsidedown",
    title: "The Classic",
    tagline: "The one that started it all — DUDELA, flipped and arched, reading right back at you.",
    missingLabel: "Side view coming soon",
    colors: [
      {
        slug: "hat-upsidedown-cream",
        name: "Cream, Green Bill",
        swatch: "#3a4a32",
        description: "The hero color. Cream crown, dark green bill, wordmark stitched in rust orange.",
        images: ["/images/hat-upsidedown-cream-front.png", "/images/hat-upsidedown-cream-side.png"],
      },
      {
        slug: "hat-upsidedown-blackbill",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "Where it began. The wordmark flipped and arched, stitched in black.",
        images: ["/images/hat-upsidedown-blackbill-front.png"],
      },
      {
        slug: "hat-upsidedown-black",
        name: "Black",
        swatch: "#141414",
        description: "Blacked out, wordmark stitched in white.",
        images: ["/images/hat-upsidedown-black-front.png"],
      },
      {
        // No usable photo yet — the only render on file is a lifestyle/model
        // shot, not a flat product photo like every other color here, so it's
        // left off rather than shown inconsistent. Swap in a flat front shot
        // and this fills in automatically.
        slug: "hat-upsidedown-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean and simple, wordmark stitched in rust orange.",
        images: [],
      },
    ],
  },
  {
    key: "fistbump",
    title: "The Rookie",
    tagline: "The new one — a fist bump up front, DUDELA stitched across the back.",
    missingLabel: "Detail shot coming soon",
    // Per John: switching swatches shouldn't feel like a whole new photoshoot
    // each time — "I just want to see the colors change." That means every
    // color needs the SAME pose in the same slot. The close-up "product
    // details" shot on Black (front + a tight embroidery close-up on the
    // back) is the reference pose now — Cream and White are left at front-
    // only until they have a matching close-up, rather than mixing that in
    // with the old wide flat-back photos.
    colors: [
      {
        slug: "hat-fistbump-cream",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "The new go-to. Fist bump up front, DUDELA on the back, stitched in black.",
        images: ["/images/hat-fistbump-cream-front.png"],
      },
      {
        slug: "hat-fistbump-black",
        name: "Black",
        swatch: "#141414",
        description: "Blacked out, stitched in white so it still throws a punch.",
        images: ["/images/hat-fistbump-black-front.png", "/images/hat-fistbump-black-detail.png"],
      },
      {
        slug: "hat-fistbump-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean and simple, fist bump stitched in rust orange.",
        images: ["/images/hat-fistbump-white-front.png"],
      },
    ],
  },
];

// Printful makes these to order, so there's no real stock cap anymore — countMerchOrders
// is kept purely as an internal sales count (still useful to glance at), not a gate.
const designs = await Promise.all(
  DESIGNS.map(async (d) => ({
    ...d,
    colors: await Promise.all(
      d.colors.map(async (c) => ({ ...c, sold: await countMerchOrders(env, c.slug) }))
    ),
  }))
);

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Hats — Merch" description="Two designs, $38, free shipping. Made to order and shipped straight to your door.">
  <Nav isAuthed={!!member} />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>The Dudela hat.</h1>
      <p class="hero-sub">
        Two designs, several colors each, $38, free shipping. Every hat is made to order and
        shipped straight to your door — no waiting on a batch.
      </p>

      {!member && (
        <p class="login-nudge">
          Already a Spit-Up Society member? <a href="/member/login">Log in first</a> so this
          purchase shows up in your billing portal too.
        </p>
      )}

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick a color below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {designs.map((d) => {
        const first = d.colors[0];
        const [imgA, imgB] = first.images;
        return (
          <div class="design-card" data-design={d.key} data-missing-label={d.missingLabel}>
            <div class="design-media" data-media>
              {/* Always a fixed 2-up grid when there's at least a first photo — a
                  placeholder tile fills the second slot instead of collapsing to one
                  image, so card height never jumps as someone clicks between colors.
                  If there's no real photo at all yet for this color, one full-width
                  placeholder takes the whole media area instead of a lopsided pair. */}
              {imgA ? (
                <div class="photo-pair">
                  <img src={imgA} alt={`Dudela Hat — ${d.title}, ${first.name}`} loading="lazy" />
                  {imgB ? (
                    <img src={imgB} alt={`Dudela Hat — ${d.title}, ${first.name}`} loading="lazy" />
                  ) : (
                    <div class="photo-placeholder" style="aspect-ratio: 1/1;">
                      <span>{d.missingLabel}</span>
                    </div>
                  )}
                </div>
              ) : (
                <div class="photo-placeholder photo-placeholder-full">
                  <span>Photos coming soon</span>
                </div>
              )}
            </div>
            <div class="design-body">
              <h3>{d.title}</h3>
              <p class="design-tagline">{d.tagline}</p>
              <p class="color-desc" data-desc>{first.description}</p>

              <div class="swatches" role="group" aria-label={`${d.title} color`}>
                {d.colors.map((c, i) => (
                  <button
                    type="button"
                    class={`swatch${i === 0 ? " active" : ""}`}
                    style={`--swatch: ${c.swatch}`}
                    title={c.name}
                    aria-label={c.name}
                    data-slug={c.slug}
                    data-name={c.name}
                    data-desc={c.description}
                    data-images={JSON.stringify(c.images)}
                  />
                ))}
              </div>

              <div class="color-meta">
                <span class="price">$38</span>
                <span class="color-name" data-colorname>{first.name}</span>
              </div>
              <a href={`/api/create-checkout-session?product=${first.slug}`} class="btn btn-primary" data-buy>
                Buy Now — $38
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every hat is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS color-swatch picker — no framework, matches the rest of the site.
  // Each design card renders its first color server-side; clicking a swatch swaps
  // the image(s), description, color name, and buy-now link to that color's data,
  // which is embedded on each swatch button as data-* attributes at build time.
  document.querySelectorAll<HTMLElement>(".design-card").forEach((card) => {
    const media = card.querySelector<HTMLElement>("[data-media]");
    const desc = card.querySelector<HTMLElement>("[data-desc]");
    const colorName = card.querySelector<HTMLElement>("[data-colorname]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    const swatches = card.querySelectorAll<HTMLButtonElement>(".swatch");
    const missingLabel = card.dataset.missingLabel || "Photo coming soon";
    if (!media || !desc || !colorName || !buyBtn) return;

    function renderMedia(images: string[], name: string) {
      if (!media) return;
      // Matches the server-rendered markup: a fixed 2-up grid when there's at
      // least a first photo (placeholder fills an empty second slot), or one
      // full-width placeholder when there's no real photo for this color yet.
      const img0 = images[0];
      const img1 = images[1];
      if (!img0) {
        media.innerHTML = `<div class="photo-placeholder photo-placeholder-full"><span>Photos coming soon</span></div>`;
        return;
      }
      const second = img1
        ? `<img src="${img1}" alt="Dudela Hat — ${name}" loading="lazy" />`
        : `<div class="photo-placeholder" style="aspect-ratio: 1/1;"><span>${missingLabel}</span></div>`;
      media.innerHTML = `<div class="photo-pair"><img src="${img0}" alt="Dudela Hat — ${name}" loading="lazy" />${second}</div>`;
    }

    swatches.forEach((btn) => {
      btn.addEventListener("click", () => {
        swatches.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        renderMedia(JSON.parse(btn.dataset.images || "[]"), btn.dataset.name || "");
        desc.textContent = btn.dataset.desc || "";
        colorName.textContent = btn.dataset.name || "";
        buyBtn.href = `/api/create-checkout-session?product=${btn.dataset.slug}`;
      });
    });
  });
</script>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .login-nudge {
    margin-top: 1.25rem;
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    max-width: 52ch;
  }
  .login-nudge a {
    color: var(--amber-500);
    font-weight: 600;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .design-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .design-media {
    width: 100%;
  }
  .design-tagline {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.1rem;
  }
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--swatch);
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
  .color-name {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-on-light-muted);
  }
  :global(.photo-placeholder) {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04) 0px,
        rgba(255, 255, 255, 0.04) 2px,
        transparent 2px,
        transparent 14px
      ),
      linear-gradient(155deg, #2a3322 0%, #1c2319 55%, #12180f 100%);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  :global(.photo-placeholder span) {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 239, 227, 0.55);
    border: 1px dashed rgba(245, 239, 227, 0.25);
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  /* :global() on .photo-pair and its img — the swatch-click script rebuilds
     this markup client-side via innerHTML (see the <script> below), and
     Astro's scoped-style hashing only touches elements present in the
     compiled template at build time. A plain (non-global) rule here would
     style the server-rendered default color's pair correctly but silently
     stop applying the instant someone clicked a different color, since that
     new .photo-pair div never gets the scoped data-astro-cid attribute. That
     was the "clicking a color goes to one big broken image" bug — the grid
     and aspect-ratio just weren't being applied to the swapped-in markup. */
  :global(.photo-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  /* Used when a color has no real photo at all yet (rather than just a
     missing second angle) — one full-width placeholder instead of a lopsided
     pair, so the card doesn't look like something's broken. */
  :global(.photo-placeholder-full) {
    aspect-ratio: 2 / 1;
    align-items: center;
    justify-content: center;
  }
  :global(.photo-pair img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--cream-100);
  }
  /* Was .color-body — leftover from before the swatch-picker rewrite, and no
     longer matched the actual markup (which uses .design-body), so this
     entire padding/spacing block was silently not applying at all. That's
     why the card content looked jammed against the edges. */
  .design-body {
    padding: 2rem 2.1rem 2.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .design-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-desc {
    color: var(--text-on-light-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .stock {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust-600);
  }
  .stock-out {
    color: var(--text-on-light-muted);
  }
  .design-body .btn {
    width: 100%;
    text-align: center;
    /* Pins the buy button to the bottom of the card regardless of how long
       the description runs — .design-card cards in the same grid row stretch
       to equal height, and without this the shorter card's button floated
       right under its text with a big dead gap below it. */
    margin-top: auto;
  }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid var(--border-light);
    color: var(--text-on-light-muted);
    cursor: not-allowed;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
