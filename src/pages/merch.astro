---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getAuthedMember } from "../lib/auth";
import { HAT_CATALOG, type HatVariant, type Design } from "../lib/printful";

const env = (Astro.locals as any).runtime.env;

// Nudge (not a requirement) for Spit-Up Society members to log in before
// buying — that's what makes create-checkout-session.ts attach the purchase
// to their existing Stripe customer so it shows up in their billing portal.
// Checkout stays open to everyone logged out or not; requiring login would
// lock out anyone who isn't already a paying member, which is the opposite
// of what a merch drop is for.
const member = await getAuthedMember(Astro.cookies, env);

// REWRITTEN 2026-08-13: the old version of this page had one static color
// picker per design, backed by pre-merged "pair" images built by hand at
// image-prep time. That worked for 12 fixed colorways — it doesn't for the
// real current catalog, where cap color and thread color are independently
// selectable (e.g. a Black cap exists under both the White-thread and
// Orange-thread product groups) and there's now a "Dude² Dad" side-embroidery
// add-on toggle on top of that. HAT_CATALOG in lib/printful.ts is the single
// source of truth for every real, buyable combination — this page groups it
// by design and hands the client JS below a small catalog of real variants
// (thread color, cap color, add-on state, real Printful mockup photos, and
// the checkout key) to pick from, instead of a fixed list of colors.
//
// Every color/thread combo is backed by two real Printful mockup photos —
// straight-on front + a 3/4 angle showing the left side — shown side by side
// (same "two real photos together" strategy as the old pre-merged pairs,
// just as two separate <img>s instead of one baked-together PNG, since these
// are generated per-thread-color rather than hand-merged upfront).
const DESIGN_INFO: Record<Design, { title: string; tagline: string }> = {
  classic: {
    title: "The Classic",
    tagline: "The one that started it all — DUDELA, flipped and arched, reading right back at you.",
  },
  rookie: {
    title: "The Rookie",
    tagline: "The new one — DUDELA stitched across the front, ready to grow with the job.",
  },
};

const THREAD_ORDER = ["white", "orange", "black"] as const;

function colorSlug(v: HatVariant): string {
  const prefix = `${v.design}-${v.thread}-${v.addon ? "withaddon" : "noaddon"}-`;
  return v.key.startsWith(prefix) ? v.key.slice(prefix.length) : v.key;
}

const designs = (Object.keys(DESIGN_INFO) as Design[]).map((dkey) => {
  const variants = HAT_CATALOG.filter((v) => v.design === dkey);

  const threads = THREAD_ORDER.filter((t) => variants.some((v) => v.thread === t)).map((t) => {
    const sample = variants.find((v) => v.thread === t)!;
    return { key: t, label: sample.threadLabel, hex: sample.threadHex };
  });

  const clientVariants = variants.map((v) => ({
    key: v.key,
    thread: v.thread,
    color: colorSlug(v),
    colorLabel: v.colorLabel,
    colorHex: v.colorHex,
    colorHex2: v.colorHex2 || v.colorHex,
    addon: v.addon,
    front: v.frontImage,
    left: v.leftImage,
  }));

  const first = clientVariants.find((v) => v.thread === threads[0].key && !v.addon)!;

  return {
    key: dkey,
    title: DESIGN_INFO[dkey].title,
    tagline: DESIGN_INFO[dkey].tagline,
    threads,
    variants: clientVariants,
    first,
  };
});

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Hats — Merch" description="Two designs, three thread colors, an optional side add-on — $38, free shipping. Made to order and shipped straight to your door.">
  <Nav isAuthed={!!member} />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>The Dudela hat.</h1>
      <p class="hero-sub">
        Two designs, three thread colors, a cap color to match, and an optional "Dude² Dad" side
        add-on — $38, free shipping. Every hat is made to order and shipped straight to your door.
      </p>

      {!member && (
        <p class="login-nudge">
          Already a Spit-Up Society member? <a href="/member/login">Log in first</a> so this
          purchase shows up in your billing portal too.
        </p>
      )}

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick your hat below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {designs.map((d) => (
        <div class="design-card" data-design={d.key}>
          <div class="design-media">
            <div class="mockup-pair">
              <img class="mockup-photo" data-photo-front src={d.first.front} alt={`Dudela Hat — ${d.title}, front`} />
              <img class="mockup-photo" data-photo-left src={d.first.left} alt={`Dudela Hat — ${d.title}, angled left`} />
            </div>
          </div>
          <div class="design-body">
            <h3>{d.title}</h3>
            <p class="design-tagline">{d.tagline}</p>

            <div class="selector">
              <span class="selector-label">Thread color</span>
              <div class="thread-swatches" role="group" aria-label={`${d.title} thread color`} data-thread-swatches>
                {d.threads.map((t, i) => (
                  <button
                    type="button"
                    class={`thread-swatch${i === 0 ? " active" : ""}`}
                    style={`--swatch: ${t.hex}`}
                    title={t.label}
                    aria-label={t.label}
                    data-thread={t.key}
                  />
                ))}
              </div>
            </div>

            <div class="selector">
              <span class="selector-label">Cap color</span>
              <div class="color-swatches" role="group" aria-label={`${d.title} cap color`} data-color-swatches></div>
            </div>

            <label class="addon-toggle">
              <input type="checkbox" data-addon-toggle />
              <span>Add "Dude² Dad" side embroidery</span>
            </label>

            <div class="color-meta">
              <span class="price">$38</span>
              <span class="variant-name" data-variant-name>{d.first.colorLabel}</span>
            </div>
            <a href={`/api/create-checkout-session?product=${d.first.key}`} class="btn btn-primary" data-buy>
              Buy Now — $38
            </a>
          </div>

          <script type="application/json" data-catalog set:html={JSON.stringify(d)} />
        </div>
      ))}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every hat is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS, no framework — matches the rest of the site. Each design card
  // gets its own small catalog (embedded as JSON at build time, see
  // `data-catalog` above) of every real (thread, cap color, add-on) variant
  // Printful actually has built, plus that variant's two real mockup photos
  // and its checkout key. Three controls read/write one piece of state per
  // card — thread, color, add-on — and any change re-resolves to the exact
  // matching variant and updates the photos, label, and buy link.
  //
  // Thread and cap color are NOT a full cross product (e.g. no cap ships in
  // Black cap + Black thread — the stitching wouldn't show up), so the cap
  // color swatches are rebuilt from only the colors that actually exist for
  // the currently selected thread every time the thread changes. The add-on
  // toggle doesn't affect which colors are available — every (thread, color)
  // pair exists in both add-on states — so it's a simple independent switch.
  interface CardVariant {
    key: string;
    thread: string;
    color: string;
    colorLabel: string;
    colorHex: string;
    colorHex2: string;
    addon: boolean;
    front: string;
    left: string;
  }
  interface CardCatalog {
    title: string;
    threads: Array<{ key: string; label: string; hex: string }>;
    variants: CardVariant[];
  }

  document.querySelectorAll<HTMLElement>(".design-card").forEach((card) => {
    const catalogScript = card.querySelector<HTMLScriptElement>("[data-catalog]");
    if (!catalogScript?.textContent) return;
    const catalog: CardCatalog = JSON.parse(catalogScript.textContent);

    const photoFront = card.querySelector<HTMLImageElement>("[data-photo-front]");
    const photoLeft = card.querySelector<HTMLImageElement>("[data-photo-left]");
    const threadButtons = card.querySelectorAll<HTMLButtonElement>("[data-thread]");
    const colorContainer = card.querySelector<HTMLElement>("[data-color-swatches]");
    const addonToggle = card.querySelector<HTMLInputElement>("[data-addon-toggle]");
    const variantName = card.querySelector<HTMLElement>("[data-variant-name]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    if (!photoFront || !photoLeft || !colorContainer || !addonToggle || !variantName || !buyBtn) return;

    // Preload every real mockup photo for this card up front so swapping
    // thread/color/add-on never shows a half-loaded image or a network
    // delay — same instant-swap feel as the old single-image pair picker.
    catalog.variants.forEach((v) => {
      new Image().src = v.front;
      new Image().src = v.left;
    });

    const state = { thread: catalog.threads[0]?.key || "", color: "", addon: false };

    function variantsForThread(thread: string) {
      return catalog.variants.filter((v) => v.thread === thread);
    }

    function renderColorSwatches() {
      if (!colorContainer) return;
      colorContainer.innerHTML = "";
      const seen = new Set<string>();
      for (const v of variantsForThread(state.thread)) {
        if (seen.has(v.color)) continue;
        seen.add(v.color);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "swatch" + (v.color === state.color ? " active" : "");
        btn.style.setProperty("--swatch", v.colorHex);
        btn.style.setProperty("--swatch2", v.colorHex2);
        btn.title = v.colorLabel;
        btn.setAttribute("aria-label", v.colorLabel);
        btn.addEventListener("click", () => {
          if (state.color === v.color) return;
          state.color = v.color;
          render();
        });
        colorContainer.appendChild(btn);
      }
    }

    function currentVariant(): CardVariant | undefined {
      return catalog.variants.find(
        (v) => v.thread === state.thread && v.color === state.color && v.addon === state.addon
      );
    }

    function render() {
      const avail = variantsForThread(state.thread);
      if (!avail.some((v) => v.color === state.color)) {
        state.color = avail[0]?.color || "";
      }

      threadButtons.forEach((b) => b.classList.toggle("active", b.dataset.thread === state.thread));
      renderColorSwatches();

      const variant = currentVariant();
      if (!variant || !photoFront || !photoLeft || !variantName || !buyBtn) return;

      photoFront.classList.add("is-swapping");
      photoLeft.classList.add("is-swapping");
      window.setTimeout(() => {
        photoFront.src = variant.front;
        photoFront.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, front`;
        photoLeft.src = variant.left;
        photoLeft.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, angled left`;
        photoFront.classList.remove("is-swapping");
        photoLeft.classList.remove("is-swapping");
      }, 120);

      variantName.textContent = variant.colorLabel;
      buyBtn.href = `/api/create-checkout-session?product=${variant.key}`;
    }

    threadButtons.forEach((b) => {
      b.addEventListener("click", () => {
        if (b.dataset.thread === state.thread) return;
        state.thread = b.dataset.thread || state.thread;
        render();
      });
    });

    addonToggle.addEventListener("change", () => {
      state.addon = addonToggle.checked;
      render();
    });

    state.color = variantsForThread(state.thread)[0]?.color || "";
    render();
  });
</script>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .login-nudge {
    margin-top: 1.25rem;
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    max-width: 52ch;
  }
  .login-nudge a {
    color: var(--amber-500);
    font-weight: 600;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .design-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .design-media {
    width: 100%;
    background: var(--cream-100);
  }
  /* Two real Printful mockup photos (front + a 3/4 angle showing the left
     side) shown side by side — same "two photos together" feel as the old
     pre-merged pair images, just as two <img>s instead of one baked PNG. */
  .mockup-pair {
    display: flex;
    width: 100%;
    aspect-ratio: 2 / 1;
  }
  .mockup-photo {
    width: 50%;
    height: 100%;
    object-fit: contain;
    background: var(--cream-100);
    opacity: 1;
    transition: opacity 0.12s ease;
  }
  .mockup-photo.is-swapping {
    opacity: 0;
  }
  .design-tagline {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 1.1rem;
  }
  .selector {
    margin: 0 0 1.1rem;
  }
  .selector-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-on-light-muted);
    margin-bottom: 0.5rem;
  }
  .thread-swatches,
  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .thread-swatch,
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .thread-swatch {
    background: var(--swatch);
  }
  /* Cap-color swatches use a two-tone gradient dot for two-tone caps
     (e.g. Black crown / Natural mesh bill) so the swatch itself hints at
     what the cap actually looks like, not just a flat color guess. */
  .swatch {
    background: linear-gradient(135deg, var(--swatch) 50%, var(--swatch2) 50%);
  }
  .thread-swatch.active,
  .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
  .addon-toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--text-on-light-muted);
    margin: 0 0 1.1rem;
    cursor: pointer;
  }
  .addon-toggle input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--forest-800);
    cursor: pointer;
  }
  .color-name,
  .variant-name {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-on-light-muted);
  }
  .design-body {
    padding: 2rem 2.1rem 2.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .design-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .design-body .btn {
    width: 100%;
    text-align: center;
    margin-top: auto;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<!-- Cap-color swatch buttons are created client-side via document.createElement
     (see script above) — they never get the data-astro-cid scoping attribute
     Astro adds to elements written directly in this template, so the scoped
     .swatch rule in the <style> block above silently never applies to them.
     This duplicate, unscoped copy is what actually styles them. Keep it in
     sync with .thread-swatch/.swatch above if those ever change. -->
<style is:global>
  .color-swatches .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    background: linear-gradient(135deg, var(--swatch) 50%, var(--swatch2) 50%);
  }
  .color-swatches .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
</style>
