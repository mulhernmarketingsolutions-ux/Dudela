---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getAuthedMember } from "../lib/auth";
import SpitUpBanner from "../components/SpitUpBanner.astro";
import { HAT_CATALOG, type HatVariant, type Design, SHIRT_CATALOG, SHIRT_YEARS } from "../lib/printful";

const env = (Astro.locals as any).runtime.env;

// Nudge (not a requirement) for Spit-Up Society members to log in before
// buying — that's what makes create-checkout-session.ts attach the purchase
// to their existing Stripe customer so it shows up in their billing portal.
// Checkout stays open to everyone logged out or not; requiring login would
// lock out anyone who isn't already a paying member, which is the opposite
// of what a merch drop is for.
const member = await getAuthedMember(Astro.cookies, env);

// Base display prices for the nav links / section blurbs below — derived
// from the catalogs (not hand-typed) so a future price change only ever
// needs to happen in printful.ts, same reasoning as the per-variant price
// spans and buy buttons elsewhere on this page.
const HAT_BASE_PRICE = Math.round(parseFloat(HAT_CATALOG[0].price));
const SHIRT_BASE_PRICE = Math.round(parseFloat(SHIRT_CATALOG[0].price));

// Sticker 5-pack is a single fixed-price SKU with no catalog entry of its
// own (see api/create-checkout-session.ts and api/stripe-webhook.ts's
// "sticker-5pack" PRODUCTS entries) -- hand-typed here to match, unlike the
// two prices above. If this ever changes, update it in all three places.
const STICKER_PRICE = 20;

// Bundle & Save — buy one hat + one shirt together, 15% off each. Must match
// BUNDLE_DISCOUNT_PERCENT in lib/printful.ts (the real source of truth,
// used by api/create-cart-checkout-session.ts — that's the file that
// actually charges the card now; this copy is only used to render the
// Bundle & Save section's estimated price below, so a mismatch would just
// show the wrong number, not the wrong charge — but keep them in sync).
//
// REWRITTEN 2026-09-11: the discount used to be its own fixed-to-the-
// bottom-of-the-screen bar with its own separate instant checkout
// (?product=bundle). Now that /merch has a real multi-item cart, the
// discount is folded into it instead (see create-cart-checkout-session.ts)
// — this section is a normal in-flow block between Hats and Stickers that
// mirrors whatever hat + shirt variant the cards below currently have
// selected (see the client script's currentHat/currentShirt +
// updateBundleSection()) and adds both to the cart on click. The old
// ?product=bundle endpoint and its webhook branch still exist but nothing
// in the UI links to them anymore.
const BUNDLE_DISCOUNT_PERCENT = 15;

// REWRITTEN 2026-08-13: the old version of this page had one static color
// picker per design, backed by pre-merged "pair" images built by hand at
// image-prep time. That worked for 12 fixed colorways — it doesn't for the
// real current catalog, where cap color and thread color are independently
// selectable (e.g. a Black cap exists under both the White-thread and
// Orange-thread product groups) and there's now a "Dude² Dad" side-embroidery
// add-on toggle on top of that. HAT_CATALOG in lib/printful.ts is the single
// source of truth for every real, buyable combination — this page groups it
// by design and hands the client JS below a small catalog of real variants
// (thread color, cap color, add-on state, real Printful mockup photos, and
// the checkout key) to pick from, instead of a fixed list of colors.
//
// Every color/thread combo is backed by two real Printful mockup photos —
// straight-on front + a 3/4 angle showing the left side — shown side by side
// (same "two real photos together" strategy as the old pre-merged pairs,
// just as two separate <img>s instead of one baked-together PNG, since these
// are generated per-thread-color rather than hand-merged upfront).
const DESIGN_INFO: Record<Design, { title: string; tagline: string }> = {
  classic: {
    title: "The Classic",
    tagline: "The one that started it all — DUDELA, flipped and arched, reading right back at you.",
  },
  rookie: {
    title: "The Rookie",
    tagline: "The new one — DUDELA stitched across the front, ready to grow with the job.",
  },
};

// Cap color is the primary selector (see the hat-card markup/client JS
// below) — a visitor picks the physical cap first, then which thread
// color it's stitched in, since the valid thread options actually depend
// on the cap (e.g. a Black cap only ever ships with White or Orange
// thread, never Black-on-Black — see HAT_CATALOG in lib/printful.ts for
// the real, asymmetric per-design (thread, color) combinations; picking
// thread first used to let you land on a cap/thread pair that doesn't
// exist, which silently "flipped" the hat to a different cap on click).
// Orange first in THREAD_ORDER because Rust Orange is the hero thread
// wherever it's offered; COLOR_ORDER puts the hero cap colorway (Dark
// Green/Natural bill) first for the same reason.
const THREAD_ORDER = ["orange", "white", "black"] as const;
const COLOR_ORDER = ["dark-green-natural", "black-natural", "black", "white"] as const;

// Each design's starting cap color. Classic keeps the original hero
// colorway (Dark Green/Natural bill + Orange thread). Rookie defaults to
// Black/Natural bill + Black thread — the only combo the real catalog
// offers for that cap on this design.
const DEFAULT_COLOR_BY_DESIGN: Record<Design, string> = {
  classic: "dark-green-natural",
  rookie: "black-natural",
};

function colorSlug(v: HatVariant): string {
  const prefix = `${v.design}-${v.thread}-${v.addon ? "withaddon" : "noaddon"}-`;
  return v.key.startsWith(prefix) ? v.key.slice(prefix.length) : v.key;
}

const designs = (Object.keys(DESIGN_INFO) as Design[]).map((dkey) => {
  const variants = HAT_CATALOG.filter((v) => v.design === dkey);

  const clientVariants = variants.map((v) => ({
    key: v.key,
    thread: v.thread,
    threadLabel: v.threadLabel,
    threadHex: v.threadHex,
    color: colorSlug(v),
    colorLabel: v.colorLabel,
    colorHex: v.colorHex,
    colorHex2: v.colorHex2 || v.colorHex,
    addon: v.addon,
    price: v.price,
    front: v.frontImage,
    left: v.leftImage,
  }));

  const colors = COLOR_ORDER.filter((c) => clientVariants.some((v) => v.color === c)).map((c) => {
    const sample = clientVariants.find((v) => v.color === c)!;
    return { key: c, label: sample.colorLabel, hex: sample.colorHex, hex2: sample.colorHex2 };
  });

  const defaultColor = DEFAULT_COLOR_BY_DESIGN[dkey];
  const defaultColorCandidates = clientVariants.filter((v) => v.color === defaultColor && !v.addon);
  const defaultThread =
    THREAD_ORDER.find((t) => defaultColorCandidates.some((v) => v.thread === t)) || defaultColorCandidates[0]?.thread;
  const first = defaultColorCandidates.find((v) => v.thread === defaultThread) || defaultColorCandidates[0];

  return {
    key: dkey,
    title: DESIGN_INFO[dkey].title,
    tagline: DESIGN_INFO[dkey].tagline,
    colors,
    variants: clientVariants,
    first,
  };
});

// SHIRTS — a clean color × year × size cross product (no filtering needed
// the way hats need thread-vs-cap-color filtering), grouped by `design` so
// a second shirt design (already planned) just needs a SHIRT_DESIGN_INFO
// entry and SHIRT_CATALOG rows in lib/printful.ts, not a rewrite of this
// page. "Year" is the "EST. 2024"–"EST. 2027" print on the design itself —
// added 2026-08-14 alongside color as a second selector; title/tagline no
// longer bake in a specific year since that's now user-selectable (the card
// title updates client-side to match — see data-shirt-title in the client
// script below).
const SHIRT_DESIGN_INFO: Record<string, { title: string; tagline: string }> = {
  "dad-est": {
    title: "DAD EST.",
    tagline: `A clean "DAD EST." chest hit up front — pick your year — the DUDELA fist-bump wordmark across the back.`,
  },
};
const SHIRT_COLOR_ORDER = ["black", "ivory"];
const DEFAULT_SHIRT_YEAR = "2026";

const shirtDesignKeys = [...new Set(SHIRT_CATALOG.map((v) => v.design))];
const shirtDesigns = shirtDesignKeys.map((dkey) => {
  const variants = SHIRT_CATALOG.filter((v) => v.design === dkey);
  const colors = SHIRT_COLOR_ORDER.filter((c) => variants.some((v) => v.color === c)).map((c) => {
    const sample = variants.find((v) => v.color === c)!;
    return { key: c, label: sample.colorLabel, hex: sample.colorHex };
  });
  const years = SHIRT_YEARS.filter((y) => variants.some((v) => v.year === y));

  const clientVariants = variants.map((v) => ({
    key: v.key,
    color: v.color,
    colorLabel: v.colorLabel,
    colorHex: v.colorHex,
    year: v.year,
    size: v.size,
    front: v.frontImage,
    back: v.backImage,
    logoDetail: v.logoDetailImage,
    price: v.price,
  }));

  const first =
    clientVariants.find((v) => v.color === colors[0]?.key && v.year === DEFAULT_SHIRT_YEAR && v.size === "M") ||
    clientVariants.find((v) => v.color === colors[0]?.key && v.size === "M") ||
    clientVariants[0];

  const info = SHIRT_DESIGN_INFO[dkey] || { title: dkey, tagline: "" };

  return {
    key: dkey,
    title: info.title,
    tagline: info.tagline,
    colors,
    years,
    sizes: variants.map((v) => v.size).filter((s, i, arr) => arr.indexOf(s) === i),
    variants: clientVariants,
    first,
  };
});

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Merch — Hats & Shirts" description="Hats and shirts, made to order and shipped straight to your door. Free shipping.">
  <Nav isAuthed={!!member} />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>Dudela gear.</h1>
      <p class="hero-sub">
        Hats and shirts, made to order and shipped straight to your door. Free shipping, no
        restocks to wait on.
      </p>

      <div class="product-nav" role="group" aria-label="Jump to product">
        <a href="#shirts" class="product-nav-link">Shirts — ${SHIRT_BASE_PRICE}</a>
        <a href="#hats" class="product-nav-link">Hats — from ${HAT_BASE_PRICE}</a>
        <a href="#stickers" class="product-nav-link">Stickers — ${STICKER_PRICE}</a>
      </div>
      <p class="bundle-hint">Get a hat and a shirt together and we knock {BUNDLE_DISCOUNT_PERCENT}% off each — no code needed, it shows up automatically once you've picked both.</p>

      {!member && (
        <p class="login-nudge">
          Already a Spit-Up Society member? <a href="/member/login">Log in first</a> so this
          purchase shows up in your billing portal too.
        </p>
      )}

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick your gear below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section id="shirts" class="colors section-light shirts-section">
    <div class="container">
      <div class="section-divider">
        <h2>The Dudela shirt.</h2>
        <p class="section-sub">Comfort Colors heavyweight tee — front chest hit, full back print. ${SHIRT_BASE_PRICE}, free shipping, made to order.</p>
      </div>
      <div class="colors-grid">
        {shirtDesigns.map((d) => (
          <div class="design-card shirt-card" data-design={d.key}>
            <div class="design-media">
              <div class="mockup-pair">
                <img class="mockup-photo" data-photo-front src={d.first.front} alt={`Dudela Shirt — ${d.title}, front`} />
                <img class="mockup-photo" data-photo-back src={d.first.back} alt={`Dudela Shirt — ${d.title}, back`} />
              </div>
            </div>
            <div class="design-body">
              <h3 data-shirt-title>{d.title} {d.first.year}</h3>
              <p class="design-tagline">{d.tagline}</p>

              <div class="selector">
                <span class="selector-label">Color</span>
                <div class="color-swatches" role="group" aria-label={`${d.title} color`} data-shirt-colors>
                  {d.colors.map((c) => (
                    <button
                      type="button"
                      class={`swatch${c.key === d.first.color ? " active" : ""}`}
                      style={`--swatch: ${c.hex}; --swatch2: ${c.hex}`}
                      title={c.label}
                      aria-label={c.label}
                      data-shirt-color={c.key}
                    />
                  ))}
                </div>
              </div>

              <div class="selector">
                <span class="selector-label">Year</span>
                <select class="year-select" aria-label={`${d.title} year`} data-shirt-years>
                  {d.years.map((y) => (
                    <option value={y} selected={y === d.first.year}>{y}</option>
                  ))}
                </select>
              </div>

              <div class="selector">
                <span class="selector-label">Size</span>
                <div class="size-options" role="group" aria-label={`${d.title} size`} data-shirt-sizes>
                  {d.sizes.map((s) => (
                    <button type="button" class={`size-btn${s === d.first.size ? " active" : ""}`} data-shirt-size={s}>{s}</button>
                  ))}
                </div>
              </div>

              <div class="color-meta">
                <span class="price" data-price>${Math.round(parseFloat(d.first.price))}</span>
                <span class="variant-name" data-variant-name>{d.first.colorLabel}, {d.first.year}, {d.first.size}</span>
              </div>
              <a href={`/api/create-checkout-session?product=${d.first.key}`} class="btn btn-primary" data-buy>
                Buy Now — ${Math.round(parseFloat(d.first.price))}
              </a>
              <button type="button" class="btn btn-ghost btn-add-cart" data-add-cart>Add to Cart</button>

              <div class="detail-links">
                <button type="button" class="detail-chip" data-open-details="shirt">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.25"/>
                    <line x1="8" y1="7.2" x2="8" y2="11"/>
                    <circle cx="8" cy="4.9" r="0.9" fill="currentColor" stroke="none"/>
                  </svg>
                  Material, fit &amp; sizing
                </button>
                <div class="logo-detail" data-logo-detail-wrap>
                  <button type="button" class="detail-chip" data-logo-detail-toggle aria-expanded="false">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                      <circle cx="6.8" cy="6.8" r="4.3"/>
                      <line x1="10.1" y1="10.1" x2="14" y2="14"/>
                    </svg>
                    See the design up close
                  </button>
                  <div class="logo-detail-popover" data-logo-detail-popover hidden>
                    <img class="logo-detail-img" data-logo-detail src={d.first.logoDetail} alt={`${d.title} ${d.first.year} logo, up close`} />
                  </div>
                </div>
              </div>
            </div>

            <script type="application/json" data-shirt-catalog set:html={JSON.stringify(d)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="hats" class="colors section-light hats-section">
    <div class="container">
      <div class="section-divider">
        <h2>The Dudela hat.</h2>
        <p class="section-sub">Two designs, three thread colors, a cap color to match, and an optional "Dude to Dad" side stitch — ${HAT_BASE_PRICE}, free shipping.</p>
      </div>
      <div class="colors-grid">
      {designs.map((d) => (
        <div class="design-card" data-design={d.key}>
          <div class="design-media">
            <div class="mockup-pair">
              <img class="mockup-photo" data-photo-front src={d.first.front} alt={`Dudela Hat — ${d.title}, front`} />
              <img class="mockup-photo" data-photo-left src={d.first.left} alt={`Dudela Hat — ${d.title}, angled left`} />
            </div>
          </div>
          <div class="design-body">
            <h3>{d.title}</h3>
            <p class="design-tagline">{d.tagline}</p>

            <div class="selector">
              <span class="selector-label">Cap color</span>
              <div class="color-swatches" role="group" aria-label={`${d.title} cap color`} data-color-swatches>
                {d.colors.map((c) => (
                  <button
                    type="button"
                    class={`swatch${c.key === d.first.color ? " active" : ""}`}
                    style={`--swatch: ${c.hex}; --swatch2: ${c.hex2}`}
                    title={c.label}
                    aria-label={c.label}
                    data-color={c.key}
                  />
                ))}
              </div>
            </div>

            <div class="selector">
              <span class="selector-label">Thread color</span>
              <div class="thread-swatches" role="group" aria-label={`${d.title} thread color`} data-thread-swatches></div>
            </div>

            <button type="button" class="addon-toggle" data-addon-toggle aria-pressed="false">
              <span class="addon-toggle-switch" aria-hidden="true"></span>
              <span class="addon-toggle-text">
                <span class="addon-toggle-title">+ "Dude to Dad" stitch <span class="addon-toggle-price">+$1</span></span>
                <span class="addon-toggle-sub">A little extra flex on the side — proof you made the leap.</span>
              </span>
            </button>

            <div class="color-meta">
              <span class="price" data-price>${Math.round(parseFloat(d.first.price) + (d.first.addon ? 1 : 0))}</span>
              <span class="variant-name" data-variant-name>{d.first.colorLabel}</span>
            </div>
            <a href={`/api/create-checkout-session?product=${d.first.key}`} class="btn btn-primary" data-buy>
              Buy Now — ${Math.round(parseFloat(d.first.price) + (d.first.addon ? 1 : 0))}
            </a>
            <button type="button" class="btn btn-ghost btn-add-cart" data-add-cart>Add to Cart</button>

            <div class="detail-links">
              <button type="button" class="detail-chip" data-open-details="hat">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.25"/>
                  <line x1="8" y1="7.2" x2="8" y2="11"/>
                  <circle cx="8" cy="4.9" r="0.9" fill="currentColor" stroke="none"/>
                </svg>
                Material &amp; fit
              </button>
            </div>
          </div>

          <script type="application/json" data-catalog set:html={JSON.stringify(d)} />
        </div>
      ))}
      </div>
    </div>
  </section>

  <!-- Bundle & Save — a normal, non-fixed section (unlike the old pinned
       bundle bar) that mirrors whatever hat + shirt variant the cards above
       currently have selected (see updateBundleSection() in the script
       below) and lets a buyer add both to their cart at once. The 15%
       discount itself is applied by the cart (create-cart-checkout-
       session.ts) automatically once it holds at least one hat and one
       shirt — this section is just the "here's the deal, here's your
       current picks" surface, not a separate checkout path. -->
  <section class="bundle-section section-light" id="bundle-section" aria-label="Bundle discount">
    <div class="container bundle-section-inner">
      <div class="bundle-section-items">
        <img class="bundle-section-thumb" data-bundle-hat-img alt="" />
        <span class="bundle-section-plus">+</span>
        <img class="bundle-section-thumb" data-bundle-shirt-img alt="" />
      </div>
      <div class="bundle-section-text">
        <h3>Bundle &amp; save {BUNDLE_DISCOUNT_PERCENT}%</h3>
        <p class="bundle-section-picks" data-bundle-picks></p>
        <p class="bundle-section-sub">Add both to your cart and the discount applies automatically — no code needed.</p>
      </div>
      <div class="bundle-section-right">
        <div class="bundle-section-price">
          <span class="bundle-section-was" data-bundle-was></span>
          <span class="bundle-section-now" data-bundle-now></span>
        </div>
        <button type="button" class="btn btn-primary" id="bundle-add-to-cart">
          Add Both to Cart
        </button>
      </div>
    </div>
  </section>

  <section id="stickers" class="colors section-light stickers-section">
    <div class="container">
      <div class="section-divider">
        <h2>Dudela Sticker 5-Pack.</h2>
        <p class="section-sub">Five kiss-cut vinyl stickers — diaper bag, laptop, truck bumper, wherever. ${STICKER_PRICE}, free shipping, ships in a few days.</p>
      </div>
      <div class="colors-grid">
        <div class="design-card">
          <div class="design-media">
            <div class="mockup-pair">
              <img class="mockup-photo" src="/images/sticker/sticker-flat.png" alt="Dudela sticker, single, close up" />
              <img class="mockup-photo" src="/images/sticker/sticker-laptop.png" alt="Dudela sticker applied to a laptop lid" />
            </div>
          </div>
          <div class="design-body">
            <h3>Sticker 5-Pack</h3>
            <p class="design-tagline">Kiss-cut vinyl, weatherproof — the fist-bump logo, five times over.</p>

            <div class="color-meta">
              <span class="price">${STICKER_PRICE}</span>
              <span class="variant-name">5 stickers, one design</span>
            </div>
            <a href="/api/create-checkout-session?product=sticker-5pack" class="btn btn-primary" data-buy>
              Buy Now — ${STICKER_PRICE}
            </a>
            <button type="button" class="btn btn-ghost btn-add-cart" id="sticker-add-cart">Add to Cart</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Affiliate pick — single-row banner, same pattern as SpitUpBanner.astro
       (filled amber pill badge, one line of copy, one CTA) rather than a
       card dropped into the product grid above. A bare text-only card next
       to photo-rich shirt/hat/sticker cards read as an unfinished product
       tile; this reads as an intentional, branded callout instead, while
       the badge + disclosure still make clear it's not a Dudela SKU. -->
  <section class="affiliate-banner">
    <div class="container affiliate-banner-inner">
      <div class="affiliate-banner-copy">
        <span class="affiliate-banner-badge">Affiliate pick &middot; not a Dudela product</span>
        <p class="affiliate-banner-text">
          Want eyes on the crib without hovering over it? Here's the <strong>video baby monitor</strong> we'd actually point another dad toward.
        </p>
        <p class="affiliate-banner-disclosure">Ships from the retailer, not Dudela — affiliate link, we may earn a commission if you buy.</p>
      </div>
      <a href="https://babymonitordirectllc.pxf.io/rEq1o3" class="btn btn-primary affiliate-banner-cta" target="_blank" rel="sponsored noopener">
        See baby monitors <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Product Details & Sizing — one shared dialog for both product types
       rather than one per card, since the specs are the same across every
       hat design (all Otto Cap 31-069) and every shirt design (all Comfort
       Colors 1717). All figures below are Printful's own catalog data for
       these exact products, not marketing copy — pulled from their public
       Catalog API, not written up ourselves. -->
  <dialog id="details-modal" class="details-modal">
    <button type="button" class="details-close" data-details-close aria-label="Close">&times;</button>

    <div class="details-panel" data-panel="hat">
      <h3>The Dudela hat</h3>
      <p class="details-sub">5-panel mid-profile cap, Otto Cap 31-069.</p>
      <dl class="details-list">
        <div><dt>Material</dt><dd>65% polyester / 35% cotton — a structured, breathable blend, not a soft-crown dad hat.</dd></div>
        <div><dt>Fit</dt><dd>One size fits most. Adjustable snap closure in back.</dd></div>
        <div><dt>Details</dt><dd>Structured front panel, matching undervisor and sweatband.</dd></div>
      </dl>
    </div>

    <div class="details-panel" data-panel="shirt">
      <h3>The Dudela shirt</h3>
      <p class="details-sub">Comfort Colors 1717 heavyweight tee.</p>
      <dl class="details-list">
        <div><dt>Material</dt><dd>100% ring-spun cotton, garment-dyed, 6.1 oz/yd² — heavier and sturdier than a standard cotton tee.</dd></div>
        <div><dt>Fit</dt><dd>Relaxed fit. Runs true to size.</dd></div>
        <div><dt>Details</dt><dd>Twill-taped neck and shoulders, double-needle stitching at the collar, armholes, sleeves, and hem for durability.</dd></div>
      </dl>
      <table class="size-table">
        <caption>Size chart (inches)</caption>
        <thead>
          <tr><th>Size</th><th>Length</th><th>Chest</th><th>Sleeve</th></tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>26.6</td><td>18.3</td><td>16.3</td></tr>
          <tr><td>M</td><td>28</td><td>20.3</td><td>17.8</td></tr>
          <tr><td>L</td><td>29.4</td><td>22</td><td>19</td></tr>
          <tr><td>XL</td><td>30.8</td><td>24</td><td>20.5</td></tr>
          <tr><td>2XL</td><td>31.6</td><td>26</td><td>21.8</td></tr>
          <tr><td>3XL</td><td>32.5</td><td>27.8</td><td>23.3</td></tr>
          <tr><td>4XL</td><td>33.5</td><td>29.8</td><td>24.6</td></tr>
        </tbody>
      </table>
      <p class="size-note">Measured flat, product may vary up to 2".</p>
    </div>
  </dialog>

  <section class="perks section-light">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>Free shipping</h3>
        <p>No shipping fees, no minimums, on hats or shirts. Just your gear, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every piece is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your gear shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <SpitUpBanner />

  <!-- Cart toggle + drawer — lets a buyer add several different items
       (a couple of shirt years/colors, more than one hat, extra sticker
       packs) to one order instead of the single-item Buy Now flow above
       being the only way to check out. Buy Now still works exactly as
       before for anyone who just wants one thing fast — this is purely
       additive. Cart state lives in localStorage (see the script below)
       so it survives a reload. -->
  <button type="button" class="cart-toggle" id="cart-toggle" aria-label="View cart" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1.4"/><circle cx="19" cy="21" r="1.4"/><path d="M2.5 3h2.4l2.7 12.6a2 2 0 0 0 2 1.6h8a2 2 0 0 0 2-1.6L21.5 7H6"/></svg>
    <span class="cart-toggle-count" id="cart-toggle-count" hidden>0</span>
  </button>

  <div class="cart-backdrop" id="cart-backdrop"></div>

  <aside class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Your cart" aria-hidden="true">
    <div class="cart-drawer-head">
      <h3>Your order</h3>
      <button type="button" class="cart-drawer-close" id="cart-drawer-close" aria-label="Close cart">&times;</button>
    </div>
    <div class="cart-drawer-body">
      <p class="cart-empty" id="cart-empty">Nothing in your order yet — add a hat, shirt, or sticker pack above.</p>
      <ul class="cart-lines" id="cart-lines"></ul>
    </div>
    <div class="cart-drawer-foot" id="cart-drawer-foot" hidden>
      <p class="cart-bundle-hint" id="cart-bundle-hint" hidden></p>
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <span id="cart-subtotal-amount">$0</span>
      </div>
      <div class="cart-bundle-discount" id="cart-bundle-discount" hidden>
        <span>🎉 Bundle discount (hat + shirt)</span>
        <span id="cart-bundle-discount-amount">-$0</span>
      </div>
      <div class="cart-total" id="cart-total-row" hidden>
        <span>Total</span>
        <span id="cart-total-amount">$0</span>
      </div>
      <p class="cart-note">Shipping — and any promo code — applied at checkout.</p>
      <button type="button" class="btn btn-primary cart-checkout-btn" id="cart-checkout-btn">Checkout</button>
      <p class="cart-error" id="cart-error" hidden></p>
    </div>
  </aside>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS, no framework — matches the rest of the site. Each design card
  // gets its own small catalog (embedded as JSON at build time, see
  // `data-catalog` above) of every real (thread, cap color, add-on) variant
  // Printful actually has built, plus that variant's two real mockup photos
  // and its checkout key. Three controls read/write one piece of state per
  // card — thread, color, add-on — and any change re-resolves to the exact
  // matching variant and updates the photos, label, and buy link.
  //
  // Thread and cap color are NOT a full cross product (e.g. no cap ships in
  // Black cap + Black thread — the stitching wouldn't show up), so the cap
  // color swatches are rebuilt from only the colors that actually exist for
  // the currently selected thread every time the thread changes. The add-on
  // toggle doesn't affect which colors are available — every (thread, color)
  // pair exists in both add-on states — so it's a simple independent switch.

  // Bundle & Save section (a normal in-flow section between Hats and
  // Stickers, not fixed) — mirrors whichever hat + shirt variant these two
  // sections currently have selected, so there's no separate/duplicate
  // bundle picker anywhere on the page. currentHat/currentShirt just track
  // the latest selection; updateBundleSection() repaints the section
  // whenever either changes.
  interface BundleSelection {
    key: string;
    label: string;
    price: number;
    addon: boolean;
    image: string;
  }
  let currentHat: BundleSelection | null = null;
  let currentShirt: BundleSelection | null = null;

  // Keep in sync with BUNDLE_DISCOUNT_PERCENT in this page's frontmatter and
  // in lib/printful.ts (the actual source of truth for the charge, used by
  // create-cart-checkout-session.ts) — this copy only drives the Bundle &
  // Save section's live price preview.
  const BUNDLE_DISCOUNT_PERCENT = 15;

  // --- Cart -------------------------------------------------------------
  // A lightweight multi-item cart layered on top of the single-item Buy Now
  // flow (unchanged everywhere below) — lets a buyer add a few different
  // things (a couple of shirt years/colors, more than one hat, a sticker
  // pack) and check out once instead of one Stripe Checkout per item.
  // State lives in localStorage so it survives a reload; checkout POSTs the
  // line list to /api/create-cart-checkout-session, which builds one real
  // multi-line-item Stripe session (see that file, and stripe-webhook.ts's
  // isCart branch for fulfillment).
  interface CartItem {
    key: string;
    label: string;
    price: number;
    image?: string;
    qty: number;
    // "hat" | "shirt" | "sticker" — lets the cart detect Bundle & Save
    // eligibility (at least one hat + one shirt) without guessing from the
    // key's shape. Set at every addToCart() call site.
    category: "hat" | "shirt" | "sticker";
    // Hat only: the flat "Dude to Dad" stitch surcharge already folded into
    // `price`, in CENTS — kept separate so the bundle discount math can
    // subtract it back out (the surcharge itself never gets discounted,
    // matching create-cart-checkout-session.ts's server-side math).
    addonCents?: number;
  }
  const CART_STORAGE_KEY = "dudela_cart_v1";
  // Keep in sync with MAX_CART_LINES / MAX_QTY_PER_LINE in
  // create-cart-checkout-session.ts — those are the real server-side caps;
  // these just stop a buyer from filling a cart the server would reject.
  const CART_MAX_LINES = 10;
  const CART_MAX_QTY = 20;

  function loadCart(): CartItem[] {
    try {
      const raw = window.localStorage.getItem(CART_STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }
  function saveCart(items: CartItem[]) {
    try {
      window.localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(items));
    } catch {
      // Private browsing / storage disabled — cart just won't survive a
      // reload; still works fine within the current page view.
    }
  }

  let cart: CartItem[] = loadCart();

  const cartToggle = document.getElementById("cart-toggle");
  const cartToggleCount = document.getElementById("cart-toggle-count");
  const cartBackdrop = document.getElementById("cart-backdrop");
  const cartDrawer = document.getElementById("cart-drawer");
  const cartDrawerClose = document.getElementById("cart-drawer-close");
  const cartLinesEl = document.getElementById("cart-lines");
  const cartEmptyEl = document.getElementById("cart-empty");
  const cartFootEl = document.getElementById("cart-drawer-foot");
  const cartSubtotalEl = document.getElementById("cart-subtotal-amount");
  const cartBundleHintEl = document.getElementById("cart-bundle-hint");
  const cartBundleDiscountEl = document.getElementById("cart-bundle-discount");
  const cartBundleDiscountAmountEl = document.getElementById("cart-bundle-discount-amount");
  const cartTotalRowEl = document.getElementById("cart-total-row");
  const cartTotalAmountEl = document.getElementById("cart-total-amount");
  const cartCheckoutBtn = document.getElementById("cart-checkout-btn") as HTMLButtonElement | null;
  const cartErrorEl = document.getElementById("cart-error");

  // Bundle & Save, mirrored client-side purely for display — the server
  // (create-cart-checkout-session.ts) is what actually charges the
  // discounted amount; this just needs to match closely enough that the
  // drawer's numbers agree with what Stripe shows a moment later. Discounts
  // exactly ONE hat + ONE shirt (the first of each added), same scope as
  // the real checkout logic — extra hats/shirts beyond that stay full price.
  function computeBundleDiscountCents(): number {
    const hatItem = cart.find((i) => i.category === "hat");
    const shirtItem = cart.find((i) => i.category === "shirt");
    if (!hatItem || !shirtItem) return 0;
    const hatBaseCents = Math.round(hatItem.price * 100) - (hatItem.addonCents || 0);
    const shirtBaseCents = Math.round(shirtItem.price * 100);
    return (
      Math.round(hatBaseCents * (BUNDLE_DISCOUNT_PERCENT / 100)) +
      Math.round(shirtBaseCents * (BUNDLE_DISCOUNT_PERCENT / 100))
    );
  }

  function renderCart() {
    saveCart(cart);
    const totalQty = cart.reduce((n, i) => n + i.qty, 0);
    if (cartToggleCount) {
      cartToggleCount.textContent = String(totalQty);
      cartToggleCount.hidden = totalQty === 0;
    }
    if (!cartLinesEl || !cartEmptyEl || !cartFootEl || !cartSubtotalEl) return;
    cartLinesEl.innerHTML = "";
    if (cart.length === 0) {
      cartEmptyEl.hidden = false;
      cartFootEl.hidden = true;
      return;
    }
    cartEmptyEl.hidden = true;
    cartFootEl.hidden = false;
    let subtotal = 0;
    cart.forEach((item) => {
      subtotal += item.price * item.qty;
      const li = document.createElement("li");
      li.className = "cart-line";
      li.innerHTML = `
        ${item.image ? `<img src="${item.image}" alt="" class="cart-line-img" />` : ""}
        <div class="cart-line-info">
          <span class="cart-line-label">${item.label}</span>
          <span class="cart-line-price">$${item.price.toFixed(2)} each</span>
        </div>
        <div class="cart-line-qty">
          <button type="button" class="cart-qty-btn" data-qty-down aria-label="Decrease quantity">−</button>
          <span class="cart-qty-value">${item.qty}</span>
          <button type="button" class="cart-qty-btn" data-qty-up aria-label="Increase quantity">+</button>
        </div>
        <button type="button" class="cart-line-remove" data-remove aria-label="Remove ${item.label}">&times;</button>
      `;
      li.querySelector("[data-qty-down]")?.addEventListener("click", () => setQty(item.key, item.qty - 1));
      li.querySelector("[data-qty-up]")?.addEventListener("click", () => setQty(item.key, item.qty + 1));
      li.querySelector("[data-remove]")?.addEventListener("click", () => removeFromCart(item.key));
      cartLinesEl.appendChild(li);
    });
    cartSubtotalEl.textContent = `$${subtotal.toFixed(2)}`;

    const hasHat = cart.some((i) => i.category === "hat");
    const hasShirt = cart.some((i) => i.category === "shirt");
    const discountCents = computeBundleDiscountCents();

    if (cartBundleDiscountEl && cartBundleDiscountAmountEl && cartTotalRowEl && cartTotalAmountEl) {
      const eligible = discountCents > 0;
      cartBundleDiscountEl.hidden = !eligible;
      cartTotalRowEl.hidden = !eligible;
      if (eligible) {
        cartBundleDiscountAmountEl.textContent = `-$${(discountCents / 100).toFixed(2)}`;
        cartTotalAmountEl.textContent = `$${(subtotal - discountCents / 100).toFixed(2)}`;
      }
    }

    if (cartBundleHintEl) {
      if (hasHat && !hasShirt) {
        cartBundleHintEl.textContent = `Add a shirt and save ${BUNDLE_DISCOUNT_PERCENT}% on this hat too.`;
        cartBundleHintEl.hidden = false;
      } else if (hasShirt && !hasHat) {
        cartBundleHintEl.textContent = `Add a hat and save ${BUNDLE_DISCOUNT_PERCENT}% on this shirt too.`;
        cartBundleHintEl.hidden = false;
      } else {
        cartBundleHintEl.hidden = true;
      }
    }
  }

  function addToCart(
    newItem: {
      key: string;
      label: string;
      price: number;
      image?: string;
      category: "hat" | "shirt" | "sticker";
      addonCents?: number;
    },
    qty = 1
  ) {
    const existing = cart.find((i) => i.key === newItem.key);
    if (existing) {
      existing.qty = Math.min(CART_MAX_QTY, existing.qty + qty);
    } else {
      if (cart.length >= CART_MAX_LINES) {
        window.alert(
          `You can combine up to ${CART_MAX_LINES} different items in one order — check out this cart first, or remove something to add this.`
        );
        return;
      }
      cart.push({ ...newItem, qty: Math.min(CART_MAX_QTY, qty) });
    }
    renderCart();
    openCart();
  }

  function setQty(key: string, qty: number) {
    const item = cart.find((i) => i.key === key);
    if (!item) return;
    if (qty < 1) {
      removeFromCart(key);
      return;
    }
    item.qty = Math.min(CART_MAX_QTY, qty);
    renderCart();
  }

  function removeFromCart(key: string) {
    cart = cart.filter((i) => i.key !== key);
    renderCart();
  }

  function openCart() {
    cartDrawer?.classList.add("is-open");
    cartBackdrop?.classList.add("is-open");
    cartDrawer?.setAttribute("aria-hidden", "false");
    cartToggle?.setAttribute("aria-expanded", "true");
  }
  function closeCart() {
    cartDrawer?.classList.remove("is-open");
    cartBackdrop?.classList.remove("is-open");
    cartDrawer?.setAttribute("aria-hidden", "true");
    cartToggle?.setAttribute("aria-expanded", "false");
  }

  cartToggle?.addEventListener("click", () => {
    if (cartDrawer?.classList.contains("is-open")) closeCart();
    else openCart();
  });
  cartDrawerClose?.addEventListener("click", closeCart);
  cartBackdrop?.addEventListener("click", closeCart);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeCart();
  });

  cartCheckoutBtn?.addEventListener("click", async () => {
    if (cart.length === 0 || !cartCheckoutBtn) return;
    cartCheckoutBtn.disabled = true;
    cartCheckoutBtn.textContent = "Redirecting…";
    if (cartErrorEl) cartErrorEl.hidden = true;
    try {
      const res = await fetch("/api/create-cart-checkout-session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items: cart.map((i) => ({ key: i.key, qty: i.qty })) }),
      });
      if (!res.ok) throw new Error(await res.text());
      const data = (await res.json()) as { url: string };
      window.location.href = data.url;
    } catch (err) {
      cartCheckoutBtn.disabled = false;
      cartCheckoutBtn.textContent = "Checkout";
      if (cartErrorEl) {
        cartErrorEl.textContent = "Something went wrong starting checkout — try again in a moment.";
        cartErrorEl.hidden = false;
      }
      console.error("Cart checkout failed:", err);
    }
  });

  document.getElementById("sticker-add-cart")?.addEventListener("click", () => {
    addToCart({
      key: "sticker-5pack",
      label: "Dudela Sticker 5-Pack",
      price: 20,
      image: "/images/sticker/sticker-flat.png",
      category: "sticker",
    });
  });

  renderCart();
  // --- End cart -----------------------------------------------------------

  // Bundle & Save section — a normal in-flow section (see the markup
  // between the Hats and Stickers sections), not a fixed/pinned bar, so no
  // collapse/flare/mobile machinery is needed anymore: it just mirrors
  // whichever hat + shirt variant the cards above currently have selected,
  // same as the old bar did, and its button adds both to the cart instead
  // of jumping straight to its own separate checkout. The actual 15%
  // discount is applied by the cart itself (create-cart-checkout-
  // session.ts) once it holds at least one hat and one shirt — see
  // renderCart() above, which shows the live savings once that happens.
  const bundleSection = document.getElementById("bundle-section");
  const bundleHatImg = bundleSection?.querySelector<HTMLImageElement>("[data-bundle-hat-img]");
  const bundleShirtImg = bundleSection?.querySelector<HTMLImageElement>("[data-bundle-shirt-img]");
  const bundlePicks = bundleSection?.querySelector<HTMLElement>("[data-bundle-picks]");
  const bundleWas = bundleSection?.querySelector<HTMLElement>("[data-bundle-was]");
  const bundleNow = bundleSection?.querySelector<HTMLElement>("[data-bundle-now]");
  const bundleAddBtn = document.getElementById("bundle-add-to-cart");

  function updateBundleSection() {
    if (!currentHat || !currentShirt) return;
    if (bundleHatImg) {
      bundleHatImg.src = currentHat.image;
      bundleHatImg.alt = currentHat.label;
    }
    if (bundleShirtImg) {
      bundleShirtImg.src = currentShirt.image;
      bundleShirtImg.alt = currentShirt.label;
    }
    if (bundlePicks) bundlePicks.textContent = `${currentHat.label} + ${currentShirt.label}`;

    const discountMultiplier = 1 - BUNDLE_DISCOUNT_PERCENT / 100;
    // The $1 add-on surcharge isn't discounted server-side either (see
    // create-cart-checkout-session.ts's bundle-split logic) — kept flat
    // here to match.
    const addonSurcharge = currentHat.addon ? 1 : 0;
    const fullTotal = currentHat.price + addonSurcharge + currentShirt.price;
    const discountedTotal =
      currentHat.price * discountMultiplier + addonSurcharge + currentShirt.price * discountMultiplier;

    if (bundleWas) bundleWas.textContent = `$${fullTotal.toFixed(2)}`;
    if (bundleNow) bundleNow.textContent = `$${discountedTotal.toFixed(2)}`;
  }

  bundleAddBtn?.addEventListener("click", () => {
    if (!currentHat || !currentShirt) return;
    addToCart({
      key: currentHat.key,
      label: currentHat.label,
      price: currentHat.price,
      image: currentHat.image,
      category: "hat",
      addonCents: currentHat.addon ? 100 : 0,
    });
    addToCart({
      key: currentShirt.key,
      label: currentShirt.label,
      price: currentShirt.price,
      image: currentShirt.image,
      category: "shirt",
    });
  });

  interface CardVariant {
    key: string;
    thread: string;
    threadLabel: string;
    threadHex: string;
    color: string;
    colorLabel: string;
    colorHex: string;
    colorHex2: string;
    addon: boolean;
    price: string;
    front: string;
    left: string;
  }
  interface CardCatalog {
    title: string;
    colors: Array<{ key: string; label: string; hex: string; hex2: string }>;
    variants: CardVariant[];
    first: CardVariant;
  }

  // :not(.shirt-card) matters here — shirt cards also carry the
  // .design-card class (class="design-card shirt-card"), so a plain
  // ".design-card" selector counted the shirt card as index 0 and pushed
  // both hat cards to index >= 1. That meant isDefaultForBundle was false
  // for every hat card, currentHat never got set on load, and the bundle
  // bar's is-visible class never got added — the bug that made the whole
  // bar silently never appear.
  document.querySelectorAll<HTMLElement>(".design-card:not(.shirt-card)").forEach((card, cardIndex) => {
    const catalogScript = card.querySelector<HTMLScriptElement>("[data-catalog]");
    if (!catalogScript?.textContent) return;
    const catalog: CardCatalog = JSON.parse(catalogScript.textContent);

    // Which hat design "counts" for the bundle bar: the first design card
    // (Classic — the hero design) publishes its selection by default on
    // load; whichever hat card the visitor actually interacts with takes
    // over from then on, so the bar always tracks the last thing you
    // actually touched instead of silently reverting to Classic.
    const isDefaultForBundle = cardIndex === 0;
    let userInteracted = false;

    const photoFront = card.querySelector<HTMLImageElement>("[data-photo-front]");
    const photoLeft = card.querySelector<HTMLImageElement>("[data-photo-left]");
    const colorButtons = card.querySelectorAll<HTMLButtonElement>("[data-color]");
    const threadContainer = card.querySelector<HTMLElement>("[data-thread-swatches]");
    const addonToggle = card.querySelector<HTMLButtonElement>("[data-addon-toggle]");
    const variantName = card.querySelector<HTMLElement>("[data-variant-name]");
    const priceEl = card.querySelector<HTMLElement>("[data-price]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    const addCartBtn = card.querySelector<HTMLButtonElement>("[data-add-cart]");
    if (!photoFront || !photoLeft || !threadContainer || !addonToggle || !variantName || !priceEl || !buyBtn) return;

    // Preload every real mockup photo for this card up front so swapping
    // thread/color/add-on never shows a half-loaded image or a network
    // delay — same instant-swap feel as the old single-image pair picker.
    catalog.variants.forEach((v) => {
      new Image().src = v.front;
      new Image().src = v.left;
    });

    // Cap color first, thread color second: state.color drives which
    // threads are even offered, so it's never possible to click a thread
    // swatch that doesn't exist for the current cap (the old "flips to a
    // different hat" bug) — an invalid thread just never renders as an
    // option. Starting values come straight from catalog.first, which the
    // frontmatter already resolved to this design's real default combo.
    const state = { color: catalog.first.color, thread: catalog.first.thread, addon: false };

    function variantsForColor(color: string) {
      return catalog.variants.filter((v) => v.color === color);
    }

    function renderThreadSwatches() {
      if (!threadContainer) return;
      threadContainer.innerHTML = "";
      const seen = new Set<string>();
      for (const v of variantsForColor(state.color)) {
        if (seen.has(v.thread)) continue;
        seen.add(v.thread);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "thread-swatch" + (v.thread === state.thread ? " active" : "");
        btn.style.setProperty("--swatch", v.threadHex);
        btn.title = v.threadLabel;
        btn.setAttribute("aria-label", v.threadLabel);
        btn.addEventListener("click", () => {
          if (state.thread === v.thread) return;
          userInteracted = true;
          state.thread = v.thread;
          render();
        });
        threadContainer.appendChild(btn);
      }
    }

    function currentVariant(): CardVariant | undefined {
      return catalog.variants.find(
        (v) => v.thread === state.thread && v.color === state.color && v.addon === state.addon
      );
    }

    function render() {
      const avail = variantsForColor(state.color);
      if (!avail.some((v) => v.thread === state.thread)) {
        state.thread = avail[0]?.thread || "";
      }

      colorButtons.forEach((b) => b.classList.toggle("active", b.dataset.color === state.color));
      renderThreadSwatches();

      const variant = currentVariant();
      if (!variant || !photoFront || !photoLeft || !variantName || !priceEl || !buyBtn) return;

      photoFront.classList.add("is-swapping");
      photoLeft.classList.add("is-swapping");
      window.setTimeout(() => {
        photoFront.src = variant.front;
        photoFront.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, front`;
        photoLeft.src = variant.left;
        photoLeft.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, angled left`;
        photoFront.classList.remove("is-swapping");
        photoLeft.classList.remove("is-swapping");
        // The add-on's side stitch is small in a full-hat shot — zoom the
        // angled photo in on it when the add-on is selected so it's actually
        // legible, instead of a barely-visible detail off to the side.
        photoLeft.classList.toggle("is-addon-zoom", variant.addon);
      }, 120);

      variantName.textContent = variant.colorLabel;
      const priceLabel = `$${Math.round(parseFloat(variant.price) + (variant.addon ? 1 : 0))}`;
      priceEl.textContent = priceLabel;
      buyBtn.textContent = `Buy Now — ${priceLabel}`;
      buyBtn.href = `/api/create-checkout-session?product=${variant.key}`;

      if (isDefaultForBundle || userInteracted) {
        // Hat price is a flat $38 across every real variant today (see
        // HAT_CATALOG in lib/printful.ts), but derived from variant.price
        // rather than hand-typed so this can't drift if that ever changes —
        // same reasoning as the shirt side (SHIRT_DESIGN_COLORS.price). The
        // add-on is tracked separately as its own $1 surcharge, same split
        // the server uses — bundle math adds it on top itself when relevant.
        currentHat = {
          key: variant.key,
          label: `${catalog.title} — ${variant.colorLabel}`,
          price: parseFloat(variant.price),
          addon: variant.addon,
          image: variant.front,
        };
        updateBundleSection();
      }
    }

    colorButtons.forEach((b) => {
      b.addEventListener("click", () => {
        if (b.dataset.color === state.color) return;
        userInteracted = true;
        state.color = b.dataset.color || state.color;
        render();
      });
    });

    addonToggle.addEventListener("click", () => {
      userInteracted = true;
      state.addon = !state.addon;
      addonToggle.setAttribute("aria-pressed", String(state.addon));
      addonToggle.classList.toggle("active", state.addon);
      render();
    });

    addCartBtn?.addEventListener("click", () => {
      const variant = currentVariant();
      if (!variant) return;
      addToCart({
        key: variant.key,
        label: `${catalog.title} — ${variant.colorLabel}${variant.addon ? " + Stitch" : ""}`,
        price: parseFloat(variant.price) + (variant.addon ? 1 : 0),
        image: variant.front,
        category: "hat",
        addonCents: variant.addon ? 100 : 0,
      });
    });

    render();
  });

  // Shirt cards — same pattern as hat cards above but simpler: color, year,
  // and size are a full cross product (no filtering), no add-on, and the
  // two mockup photos are front/back instead of front/angled-left.
  interface ShirtCardVariant {
    key: string;
    color: string;
    colorLabel: string;
    colorHex: string;
    year: string;
    size: string;
    front: string;
    back: string;
    logoDetail: string;
    price: string;
  }
  interface ShirtCardCatalog {
    title: string;
    colors: Array<{ key: string; label: string; hex: string }>;
    years: string[];
    sizes: string[];
    variants: ShirtCardVariant[];
  }

  // Closes any open logo-detail popover across every shirt card — one set
  // of global listeners rather than one per card (see the click handler
  // inside the forEach below).
  function closeAllLogoPopovers() {
    document.querySelectorAll<HTMLElement>("[data-logo-detail-popover]").forEach((el) => {
      el.hidden = true;
    });
    document.querySelectorAll<HTMLButtonElement>("[data-logo-detail-toggle]").forEach((el) => {
      el.setAttribute("aria-expanded", "false");
    });
  }
  document.addEventListener("click", closeAllLogoPopovers);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAllLogoPopovers();
  });

  document.querySelectorAll<HTMLElement>(".shirt-card").forEach((card) => {
    const catalogScript = card.querySelector<HTMLScriptElement>("[data-shirt-catalog]");
    if (!catalogScript?.textContent) return;
    const catalog: ShirtCardCatalog = JSON.parse(catalogScript.textContent);

    const photoFront = card.querySelector<HTMLImageElement>("[data-photo-front]");
    const photoBack = card.querySelector<HTMLImageElement>("[data-photo-back]");
    const logoDetailImg = card.querySelector<HTMLImageElement>("[data-logo-detail]");
    const logoDetailToggle = card.querySelector<HTMLButtonElement>("[data-logo-detail-toggle]");
    const logoDetailPopover = card.querySelector<HTMLElement>("[data-logo-detail-popover]");
    const titleEl = card.querySelector<HTMLElement>("[data-shirt-title]");
    const yearContainer = card.querySelector<HTMLSelectElement>("[data-shirt-years]");
    const colorContainer = card.querySelector<HTMLElement>("[data-shirt-colors]");
    const sizeContainer = card.querySelector<HTMLElement>("[data-shirt-sizes]");
    const variantName = card.querySelector<HTMLElement>("[data-variant-name]");
    const priceEl = card.querySelector<HTMLElement>("[data-price]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    const addCartBtn = card.querySelector<HTMLButtonElement>("[data-add-cart]");
    if (!photoFront || !photoBack || !yearContainer || !colorContainer || !sizeContainer || !variantName || !priceEl || !buyBtn) return;

    // Logo-close-up popover — was a thumbnail permanently sitting in the
    // card whether anyone wanted it or not; now it's collapsed behind a
    // small link and only appears on demand. Closing (outside click /
    // Escape) is handled once, globally, below — not per card — so this
    // doesn't stack up duplicate document listeners if a second shirt
    // design is ever added.
    if (logoDetailToggle && logoDetailPopover) {
      logoDetailToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !logoDetailPopover.hidden;
        closeAllLogoPopovers();
        if (!isOpen) {
          logoDetailPopover.hidden = false;
          logoDetailToggle.setAttribute("aria-expanded", "true");
        }
      });
    }

    // Load the selected shirt only; other years load when selected.

    const DEFAULT_SHIRT_YEAR = "2026";
    const state = {
      color: catalog.colors[0]?.key || "",
      year: catalog.years.includes(DEFAULT_SHIRT_YEAR) ? DEFAULT_SHIRT_YEAR : catalog.years[0] || "",
      size: "M",
    };

    function currentVariant(): ShirtCardVariant | undefined {
      return catalog.variants.find(
        (v) => v.color === state.color && v.year === state.year && v.size === state.size
      );
    }

    function render() {
      yearContainer!.value = state.year;
      colorContainer!.querySelectorAll<HTMLButtonElement>("[data-shirt-color]").forEach((b) => {
        b.classList.toggle("active", b.dataset.shirtColor === state.color);
      });
      sizeContainer!.querySelectorAll<HTMLButtonElement>("[data-shirt-size]").forEach((b) => {
        b.classList.toggle("active", b.dataset.shirtSize === state.size);
      });

      const variant = currentVariant();
      if (!variant || !photoFront || !photoBack || !variantName || !priceEl || !buyBtn) return;

      photoFront.classList.add("is-swapping");
      photoBack.classList.add("is-swapping");
      window.setTimeout(() => {
        photoFront.src = variant.front;
        photoFront.alt = `Dudela Shirt — ${catalog.title} ${variant.year}, ${variant.colorLabel}, front`;
        photoBack.src = variant.back;
        photoBack.alt = `Dudela Shirt — ${catalog.title} ${variant.year}, ${variant.colorLabel}, back`;
        photoFront.classList.remove("is-swapping");
        photoBack.classList.remove("is-swapping");
        if (logoDetailImg) {
          logoDetailImg.src = variant.logoDetail;
          logoDetailImg.alt = `${catalog.title} ${variant.year} logo, up close, ${variant.colorLabel}`;
        }
      }, 120);

      if (titleEl) titleEl.textContent = `${catalog.title} ${variant.year}`;
      variantName.textContent = `${variant.colorLabel}, ${variant.year}, ${variant.size}`;
      const priceLabel = `$${Math.round(parseFloat(variant.price))}`;
      priceEl.textContent = priceLabel;
      buyBtn.textContent = `Buy Now — ${priceLabel}`;
      buyBtn.href = `/api/create-checkout-session?product=${variant.key}`;

      // Only one shirt design exists today, so this always publishes — if a
      // second design is ever added, this'll need the same
      // isDefaultForBundle/userInteracted split the hat cards use above.
      currentShirt = {
        key: variant.key,
        label: `${catalog.title} ${variant.year} — ${variant.colorLabel}, ${variant.size}`,
        price: parseFloat(variant.price),
        addon: false,
        image: variant.front,
      };
      updateBundleSection();
    }

    yearContainer.addEventListener("change", () => {
      state.year = yearContainer.value;
      render();
    });

    colorContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-shirt-color]");
      if (!btn) return;
      state.color = btn.dataset.shirtColor || state.color;
      render();
    });

    sizeContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-shirt-size]");
      if (!btn) return;
      state.size = btn.dataset.shirtSize || state.size;
      render();
    });

    addCartBtn?.addEventListener("click", () => {
      const variant = currentVariant();
      if (!variant) return;
      addToCart({
        key: variant.key,
        label: `${catalog.title} ${variant.year} — ${variant.colorLabel}, ${variant.size}`,
        price: parseFloat(variant.price),
        image: variant.front,
        category: "shirt",
      });
    });

    render();
  });

  // Product Details & Sizing modal — one shared <dialog>, content switched
  // by adding data-type="hat"|"shirt" to it (see the matching CSS below,
  // which shows/hides the two .details-panel blocks accordingly).
  (() => {
    const modal = document.getElementById("details-modal") as HTMLDialogElement | null;
    if (!modal) return;

    document.querySelectorAll<HTMLButtonElement>("[data-open-details]").forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.dataset.type = btn.dataset.openDetails || "hat";
        modal.showModal();
      });
    });

    modal.querySelector("[data-details-close]")?.addEventListener("click", () => modal.close());

    // Click on the backdrop (outside the modal's own padded box) closes it —
    // clicking the modal element itself fires for both the box and the
    // ::backdrop, so this checks the click actually landed on the <dialog>
    // element rather than something inside it.
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });
  })();
</script>

