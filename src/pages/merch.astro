---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { countMerchOrders } from "../lib/db";

const env = (Astro.locals as any).runtime.env;

// Source of truth for what's buyable lives in lib/printful.ts (HAT_CATALOG) — this
// list mirrors it for display purposes. Real Printful-rendered mockups for the two
// cream colorways; the two black-cap versions still need mockups (those color
// variants aren't built as Printful templates yet — see conversation with John).
const COLORS = [
  {
    slug: "hat-fistbump-cream",
    product: "hat-fistbump-cream",
    name: "Fist Bump — Cream, Black Bill",
    description: "The original. A small fist bump up front, DUDELA stitched across the back — for when a high-five feels like too much.",
    images: ["/images/hat-fistbump-cream-front.png", "/images/hat-fistbump-cream-back.png"],
  },
  {
    slug: "hat-fistbump-black",
    product: "hat-fistbump-black",
    name: "Fist Bump — Black",
    description: "Same fist bump, blacked out, stitched in white so it still shows up.",
    images: [],
  },
  {
    slug: "hat-upsidedown-cream",
    product: "hat-upsidedown-cream",
    name: "Upside Down — Cream, Green Bill",
    description: "DUDELA, flipped upside down and arched like a varsity letter. Forest green bill — the original.",
    images: ["/images/hat-upsidedown-cream-front.png"],
  },
  {
    slug: "hat-upsidedown-black",
    product: "hat-upsidedown-black",
    name: "Upside Down — Black",
    description: "Same upside-down wordmark, blacked out, stitched in white.",
    images: [],
  },
];

// Printful makes these to order, so there's no real stock cap anymore — countMerchOrders
// is kept purely as an internal sales count (still useful to glance at), not a gate.
const colorways = await Promise.all(
  COLORS.map(async (c) => {
    const sold = await countMerchOrders(env, c.slug);
    return { ...c, sold };
  })
);

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Hats — Merch" description="Two designs, four colors, $38 each, free shipping. Made to order and shipped straight to your door.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>The Dudela hat.</h1>
      <p class="hero-sub">
        Two designs, four colors, $38 each, free shipping. Every hat is made to order and
        shipped straight to your door — no waiting on a batch.
      </p>

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick a color below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {colorways.map((c) => (
        <div class="color-card">
          <div class="color-media">
            {c.images.length > 1 ? (
              <div class="photo-pair">
                {c.images.map((src) => (
                  <img src={src} alt={`Dudela Hat — ${c.name}`} loading="lazy" />
                ))}
              </div>
            ) : c.images.length === 1 ? (
              <img class="single-photo" src={c.images[0]} alt={`Dudela Hat — ${c.name}`} loading="lazy" />
            ) : (
              <PhotoPlaceholder label="Image coming soon" ratio="1/1" />
            )}
          </div>
          <div class="color-body">
            <h3>{c.name}</h3>
            <p class="color-desc">{c.description}</p>
            <div class="color-meta">
              <span class="price">$38</span>
            </div>
            <a href={`/api/create-checkout-session?product=${c.product}`} class="btn btn-primary">
              Buy Now — $38
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every hat is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .color-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .color-media {
    width: 100%;
  }
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .photo-pair img,
  .single-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--cream-100);
  }
  .color-body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .color-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-desc {
    color: var(--text-on-light-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .stock {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust-600);
  }
  .stock-out {
    color: var(--text-on-light-muted);
  }
  .color-body .btn {
    width: 100%;
    text-align: center;
  }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid var(--border-light);
    color: var(--text-on-light-muted);
    cursor: not-allowed;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 620px) {
    .colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .colors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
