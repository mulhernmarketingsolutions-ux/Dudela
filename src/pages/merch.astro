---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { countMerchOrders } from "../lib/db";

const env = (Astro.locals as any).runtime.env;

// Source of truth for what's buyable lives in lib/printful.ts (HAT_CATALOG) — this
// mirrors it, grouped by design so the page can show one card per design with a
// color picker inside it, instead of one flat card per color (easier to compare,
// and matches how John actually thinks about these: 2 designs, pick your color).
const DESIGNS = [
  {
    key: "fistbump",
    title: "Fist Bump",
    tagline: "Small logo up front, DUDELA stitched across the back.",
    colors: [
      {
        slug: "hat-fistbump-cream",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "The original. A small fist bump up front, DUDELA stitched across the back — for when a high-five feels like too much.",
        images: ["/images/hat-fistbump-cream-front.png", "/images/hat-fistbump-cream-back.png"],
      },
      {
        slug: "hat-fistbump-black",
        name: "Black",
        swatch: "#141414",
        description: "Same fist bump, blacked out, stitched in white so it still shows up.",
        images: [],
      },
      {
        slug: "hat-fistbump-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean and bright, fist bump stitched in black.",
        images: [],
      },
      {
        slug: "hat-fistbump-navy",
        name: "Navy",
        swatch: "#1c2740",
        description: "Deep navy, stitched in white so it pops.",
        images: [],
      },
      {
        slug: "hat-fistbump-khaki",
        name: "Khaki",
        swatch: "#c3b091",
        description: "Neutral khaki, stitched in black.",
        images: [],
      },
      {
        slug: "hat-fistbump-green",
        name: "Cream, Green Bill",
        swatch: "#57684a",
        description: "Cream crown, forest green bill, stitched to match.",
        images: [],
      },
    ],
  },
  {
    key: "upsidedown",
    title: "Upside Down",
    tagline: "The DUDELA wordmark, flipped and arched, front and center.",
    colors: [
      {
        slug: "hat-upsidedown-cream",
        name: "Cream, Green Bill",
        swatch: "#57684a",
        description: "DUDELA, flipped upside down and arched like a varsity letter. Forest green bill — the original.",
        images: ["/images/hat-upsidedown-cream-front.png"],
      },
      {
        slug: "hat-upsidedown-black",
        name: "Black",
        swatch: "#141414",
        description: "Same upside-down wordmark, blacked out, stitched in white.",
        images: [],
      },
      {
        slug: "hat-upsidedown-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean and bright, wordmark stitched in black.",
        images: [],
      },
      {
        slug: "hat-upsidedown-navy",
        name: "Navy",
        swatch: "#1c2740",
        description: "Deep navy, stitched in white.",
        images: [],
      },
      {
        slug: "hat-upsidedown-khaki",
        name: "Khaki",
        swatch: "#c3b091",
        description: "Neutral khaki, stitched in black.",
        images: [],
      },
      {
        slug: "hat-upsidedown-blackbill",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "Cream crown, black bill, wordmark stitched in black.",
        images: [],
      },
    ],
  },
];

// Printful makes these to order, so there's no real stock cap anymore — countMerchOrders
// is kept purely as an internal sales count (still useful to glance at), not a gate.
const designs = await Promise.all(
  DESIGNS.map(async (d) => ({
    ...d,
    colors: await Promise.all(
      d.colors.map(async (c) => ({ ...c, sold: await countMerchOrders(env, c.slug) }))
    ),
  }))
);

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Hats — Merch" description="Two designs, six colors each, $38, free shipping. Made to order and shipped straight to your door.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>The Dudela hat.</h1>
      <p class="hero-sub">
        Two designs, six colors each, $38, free shipping. Every hat is made to order and
        shipped straight to your door — no waiting on a batch.
      </p>

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick a color below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {designs.map((d) => {
        const first = d.colors[0];
        return (
          <div class="design-card" data-design={d.key}>
            <div class="design-media" data-media>
              {first.images.length > 1 ? (
                <div class="photo-pair">
                  {first.images.map((src) => (
                    <img src={src} alt={`Dudela Hat — ${d.title}, ${first.name}`} loading="lazy" />
                  ))}
                </div>
              ) : first.images.length === 1 ? (
                <img class="single-photo" src={first.images[0]} alt={`Dudela Hat — ${d.title}, ${first.name}`} loading="lazy" />
              ) : (
                <PhotoPlaceholder label="Image coming soon" ratio="1/1" />
              )}
            </div>
            <div class="design-body">
              <h3>{d.title}</h3>
              <p class="design-tagline">{d.tagline}</p>
              <p class="color-desc" data-desc>{first.description}</p>

              <div class="swatches" role="group" aria-label={`${d.title} color`}>
                {d.colors.map((c, i) => (
                  <button
                    type="button"
                    class={`swatch${i === 0 ? " active" : ""}`}
                    style={`--swatch: ${c.swatch}`}
                    title={c.name}
                    aria-label={c.name}
                    data-slug={c.slug}
                    data-name={c.name}
                    data-desc={c.description}
                    data-images={JSON.stringify(c.images)}
                  />
                ))}
              </div>

              <div class="color-meta">
                <span class="price">$38</span>
                <span class="color-name" data-colorname>{first.name}</span>
              </div>
              <a href={`/api/create-checkout-session?product=${first.slug}`} class="btn btn-primary" data-buy>
                Buy Now — $38
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every hat is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS color-swatch picker — no framework, matches the rest of the site.
  // Each design card renders its first color server-side; clicking a swatch swaps
  // the image(s), description, color name, and buy-now link to that color's data,
  // which is embedded on each swatch button as data-* attributes at build time.
  document.querySelectorAll<HTMLElement>(".design-card").forEach((card) => {
    const media = card.querySelector<HTMLElement>("[data-media]");
    const desc = card.querySelector<HTMLElement>("[data-desc]");
    const colorName = card.querySelector<HTMLElement>("[data-colorname]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    const swatches = card.querySelectorAll<HTMLButtonElement>(".swatch");
    if (!media || !desc || !colorName || !buyBtn) return;

    function renderMedia(images: string[], name: string) {
      if (!media) return;
      if (images.length > 1) {
        media.innerHTML = `<div class="photo-pair">${images
          .map((src) => `<img src="${src}" alt="Dudela Hat — ${name}" loading="lazy" />`)
          .join("")}</div>`;
      } else if (images.length === 1) {
        media.innerHTML = `<img class="single-photo" src="${images[0]}" alt="Dudela Hat — ${name}" loading="lazy" />`;
      } else {
        media.innerHTML = `<div class="photo-placeholder" style="aspect-ratio: 1/1;"><span>Image coming soon</span></div>`;
      }
    }

    swatches.forEach((btn) => {
      btn.addEventListener("click", () => {
        swatches.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        renderMedia(JSON.parse(btn.dataset.images || "[]"), btn.dataset.name || "");
        desc.textContent = btn.dataset.desc || "";
        colorName.textContent = btn.dataset.name || "";
        buyBtn.href = `/api/create-checkout-session?product=${btn.dataset.slug}`;
      });
    });
  });
</script>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .design-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .design-media {
    width: 100%;
  }
  .design-tagline {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.1rem;
  }
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--swatch);
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
  .color-name {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-on-light-muted);
  }
  :global(.photo-placeholder) {
    position: relative;
    width: 100%;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
    border-radius: var(--radius-sm);
    background:
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04) 0px,
        rgba(255, 255, 255, 0.04) 2px,
        transparent 2px,
        transparent 14px
      ),
      linear-gradient(155deg, #2a3322 0%, #1c2319 55%, #12180f 100%);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  :global(.photo-placeholder span) {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 239, 227, 0.55);
    border: 1px dashed rgba(245, 239, 227, 0.25);
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
  }
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .photo-pair img,
  .single-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    background: var(--cream-100);
  }
  .color-body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .color-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-desc {
    color: var(--text-on-light-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .stock {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust-600);
  }
  .stock-out {
    color: var(--text-on-light-muted);
  }
  .color-body .btn {
    width: 100%;
    text-align: center;
  }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid var(--border-light);
    color: var(--text-on-light-muted);
    cursor: not-allowed;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
