---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { countMerchOrders } from "../lib/db";
import { getAuthedMember } from "../lib/auth";

const env = (Astro.locals as any).runtime.env;

// Nudge (not a requirement) for Spit-Up Society members to log in before
// buying — that's what makes create-checkout-session.ts attach the purchase
// to their existing Stripe customer so it shows up in their billing portal.
// Checkout stays open to everyone logged out or not; requiring login would
// lock out anyone who isn't already a paying member, which is the opposite
// of what a merch drop is for.
const member = await getAuthedMember(Astro.cookies, env);

// Source of truth for what's buyable lives in lib/printful.ts (HAT_CATALOG) — this
// mirrors it, grouped by design so the page can show one card per design with a
// color picker inside it, instead of one flat card per color (easier to compare,
// and matches how John actually thinks about these: 2 designs, pick your color).
//
// Per John: The Classic (the arched, flipped wordmark) is the original design —
// Fist Bump is the newer one. The original cream/green-bill Classic mockup
// had its wordmark stitched in green thread, which clashed against the green
// bill — John fixed it by re-stitching in rust orange (same accent used on
// White/Cream-Black-bill) and re-shot it front + a 3/4 angle side view. It's
// the hero color for The Classic now (shown by default) — Fist Bump doesn't
// have an equivalent green colorway back yet, so it stays at 3 colors.
//
// Every color below is backed by two real Printful mockup photos (front +
// a second angle), pre-merged at build time into one PNG per color
// (hat-{design}-{color}-pair.png — see public/images) so the page only ever
// shows a single <img>, not two side-by-side tags. That's what makes the
// swatch click feel like "the photo changes color," not "a new image loads":
// one element, one src swap, dimensions never move.
const DESIGNS = [
  {
    key: "upsidedown",
    title: "The Classic",
    tagline: "The one that started it all — DUDELA, flipped and arched, reading right back at you.",
    colors: [
      {
        slug: "hat-upsidedown-cream",
        name: "Cream, Green Bill",
        swatch: "#3a4a32",
        description: "The hero color. Cream crown, dark green bill, wordmark stitched in rust orange.",
        image: "/images/hat-upsidedown-cream-pair.png",
      },
      {
        slug: "hat-upsidedown-blackbill",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "Where it began. The wordmark flipped and arched, stitched in black.",
        image: "/images/hat-upsidedown-blackbill-pair.png",
      },
      {
        slug: "hat-upsidedown-black",
        name: "Black",
        swatch: "#141414",
        description: "Blacked out, wordmark stitched in white.",
        image: "/images/hat-upsidedown-black-pair.png",
      },
      {
        slug: "hat-upsidedown-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean white, wordmark stitched in black.",
        image: "/images/hat-upsidedown-white-pair.png",
      },
    ],
  },
  {
    key: "fistbump",
    title: "The Rookie",
    tagline: "The new one — a fist bump up front, DUDELA stitched across the back.",
    colors: [
      {
        slug: "hat-fistbump-black",
        name: "Black",
        swatch: "#141414",
        description: "Blacked out, stitched in white so it still throws a punch.",
        image: "/images/hat-fistbump-black-pair.png",
      },
      {
        slug: "hat-fistbump-white",
        name: "White",
        swatch: "#f5f5f0",
        description: "Clean and simple, fist bump stitched in rust orange.",
        image: "/images/hat-fistbump-white-pair.png",
      },
      {
        slug: "hat-fistbump-cream",
        name: "Cream, Black Bill",
        swatch: "#ece3d1",
        description: "Fist bump up front, DUDELA on the back, stitched in black.",
        image: "/images/hat-fistbump-cream-pair.png",
      },
      {
        slug: "hat-fistbump-green",
        name: "Cream, Green Bill",
        swatch: "#3a4a32",
        description: "Fist bump up front, DUDELA on the back, stitched in rust orange.",
        image: "/images/hat-fistbump-green-pair.png",
      },
    ],
  },
];

// Printful makes these to order, so there's no real stock cap anymore — countMerchOrders
// is kept purely as an internal sales count (still useful to glance at), not a gate.
const designs = await Promise.all(
  DESIGNS.map(async (d) => ({
    ...d,
    colors: await Promise.all(
      d.colors.map(async (c) => ({ ...c, sold: await countMerchOrders(env, c.slug) }))
    ),
  }))
);

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Hats — Merch" description="Two designs, $38, free shipping. Made to order and shipped straight to your door.">
  <Nav isAuthed={!!member} />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>The Dudela hat.</h1>
      <p class="hero-sub">
        Two designs, several colors each, $38, free shipping. Every hat is made to order and
        shipped straight to your door — no waiting on a batch.
      </p>

      {!member && (
        <p class="login-nudge">
          Already a Spit-Up Society member? <a href="/member/login">Log in first</a> so this
          purchase shows up in your billing portal too.
        </p>
      )}

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick a color below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {designs.map((d) => {
        const first = d.colors[0];
        return (
          <div class="design-card" data-design={d.key}>
            <div class="design-media" data-media>
              <img class="pair-img" src={first.image} alt={`Dudela Hat — ${d.title}, ${first.name}`} data-photo />
            </div>
            <div class="design-body">
              <h3>{d.title}</h3>
              <p class="design-tagline">{d.tagline}</p>
              <p class="color-desc" data-desc>{first.description}</p>

              <div class="swatches" role="group" aria-label={`${d.title} color`}>
                {d.colors.map((c, i) => (
                  <button
                    type="button"
                    class={`swatch${i === 0 ? " active" : ""}`}
                    style={`--swatch: ${c.swatch}`}
                    title={c.name}
                    aria-label={c.name}
                    data-slug={c.slug}
                    data-name={c.name}
                    data-desc={c.description}
                    data-image={c.image}
                  />
                ))}
              </div>

              <div class="color-meta">
                <span class="price">$38</span>
                <span class="color-name" data-colorname>{first.name}</span>
              </div>
              <a href={`/api/create-checkout-session?product=${first.slug}`} class="btn btn-primary" data-buy>
                Buy Now — $38
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every hat is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS color-swatch picker — no framework, matches the rest of the site.
  // Each design card renders its first color server-side; clicking a swatch swaps
  // the (single, pre-merged front+back/side) photo, description, color name, and
  // buy-now link to that color's data, embedded on each swatch button as data-*
  // attributes at build time.
  //
  // Every color's photo gets preloaded up front (new Image() below) so the swap
  // on click is instant — no network fetch, no flash of a half-loaded image, no
  // layout shift (same <img> element, same aspect-ratio box, only its src
  // changes). That's what makes clicking a color feel like "the hat changes
  // color" instead of "a new photo loads."
  document.querySelectorAll<HTMLElement>(".design-card").forEach((card) => {
    const photo = card.querySelector<HTMLImageElement>("[data-photo]");
    const desc = card.querySelector<HTMLElement>("[data-desc]");
    const colorName = card.querySelector<HTMLElement>("[data-colorname]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    const swatches = card.querySelectorAll<HTMLButtonElement>(".swatch");
    if (!photo || !desc || !colorName || !buyBtn) return;

    // Preload every color's photo for this design so none of them have to hit
    // the network the moment a swatch is clicked.
    swatches.forEach((btn) => {
      if (btn.dataset.image) {
        const preload = new Image();
        preload.src = btn.dataset.image;
      }
    });

    swatches.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.classList.contains("active")) return;
        swatches.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        // Quick crossfade instead of an instant pop — the src is already
        // cached from the preload above, so this is purely a visual
        // transition, not a loading state.
        photo.classList.add("is-swapping");
        window.setTimeout(() => {
          photo.src = btn.dataset.image || "";
          photo.alt = `Dudela Hat — ${btn.dataset.name || ""}`;
          photo.classList.remove("is-swapping");
        }, 120);

        desc.textContent = btn.dataset.desc || "";
        colorName.textContent = btn.dataset.name || "";
        buyBtn.href = `/api/create-checkout-session?product=${btn.dataset.slug}`;
      });
    });
  });
</script>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .login-nudge {
    margin-top: 1.25rem;
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    max-width: 52ch;
  }
  .login-nudge a {
    color: var(--amber-500);
    font-weight: 600;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .design-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .design-media {
    width: 100%;
  }
  .design-tagline {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1.1rem;
  }
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--swatch);
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
  .color-name {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-on-light-muted);
  }
  /* One <img> per card now — its src attribute is swapped in place on swatch
     click (see the <script> above), it never gets removed/re-created, so
     there's no Astro scoped-style gotcha to worry about here (that bug only
     bit the old two-image innerHTML-rebuild approach). Each src points at a
     pre-merged front+second-angle PNG (2:1) built at image-prep time, so the
     box's aspect-ratio never changes between colors — nothing jumps. */
  .pair-img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
    background: var(--cream-100);
    opacity: 1;
    transition: opacity 0.12s ease;
  }
  .pair-img.is-swapping {
    opacity: 0;
  }
  /* Was .color-body — leftover from before the swatch-picker rewrite, and no
     longer matched the actual markup (which uses .design-body), so this
     entire padding/spacing block was silently not applying at all. That's
     why the card content looked jammed against the edges. */
  .design-body {
    padding: 2rem 2.1rem 2.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .design-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-desc {
    color: var(--text-on-light-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .stock {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust-600);
  }
  .stock-out {
    color: var(--text-on-light-muted);
  }
  .design-body .btn {
    width: 100%;
    text-align: center;
    /* Pins the buy button to the bottom of the card regardless of how long
       the description runs — .design-card cards in the same grid row stretch
       to equal height, and without this the shorter card's button floated
       right under its text with a big dead gap below it. */
    margin-top: auto;
  }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid var(--border-light);
    color: var(--text-on-light-muted);
    cursor: not-allowed;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .colors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
