---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { countMerchOrders } from "../lib/db";

const env = (Astro.locals as any).runtime.env;

const CAP = 10;

const COLORS = [
  {
    slug: "classic",
    product: "hat-classic",
    name: "Classic",
    description: "Cream hat, forest green bill and lettering.",
    images: ["/images/hat-classic-front.webp", "/images/hat-classic-side.webp"],
  },
  {
    slug: "black-green",
    product: "hat-black-green",
    name: "All Black (Green Logo)",
    description: "All black, with the Dudela logo in forest green.",
    images: [],
  },
  {
    slug: "black-cream",
    product: "hat-black-cream",
    name: "Black (Cream Bill & Lettering)",
    description: "Black hat, cream bill and cream lettering.",
    images: [],
  },
];

const colorways = await Promise.all(
  COLORS.map(async (c) => {
    const sold = await countMerchOrders(env, c.slug);
    return { ...c, sold, remaining: Math.max(0, CAP - sold), soldOut: sold >= CAP };
  })
);

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
const soldOutColor = url.searchParams.get("sold_out");
---
<BaseLayout title="Dudela Hats — Merch" description="The Dudela hat presale is live. Three colorways, $38, free shipping — only 10 of each, first come first served.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch Presale</p>
      <h1>The Dudela hat is here — for a few of us, first.</h1>
      <p class="hero-sub">
        Three colorways, $38 each, free shipping. This first run is intentionally small —
        just 10 of each color — so once they're gone, they're gone until the next batch.
      </p>

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick a color below whenever you're ready.</p>
      )}
      {soldOutColor && (
        <p class="notice">
          That colorway just sold out of its first run — sorry! Check the others below, or watch for the next batch.
        </p>
      )}
    </div>
  </section>

  <section class="colors section-light">
    <div class="container colors-grid">
      {colorways.map((c) => (
        <div class="color-card">
          <div class="color-media">
            {c.images.length > 0 ? (
              <div class="photo-pair">
                {c.images.map((src) => (
                  <img src={src} alt={`Dudela Hat — ${c.name}`} loading="lazy" />
                ))}
              </div>
            ) : (
              <PhotoPlaceholder label="Image coming soon" ratio="1/1" />
            )}
          </div>
          <div class="color-body">
            <h3>{c.name}</h3>
            <p class="color-desc">{c.description}</p>
            <div class="color-meta">
              <span class="price">$38</span>
              {c.soldOut ? (
                <span class="stock stock-out">Sold out</span>
              ) : (
                <span class="stock">{c.remaining} of {CAP} left</span>
              )}
            </div>
            {c.soldOut ? (
              <button type="button" class="btn btn-outline-light" disabled>Sold Out</button>
            ) : (
              <a href={`/api/create-checkout-session?product=${c.product}`} class="btn btn-primary">
                Buy Now — $38
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>$38, free shipping</h3>
        <p>No shipping fees, no minimums. Just the hat, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>First run, first come</h3>
        <p>Only 10 of each colorway this round. When a color's gone, it's gone until the next batch.</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your hat shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .color-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
  }
  .color-media {
    width: 100%;
  }
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .photo-pair img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }
  .color-body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .color-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-desc {
    color: var(--text-on-light-muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .stock {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--rust-600);
  }
  .stock-out {
    color: var(--text-on-light-muted);
  }
  .color-body .btn {
    width: 100%;
    text-align: center;
  }
  .btn-outline-light {
    background: transparent;
    border: 1.5px solid var(--border-light);
    color: var(--text-on-light-muted);
    cursor: not-allowed;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .colors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
