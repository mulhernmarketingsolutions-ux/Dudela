---
// Live scarcity counts need a per-request D1 read, so this page can't be
// prerendered — same reasoning as the gated member pages.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getAuthedMember } from "../lib/auth";
import { HAT_CATALOG, type HatVariant, type Design, SHIRT_CATALOG, SHIRT_YEARS } from "../lib/printful";

const env = (Astro.locals as any).runtime.env;

// Nudge (not a requirement) for Spit-Up Society members to log in before
// buying — that's what makes create-checkout-session.ts attach the purchase
// to their existing Stripe customer so it shows up in their billing portal.
// Checkout stays open to everyone logged out or not; requiring login would
// lock out anyone who isn't already a paying member, which is the opposite
// of what a merch drop is for.
const member = await getAuthedMember(Astro.cookies, env);

// Bundle & Save — buy one hat + one shirt together, 15% off each. Must match
// BUNDLE_DISCOUNT_PERCENT in api/create-checkout-session.ts (that's the file
// that actually charges the card; this is only used to render the live bar's
// estimated price below, so a mismatch would just show the wrong number, not
// the wrong charge — but keep them in sync).
//
// REWRITTEN 2026-08-13: this used to be its own promo section with two
// dropdowns duplicating the hat/shirt pickers below — confusing, since a
// buyer could set a color/size down in the real product cards and then see
// totally different options in the bundle box. Now there's no separate
// picker at all: a slim bar fixed to the bottom of the screen just mirrors
// whatever hat + shirt variant the cards below currently have selected (see
// the client script's currentHat/currentShirt + updateBundleBar()), and its
// buy link is computed from that live state. bundleHats/bundleShirts arrays
// are gone — the cards' own embedded catalogs are the only source of truth
// for prices/labels now.
const BUNDLE_DISCOUNT_PERCENT = 15;

// REWRITTEN 2026-08-13: the old version of this page had one static color
// picker per design, backed by pre-merged "pair" images built by hand at
// image-prep time. That worked for 12 fixed colorways — it doesn't for the
// real current catalog, where cap color and thread color are independently
// selectable (e.g. a Black cap exists under both the White-thread and
// Orange-thread product groups) and there's now a "Dude² Dad" side-embroidery
// add-on toggle on top of that. HAT_CATALOG in lib/printful.ts is the single
// source of truth for every real, buyable combination — this page groups it
// by design and hands the client JS below a small catalog of real variants
// (thread color, cap color, add-on state, real Printful mockup photos, and
// the checkout key) to pick from, instead of a fixed list of colors.
//
// Every color/thread combo is backed by two real Printful mockup photos —
// straight-on front + a 3/4 angle showing the left side — shown side by side
// (same "two real photos together" strategy as the old pre-merged pairs,
// just as two separate <img>s instead of one baked-together PNG, since these
// are generated per-thread-color rather than hand-merged upfront).
const DESIGN_INFO: Record<Design, { title: string; tagline: string }> = {
  classic: {
    title: "The Classic",
    tagline: "The one that started it all — DUDELA, flipped and arched, reading right back at you.",
  },
  rookie: {
    title: "The Rookie",
    tagline: "The new one — DUDELA stitched across the front, ready to grow with the job.",
  },
};

// Orange first: Rust Orange thread on the Dark Green/Natural bill is the
// hero colorway (cream/green cap, orange wordmark) — that's what should
// greet a first-time visitor, not whatever happened to be first in the
// catalog dump.
const THREAD_ORDER = ["orange", "white", "black"] as const;
const DEFAULT_COLOR_SLUG = "dark-green-natural";

function colorSlug(v: HatVariant): string {
  const prefix = `${v.design}-${v.thread}-${v.addon ? "withaddon" : "noaddon"}-`;
  return v.key.startsWith(prefix) ? v.key.slice(prefix.length) : v.key;
}

const designs = (Object.keys(DESIGN_INFO) as Design[]).map((dkey) => {
  const variants = HAT_CATALOG.filter((v) => v.design === dkey);

  const threads = THREAD_ORDER.filter((t) => variants.some((v) => v.thread === t)).map((t) => {
    const sample = variants.find((v) => v.thread === t)!;
    return { key: t, label: sample.threadLabel, hex: sample.threadHex };
  });

  const clientVariants = variants.map((v) => ({
    key: v.key,
    thread: v.thread,
    color: colorSlug(v),
    colorLabel: v.colorLabel,
    colorHex: v.colorHex,
    colorHex2: v.colorHex2 || v.colorHex,
    addon: v.addon,
    front: v.frontImage,
    left: v.leftImage,
  }));

  const defaultThreadCandidates = clientVariants.filter((v) => v.thread === threads[0].key && !v.addon);
  const first = defaultThreadCandidates.find((v) => v.color === DEFAULT_COLOR_SLUG) || defaultThreadCandidates[0];

  return {
    key: dkey,
    title: DESIGN_INFO[dkey].title,
    tagline: DESIGN_INFO[dkey].tagline,
    threads,
    variants: clientVariants,
    first,
  };
});

// SHIRTS — a clean color × year × size cross product (no filtering needed
// the way hats need thread-vs-cap-color filtering), grouped by `design` so
// a second shirt design (already planned) just needs a SHIRT_DESIGN_INFO
// entry and SHIRT_CATALOG rows in lib/printful.ts, not a rewrite of this
// page. "Year" is the "EST. 2024"–"EST. 2027" print on the design itself —
// added 2026-08-14 alongside color as a second selector; title/tagline no
// longer bake in a specific year since that's now user-selectable (the card
// title updates client-side to match — see data-shirt-title in the client
// script below).
const SHIRT_DESIGN_INFO: Record<string, { title: string; tagline: string }> = {
  "dad-est": {
    title: "DAD EST.",
    tagline: `A clean "DAD EST." chest hit up front — pick your year — the DUDELA fist-bump wordmark across the back.`,
  },
};
const SHIRT_COLOR_ORDER = ["black", "ivory"];
const DEFAULT_SHIRT_YEAR = "2026";

const shirtDesignKeys = [...new Set(SHIRT_CATALOG.map((v) => v.design))];
const shirtDesigns = shirtDesignKeys.map((dkey) => {
  const variants = SHIRT_CATALOG.filter((v) => v.design === dkey);
  const colors = SHIRT_COLOR_ORDER.filter((c) => variants.some((v) => v.color === c)).map((c) => {
    const sample = variants.find((v) => v.color === c)!;
    return { key: c, label: sample.colorLabel, hex: sample.colorHex };
  });
  const years = SHIRT_YEARS.filter((y) => variants.some((v) => v.year === y));

  const clientVariants = variants.map((v) => ({
    key: v.key,
    color: v.color,
    colorLabel: v.colorLabel,
    colorHex: v.colorHex,
    year: v.year,
    size: v.size,
    front: v.frontImage,
    back: v.backImage,
    logoDetail: v.logoDetailImage,
    price: v.price,
  }));

  const first =
    clientVariants.find((v) => v.color === colors[0]?.key && v.year === DEFAULT_SHIRT_YEAR && v.size === "M") ||
    clientVariants.find((v) => v.color === colors[0]?.key && v.size === "M") ||
    clientVariants[0];

  const info = SHIRT_DESIGN_INFO[dkey] || { title: dkey, tagline: "" };

  return {
    key: dkey,
    title: info.title,
    tagline: info.tagline,
    colors,
    years,
    sizes: variants.map((v) => v.size).filter((s, i, arr) => arr.indexOf(s) === i),
    variants: clientVariants,
    first,
  };
});

const url = new URL(Astro.request.url);
const canceled = url.searchParams.get("purchase") === "canceled";
---
<BaseLayout title="Dudela Merch — Hats & Shirts" description="Hats and shirts, made to order and shipped straight to your door. Free shipping.">
  <Nav isAuthed={!!member} />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Merch</p>
      <h1>Dudela gear.</h1>
      <p class="hero-sub">
        Hats and shirts, made to order and shipped straight to your door. Free shipping, no
        restocks to wait on.
      </p>

      <div class="product-nav" role="group" aria-label="Jump to product">
        <a href="#shirts" class="product-nav-link">Shirts — $40</a>
        <a href="#hats" class="product-nav-link">Hats — from $38</a>
      </div>
      <p class="bundle-hint">Get a hat and a shirt together and we knock {BUNDLE_DISCOUNT_PERCENT}% off each — no code needed, it shows up automatically once you've picked both.</p>

      {!member && (
        <p class="login-nudge">
          Already a Spit-Up Society member? <a href="/member/login">Log in first</a> so this
          purchase shows up in your billing portal too.
        </p>
      )}

      {canceled && (
        <p class="notice">Checkout was canceled — nothing was charged. Pick your gear below whenever you're ready.</p>
      )}
    </div>
  </section>

  <section id="shirts" class="colors section-light shirts-section">
    <div class="container">
      <div class="section-divider">
        <h2>The Dudela shirt.</h2>
        <p class="section-sub">Comfort Colors heavyweight tee — front chest hit, full back print. $40, free shipping, made to order.</p>
      </div>
      <div class="colors-grid">
        {shirtDesigns.map((d) => (
          <div class="design-card shirt-card" data-design={d.key}>
            <div class="design-media">
              <div class="mockup-pair">
                <img class="mockup-photo" data-photo-front src={d.first.front} alt={`Dudela Shirt — ${d.title}, front`} />
                <img class="mockup-photo" data-photo-back src={d.first.back} alt={`Dudela Shirt — ${d.title}, back`} />
              </div>
            </div>
            <div class="design-body">
              <h3 data-shirt-title>{d.title} {d.first.year}</h3>
              <p class="design-tagline">{d.tagline}</p>

              <div class="selector">
                <span class="selector-label">Color</span>
                <div class="color-swatches" role="group" aria-label={`${d.title} color`} data-shirt-colors>
                  {d.colors.map((c) => (
                    <button
                      type="button"
                      class={`swatch${c.key === d.first.color ? " active" : ""}`}
                      style={`--swatch: ${c.hex}; --swatch2: ${c.hex}`}
                      title={c.label}
                      aria-label={c.label}
                      data-shirt-color={c.key}
                    />
                  ))}
                </div>
              </div>

              <div class="selector">
                <span class="selector-label">Year</span>
                <div class="year-options" role="group" aria-label={`${d.title} year`} data-shirt-years>
                  {d.years.map((y) => (
                    <button type="button" class={`year-btn${y === d.first.year ? " active" : ""}`} data-shirt-year={y}>&apos;{y.slice(2)}</button>
                  ))}
                </div>
              </div>

              <div class="selector">
                <span class="selector-label">Size</span>
                <div class="size-options" role="group" aria-label={`${d.title} size`} data-shirt-sizes>
                  {d.sizes.map((s) => (
                    <button type="button" class={`size-btn${s === d.first.size ? " active" : ""}`} data-shirt-size={s}>{s}</button>
                  ))}
                </div>
              </div>

              <div class="color-meta">
                <span class="price" data-price>${Math.round(parseFloat(d.first.price))}</span>
                <span class="variant-name" data-variant-name>{d.first.colorLabel}, {d.first.year}, {d.first.size}</span>
              </div>
              <a href={`/api/create-checkout-session?product=${d.first.key}`} class="btn btn-primary" data-buy>
                Buy Now — ${Math.round(parseFloat(d.first.price))}
              </a>

              <div class="detail-links">
                <button type="button" class="detail-chip" data-open-details="shirt">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.25"/>
                    <line x1="8" y1="7.2" x2="8" y2="11"/>
                    <circle cx="8" cy="4.9" r="0.9" fill="currentColor" stroke="none"/>
                  </svg>
                  Material, fit &amp; sizing
                </button>
                <div class="logo-detail" data-logo-detail-wrap>
                  <button type="button" class="detail-chip" data-logo-detail-toggle aria-expanded="false">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                      <circle cx="6.8" cy="6.8" r="4.3"/>
                      <line x1="10.1" y1="10.1" x2="14" y2="14"/>
                    </svg>
                    See the design up close
                  </button>
                  <div class="logo-detail-popover" data-logo-detail-popover hidden>
                    <img class="logo-detail-img" data-logo-detail src={d.first.logoDetail} alt={`${d.title} ${d.first.year} logo, up close`} />
                  </div>
                </div>
              </div>
            </div>

            <script type="application/json" data-shirt-catalog set:html={JSON.stringify(d)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="hats" class="colors section-light hats-section">
    <div class="container">
      <div class="section-divider">
        <h2>The Dudela hat.</h2>
        <p class="section-sub">Two designs, three thread colors, a cap color to match, and an optional "Dude to Dad" side stitch — $38, free shipping.</p>
      </div>
      <div class="colors-grid">
      {designs.map((d) => (
        <div class="design-card" data-design={d.key}>
          <div class="design-media">
            <div class="mockup-pair">
              <img class="mockup-photo" data-photo-front src={d.first.front} alt={`Dudela Hat — ${d.title}, front`} />
              <img class="mockup-photo" data-photo-left src={d.first.left} alt={`Dudela Hat — ${d.title}, angled left`} />
            </div>
          </div>
          <div class="design-body">
            <h3>{d.title}</h3>
            <p class="design-tagline">{d.tagline}</p>

            <div class="selector">
              <span class="selector-label">Thread color</span>
              <div class="thread-swatches" role="group" aria-label={`${d.title} thread color`} data-thread-swatches>
                {d.threads.map((t, i) => (
                  <button
                    type="button"
                    class={`thread-swatch${i === 0 ? " active" : ""}`}
                    style={`--swatch: ${t.hex}`}
                    title={t.label}
                    aria-label={t.label}
                    data-thread={t.key}
                  />
                ))}
              </div>
            </div>

            <div class="selector">
              <span class="selector-label">Cap color</span>
              <div class="color-swatches" role="group" aria-label={`${d.title} cap color`} data-color-swatches></div>
            </div>

            <button type="button" class="addon-toggle" data-addon-toggle aria-pressed="false">
              <span class="addon-toggle-switch" aria-hidden="true"></span>
              <span class="addon-toggle-text">
                <span class="addon-toggle-title">+ "Dude to Dad" stitch <span class="addon-toggle-price">+$1</span></span>
                <span class="addon-toggle-sub">A little extra flex on the side — proof you made the leap.</span>
              </span>
            </button>

            <div class="color-meta">
              <span class="price" data-price>{d.first.addon ? "$39" : "$38"}</span>
              <span class="variant-name" data-variant-name>{d.first.colorLabel}</span>
            </div>
            <a href={`/api/create-checkout-session?product=${d.first.key}`} class="btn btn-primary" data-buy>
              Buy Now — {d.first.addon ? "$39" : "$38"}
            </a>

            <div class="detail-links">
              <button type="button" class="detail-chip" data-open-details="hat">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                  <circle cx="8" cy="8" r="6.25"/>
                  <line x1="8" y1="7.2" x2="8" y2="11"/>
                  <circle cx="8" cy="4.9" r="0.9" fill="currentColor" stroke="none"/>
                </svg>
                Material &amp; fit
              </button>
            </div>
          </div>

          <script type="application/json" data-catalog set:html={JSON.stringify(d)} />
        </div>
      ))}
      </div>
    </div>
  </section>

  <!-- Product Details & Sizing — one shared dialog for both product types
       rather than one per card, since the specs are the same across every
       hat design (all Otto Cap 31-069) and every shirt design (all Comfort
       Colors 1717). All figures below are Printful's own catalog data for
       these exact products, not marketing copy — pulled from their public
       Catalog API, not written up ourselves. -->
  <dialog id="details-modal" class="details-modal">
    <button type="button" class="details-close" data-details-close aria-label="Close">&times;</button>

    <div class="details-panel" data-panel="hat">
      <h3>The Dudela hat</h3>
      <p class="details-sub">5-panel mid-profile cap, Otto Cap 31-069.</p>
      <dl class="details-list">
        <div><dt>Material</dt><dd>65% polyester / 35% cotton — a structured, breathable blend, not a soft-crown dad hat.</dd></div>
        <div><dt>Fit</dt><dd>One size fits most. Adjustable snap closure in back.</dd></div>
        <div><dt>Details</dt><dd>Structured front panel, matching undervisor and sweatband.</dd></div>
      </dl>
    </div>

    <div class="details-panel" data-panel="shirt">
      <h3>The Dudela shirt</h3>
      <p class="details-sub">Comfort Colors 1717 heavyweight tee.</p>
      <dl class="details-list">
        <div><dt>Material</dt><dd>100% ring-spun cotton, garment-dyed, 6.1 oz/yd² — heavier and sturdier than a standard cotton tee.</dd></div>
        <div><dt>Fit</dt><dd>Relaxed fit. Runs true to size.</dd></div>
        <div><dt>Details</dt><dd>Twill-taped neck and shoulders, double-needle stitching at the collar, armholes, sleeves, and hem for durability.</dd></div>
      </dl>
      <table class="size-table">
        <caption>Size chart (inches)</caption>
        <thead>
          <tr><th>Size</th><th>Length</th><th>Chest</th><th>Sleeve</th></tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>26.6</td><td>18.3</td><td>16.3</td></tr>
          <tr><td>M</td><td>28</td><td>20.3</td><td>17.8</td></tr>
          <tr><td>L</td><td>29.4</td><td>22</td><td>19</td></tr>
          <tr><td>XL</td><td>30.8</td><td>24</td><td>20.5</td></tr>
          <tr><td>2XL</td><td>31.6</td><td>26</td><td>21.8</td></tr>
          <tr><td>3XL</td><td>32.5</td><td>27.8</td><td>23.3</td></tr>
          <tr><td>4XL</td><td>33.5</td><td>29.8</td><td>24.6</td></tr>
        </tbody>
      </table>
      <p class="size-note">Measured flat, product may vary up to 2".</p>
    </div>
  </dialog>

  <section class="perks section-dark">
    <div class="container perks-grid">
      <div>
        <span class="perk-index">01</span>
        <h3>Free shipping</h3>
        <p>No shipping fees, no minimums, on hats or shirts. Just your gear, straight to your door.</p>
      </div>
      <div>
        <span class="perk-index">02</span>
        <h3>Made to order</h3>
        <p>Every piece is made when you order it — no waiting on restocks, no "sold out."</p>
      </div>
      <div>
        <span class="perk-index">03</span>
        <h3>Tag us when it lands</h3>
        <p>
          When your gear shows up, tag <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">@the_dudela_official</a>
          — we repost our favorites.
        </p>
      </div>
    </div>
  </section>

  <!-- Live Bundle bar — reflects whatever hat + shirt variant the cards
       above currently have selected (see updateBundleBar() in the script
       below). Starts hidden and gets an is-visible class the first time
       both a hat and a shirt selection exist, which in practice is
       immediately on load since both sections default to a real variant.

       On mobile it can also be is-collapsed — the full bar took up a real
       chunk of a small screen at all times. Collapsed keeps just the label,
       live price, and a toggle; the thumbnails/picks detail/Buy button
       tuck away. The toggle button itself only exists so there's an
       explicit, obvious way to dismiss/reopen it — see the script below
       for the auto-expand-then-settle behavior that also helps make it
       clear that picking options above is what's changing this. -->
  <div class="bundle-bar" id="bundle-bar" role="region" aria-label="Bundle discount">
    <div class="bundle-bar-inner">
      <div class="bundle-bar-items">
        <img class="bundle-bar-thumb" data-bar-hat-img alt="" />
        <span class="bundle-bar-plus">+</span>
        <img class="bundle-bar-thumb" data-bar-shirt-img alt="" />
        <div class="bundle-bar-text">
          <span class="bundle-bar-label">Get both, save {BUNDLE_DISCOUNT_PERCENT}%</span>
          <span class="bundle-bar-picks" data-bar-picks></span>
        </div>
      </div>
      <div class="bundle-bar-right">
        <div class="bundle-bar-price">
          <span class="bundle-bar-was" data-bar-was></span>
          <span class="bundle-bar-now" data-bar-now></span>
        </div>
        <a href="/api/create-checkout-session?product=bundle" class="btn btn-primary bundle-bar-buy" data-bar-buy>
          Buy the Bundle
        </a>
        <button
          type="button"
          class="bundle-bar-toggle"
          data-bar-toggle
          aria-expanded="true"
          aria-label="Minimize bundle bar"
        >
          <span data-bar-toggle-icon aria-hidden="true">▾</span>
        </button>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  // Vanilla JS, no framework — matches the rest of the site. Each design card
  // gets its own small catalog (embedded as JSON at build time, see
  // `data-catalog` above) of every real (thread, cap color, add-on) variant
  // Printful actually has built, plus that variant's two real mockup photos
  // and its checkout key. Three controls read/write one piece of state per
  // card — thread, color, add-on — and any change re-resolves to the exact
  // matching variant and updates the photos, label, and buy link.
  //
  // Thread and cap color are NOT a full cross product (e.g. no cap ships in
  // Black cap + Black thread — the stitching wouldn't show up), so the cap
  // color swatches are rebuilt from only the colors that actually exist for
  // the currently selected thread every time the thread changes. The add-on
  // toggle doesn't affect which colors are available — every (thread, color)
  // pair exists in both add-on states — so it's a simple independent switch.

  // Live Bundle bar (fixed to the bottom of the screen, markup near the end
  // of the page body) — mirrors whichever hat + shirt variant these two
  // sections currently have selected, so there's no separate/duplicate
  // bundle picker anywhere on the page. REWRITTEN 2026-08-13: the old bundle
  // section had its own two <select> dropdowns, which could disagree with
  // whatever was actually picked in the cards below — confusing. Now the
  // cards themselves are the only source of truth; currentHat/currentShirt
  // just track the latest one, and updateBundleBar() repaints the bar
  // whenever either changes.
  interface BundleSelection {
    key: string;
    label: string;
    price: number;
    addon: boolean;
    image: string;
  }
  let currentHat: BundleSelection | null = null;
  let currentShirt: BundleSelection | null = null;

  // Keep in sync with BUNDLE_DISCOUNT_PERCENT in this page's frontmatter and
  // in api/create-checkout-session.ts (the actual source of truth for the
  // charge) — this copy only drives the bar's live price preview.
  const BUNDLE_DISCOUNT_PERCENT = 15;

  const bundleBar = document.getElementById("bundle-bar");
  const barHatImg = bundleBar?.querySelector<HTMLImageElement>("[data-bar-hat-img]");
  const barShirtImg = bundleBar?.querySelector<HTMLImageElement>("[data-bar-shirt-img]");
  const barPicks = bundleBar?.querySelector<HTMLElement>("[data-bar-picks]");
  const barWas = bundleBar?.querySelector<HTMLElement>("[data-bar-was]");
  const barNow = bundleBar?.querySelector<HTMLElement>("[data-bar-now]");
  const barBuy = bundleBar?.querySelector<HTMLAnchorElement>("[data-bar-buy]");
  const barToggle = bundleBar?.querySelector<HTMLButtonElement>("[data-bar-toggle]");
  const barToggleIcon = bundleBar?.querySelector<HTMLElement>("[data-bar-toggle-icon]");

  // Collapse/expand only really matters on mobile — on desktop the bar is a
  // slim single row already, nothing to minimize. is-collapsed is purely a
  // CSS switch (see the mobile media query below); this JS just decides
  // when to flip it.
  const isMobile = () => window.matchMedia("(max-width: 640px)").matches;
  let userHasToggledManually = false;
  let autoCollapseTimer: number | undefined;

  function setBarCollapsed(collapsed: boolean) {
    if (!bundleBar || !barToggle) return;
    bundleBar.classList.toggle("is-collapsed", collapsed);
    barToggle.setAttribute("aria-expanded", String(!collapsed));
    barToggle.setAttribute("aria-label", collapsed ? "Show bundle details" : "Minimize bundle bar");
    if (barToggleIcon) barToggleIcon.textContent = collapsed ? "▴" : "▾";
  }

  barToggle?.addEventListener("click", () => {
    // Once someone has touched this control, their choice sticks — stop
    // auto-expanding/collapsing on future updates. Forcing it back open
    // right after someone deliberately minimized it would defeat the
    // entire point of giving them a dismiss button.
    userHasToggledManually = true;
    if (autoCollapseTimer) window.clearTimeout(autoCollapseTimer);
    setBarCollapsed(!bundleBar!.classList.contains("is-collapsed"));
  });

  // One-time "flare" — a brief bounce + glow on the collapsed pill — the
  // first time someone scrolls far enough to plausibly be browsing
  // products. Starting collapsed from the very first paint means nothing
  // ever announces the bar exists on its own, so this is what invites a
  // visitor to tap it open and notice their picks populating inside.
  // Fires once; does nothing once the visitor has taken manual control of
  // the toggle or the bar is already open.
  let hasFlared = false;
  function maybeFlareOnScroll() {
    if (hasFlared || !bundleBar || userHasToggledManually) return;
    if (!isMobile() || !bundleBar.classList.contains("is-collapsed")) return;
    if (window.scrollY < 350) return;
    hasFlared = true;
    window.removeEventListener("scroll", maybeFlareOnScroll);
    bundleBar.classList.add("is-flaring");
    // Matches the two 0.9s iterations in the is-flaring animation (1.8s)
    // plus a hair of margin so the class isn't yanked mid-animation.
    window.setTimeout(() => bundleBar?.classList.remove("is-flaring"), 1900);
  }
  window.addEventListener("scroll", maybeFlareOnScroll, { passive: true });

  function updateBundleBar() {
    if (!bundleBar || !currentHat || !currentShirt) return;
    if (barHatImg) {
      barHatImg.src = currentHat.image;
      barHatImg.alt = currentHat.label;
    }
    if (barShirtImg) {
      barShirtImg.src = currentShirt.image;
      barShirtImg.alt = currentShirt.label;
    }
    if (barPicks) barPicks.textContent = `${currentHat.label} + ${currentShirt.label}`;

    const discountMultiplier = 1 - BUNDLE_DISCOUNT_PERCENT / 100;
    // The $1 add-on surcharge isn't discounted server-side either (see
    // handleBundleCheckout in create-checkout-session.ts) — kept flat here
    // to match.
    const addonSurcharge = currentHat.addon ? 1 : 0;
    const fullTotal = currentHat.price + addonSurcharge + currentShirt.price;
    const discountedTotal =
      currentHat.price * discountMultiplier + addonSurcharge + currentShirt.price * discountMultiplier;

    if (barWas) barWas.textContent = `$${fullTotal.toFixed(2)}`;
    if (barNow) barNow.textContent = `$${discountedTotal.toFixed(2)}`;
    if (barBuy) {
      barBuy.href = `/api/create-checkout-session?product=bundle&hat=${encodeURIComponent(currentHat.key)}&shirt=${encodeURIComponent(currentShirt.key)}`;
    }

    // The very first call (page load, both sections still at their default
    // picks) just brings the bar on screen — no pulse needed there. Every
    // call after that means an actual selection changed, so flash the bar
    // to make that connection obvious (otherwise a swatch click below just
    // silently rewrites text at the bottom of the screen with nothing to
    // draw the eye to it).
    const wasAlreadyVisible = bundleBar.classList.contains("is-visible");
    bundleBar.classList.add("is-visible");
    if (wasAlreadyVisible) {
      bundleBar.classList.remove("is-updated");
      void bundleBar.offsetWidth; // force reflow so the animation restarts on rapid re-clicks
      bundleBar.classList.add("is-updated");
    }

    // Mobile-only. Skipped entirely once the visitor has taken manual
    // control of the toggle.
    if (isMobile() && !userHasToggledManually) {
      if (!wasAlreadyVisible) {
        // First appearance: start collapsed right away rather than
        // showing the full bar and taking up space nobody asked for yet —
        // maybeFlareOnScroll() above is what invites someone to open it.
        setBarCollapsed(true);
      } else {
        // A real selection changed — pop open briefly to show it (with the
        // flash/price-bump pulse above), then settle back down.
        setBarCollapsed(false);
        if (autoCollapseTimer) window.clearTimeout(autoCollapseTimer);
        autoCollapseTimer = window.setTimeout(() => {
          if (!userHasToggledManually) setBarCollapsed(true);
        }, 2500);
      }
    }
  }

  interface CardVariant {
    key: string;
    thread: string;
    color: string;
    colorLabel: string;
    colorHex: string;
    colorHex2: string;
    addon: boolean;
    front: string;
    left: string;
  }
  interface CardCatalog {
    title: string;
    threads: Array<{ key: string; label: string; hex: string }>;
    variants: CardVariant[];
  }

  // :not(.shirt-card) matters here — shirt cards also carry the
  // .design-card class (class="design-card shirt-card"), so a plain
  // ".design-card" selector counted the shirt card as index 0 and pushed
  // both hat cards to index >= 1. That meant isDefaultForBundle was false
  // for every hat card, currentHat never got set on load, and the bundle
  // bar's is-visible class never got added — the bug that made the whole
  // bar silently never appear.
  document.querySelectorAll<HTMLElement>(".design-card:not(.shirt-card)").forEach((card, cardIndex) => {
    const catalogScript = card.querySelector<HTMLScriptElement>("[data-catalog]");
    if (!catalogScript?.textContent) return;
    const catalog: CardCatalog = JSON.parse(catalogScript.textContent);

    // Which hat design "counts" for the bundle bar: the first design card
    // (Classic — the hero design) publishes its selection by default on
    // load; whichever hat card the visitor actually interacts with takes
    // over from then on, so the bar always tracks the last thing you
    // actually touched instead of silently reverting to Classic.
    const isDefaultForBundle = cardIndex === 0;
    let userInteracted = false;

    const photoFront = card.querySelector<HTMLImageElement>("[data-photo-front]");
    const photoLeft = card.querySelector<HTMLImageElement>("[data-photo-left]");
    const threadButtons = card.querySelectorAll<HTMLButtonElement>("[data-thread]");
    const colorContainer = card.querySelector<HTMLElement>("[data-color-swatches]");
    const addonToggle = card.querySelector<HTMLButtonElement>("[data-addon-toggle]");
    const variantName = card.querySelector<HTMLElement>("[data-variant-name]");
    const priceEl = card.querySelector<HTMLElement>("[data-price]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    if (!photoFront || !photoLeft || !colorContainer || !addonToggle || !variantName || !priceEl || !buyBtn) return;

    // Preload every real mockup photo for this card up front so swapping
    // thread/color/add-on never shows a half-loaded image or a network
    // delay — same instant-swap feel as the old single-image pair picker.
    catalog.variants.forEach((v) => {
      new Image().src = v.front;
      new Image().src = v.left;
    });

    const state = { thread: catalog.threads[0]?.key || "", color: "", addon: false };

    function variantsForThread(thread: string) {
      return catalog.variants.filter((v) => v.thread === thread);
    }

    function renderColorSwatches() {
      if (!colorContainer) return;
      colorContainer.innerHTML = "";
      const seen = new Set<string>();
      for (const v of variantsForThread(state.thread)) {
        if (seen.has(v.color)) continue;
        seen.add(v.color);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "swatch" + (v.color === state.color ? " active" : "");
        btn.style.setProperty("--swatch", v.colorHex);
        btn.style.setProperty("--swatch2", v.colorHex2);
        btn.title = v.colorLabel;
        btn.setAttribute("aria-label", v.colorLabel);
        btn.addEventListener("click", () => {
          if (state.color === v.color) return;
          userInteracted = true;
          state.color = v.color;
          render();
        });
        colorContainer.appendChild(btn);
      }
    }

    function currentVariant(): CardVariant | undefined {
      return catalog.variants.find(
        (v) => v.thread === state.thread && v.color === state.color && v.addon === state.addon
      );
    }

    function render() {
      const avail = variantsForThread(state.thread);
      if (!avail.some((v) => v.color === state.color)) {
        state.color = avail[0]?.color || "";
      }

      threadButtons.forEach((b) => b.classList.toggle("active", b.dataset.thread === state.thread));
      renderColorSwatches();

      const variant = currentVariant();
      if (!variant || !photoFront || !photoLeft || !variantName || !priceEl || !buyBtn) return;

      photoFront.classList.add("is-swapping");
      photoLeft.classList.add("is-swapping");
      window.setTimeout(() => {
        photoFront.src = variant.front;
        photoFront.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, front`;
        photoLeft.src = variant.left;
        photoLeft.alt = `Dudela Hat — ${catalog.title}, ${variant.colorLabel}, angled left`;
        photoFront.classList.remove("is-swapping");
        photoLeft.classList.remove("is-swapping");
        // The add-on's side stitch is small in a full-hat shot — zoom the
        // angled photo in on it when the add-on is selected so it's actually
        // legible, instead of a barely-visible detail off to the side.
        photoLeft.classList.toggle("is-addon-zoom", variant.addon);
      }, 120);

      variantName.textContent = variant.colorLabel;
      const priceLabel = variant.addon ? "$39" : "$38";
      priceEl.textContent = priceLabel;
      buyBtn.textContent = `Buy Now — ${priceLabel}`;
      buyBtn.href = `/api/create-checkout-session?product=${variant.key}`;

      if (isDefaultForBundle || userInteracted) {
        // Base hat price is a flat $38 across every real variant (see
        // HAT_CATALOG in lib/printful.ts) — the add-on is tracked
        // separately as its own $1 surcharge, same split the server uses.
        currentHat = {
          key: variant.key,
          label: `${catalog.title} — ${variant.colorLabel}`,
          price: 38,
          addon: variant.addon,
          image: variant.front,
        };
        updateBundleBar();
      }
    }

    threadButtons.forEach((b) => {
      b.addEventListener("click", () => {
        if (b.dataset.thread === state.thread) return;
        userInteracted = true;
        state.thread = b.dataset.thread || state.thread;
        render();
      });
    });

    addonToggle.addEventListener("click", () => {
      userInteracted = true;
      state.addon = !state.addon;
      addonToggle.setAttribute("aria-pressed", String(state.addon));
      addonToggle.classList.toggle("active", state.addon);
      render();
    });

    // Prefer the hero colorway (Dark Green/Natural bill) as the starting
    // color for whichever thread ends up default — falls back to the first
    // available color if this design/thread doesn't offer it.
    const DEFAULT_COLOR_SLUG = "dark-green-natural";
    const startingOptions = variantsForThread(state.thread).filter((v) => v.addon === state.addon);
    state.color = (startingOptions.find((v) => v.color === DEFAULT_COLOR_SLUG) || startingOptions[0])?.color || "";
    render();
  });

  // Shirt cards — same pattern as hat cards above but simpler: color, year,
  // and size are a full cross product (no filtering), no add-on, and the
  // two mockup photos are front/back instead of front/angled-left.
  interface ShirtCardVariant {
    key: string;
    color: string;
    colorLabel: string;
    colorHex: string;
    year: string;
    size: string;
    front: string;
    back: string;
    logoDetail: string;
    price: string;
  }
  interface ShirtCardCatalog {
    title: string;
    colors: Array<{ key: string; label: string; hex: string }>;
    years: string[];
    sizes: string[];
    variants: ShirtCardVariant[];
  }

  // Closes any open logo-detail popover across every shirt card — one set
  // of global listeners rather than one per card (see the click handler
  // inside the forEach below).
  function closeAllLogoPopovers() {
    document.querySelectorAll<HTMLElement>("[data-logo-detail-popover]").forEach((el) => {
      el.hidden = true;
    });
    document.querySelectorAll<HTMLButtonElement>("[data-logo-detail-toggle]").forEach((el) => {
      el.setAttribute("aria-expanded", "false");
    });
  }
  document.addEventListener("click", closeAllLogoPopovers);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAllLogoPopovers();
  });

  document.querySelectorAll<HTMLElement>(".shirt-card").forEach((card) => {
    const catalogScript = card.querySelector<HTMLScriptElement>("[data-shirt-catalog]");
    if (!catalogScript?.textContent) return;
    const catalog: ShirtCardCatalog = JSON.parse(catalogScript.textContent);

    const photoFront = card.querySelector<HTMLImageElement>("[data-photo-front]");
    const photoBack = card.querySelector<HTMLImageElement>("[data-photo-back]");
    const logoDetailImg = card.querySelector<HTMLImageElement>("[data-logo-detail]");
    const logoDetailToggle = card.querySelector<HTMLButtonElement>("[data-logo-detail-toggle]");
    const logoDetailPopover = card.querySelector<HTMLElement>("[data-logo-detail-popover]");
    const titleEl = card.querySelector<HTMLElement>("[data-shirt-title]");
    const yearContainer = card.querySelector<HTMLElement>("[data-shirt-years]");
    const colorContainer = card.querySelector<HTMLElement>("[data-shirt-colors]");
    const sizeContainer = card.querySelector<HTMLElement>("[data-shirt-sizes]");
    const variantName = card.querySelector<HTMLElement>("[data-variant-name]");
    const priceEl = card.querySelector<HTMLElement>("[data-price]");
    const buyBtn = card.querySelector<HTMLAnchorElement>("[data-buy]");
    if (!photoFront || !photoBack || !yearContainer || !colorContainer || !sizeContainer || !variantName || !priceEl || !buyBtn) return;

    // Logo-close-up popover — was a thumbnail permanently sitting in the
    // card whether anyone wanted it or not; now it's collapsed behind a
    // small link and only appears on demand. Closing (outside click /
    // Escape) is handled once, globally, below — not per card — so this
    // doesn't stack up duplicate document listeners if a second shirt
    // design is ever added.
    if (logoDetailToggle && logoDetailPopover) {
      logoDetailToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !logoDetailPopover.hidden;
        closeAllLogoPopovers();
        if (!isOpen) {
          logoDetailPopover.hidden = false;
          logoDetailToggle.setAttribute("aria-expanded", "true");
        }
      });
    }

    catalog.variants.forEach((v) => {
      new Image().src = v.front;
      new Image().src = v.back;
      new Image().src = v.logoDetail;
    });

    const DEFAULT_SHIRT_YEAR = "2026";
    const state = {
      color: catalog.colors[0]?.key || "",
      year: catalog.years.includes(DEFAULT_SHIRT_YEAR) ? DEFAULT_SHIRT_YEAR : catalog.years[0] || "",
      size: "M",
    };

    function currentVariant(): ShirtCardVariant | undefined {
      return catalog.variants.find(
        (v) => v.color === state.color && v.year === state.year && v.size === state.size
      );
    }

    function render() {
      yearContainer!.querySelectorAll<HTMLButtonElement>("[data-shirt-year]").forEach((b) => {
        b.classList.toggle("active", b.dataset.shirtYear === state.year);
      });
      colorContainer!.querySelectorAll<HTMLButtonElement>("[data-shirt-color]").forEach((b) => {
        b.classList.toggle("active", b.dataset.shirtColor === state.color);
      });
      sizeContainer!.querySelectorAll<HTMLButtonElement>("[data-shirt-size]").forEach((b) => {
        b.classList.toggle("active", b.dataset.shirtSize === state.size);
      });

      const variant = currentVariant();
      if (!variant || !photoFront || !photoBack || !variantName || !priceEl || !buyBtn) return;

      photoFront.classList.add("is-swapping");
      photoBack.classList.add("is-swapping");
      window.setTimeout(() => {
        photoFront.src = variant.front;
        photoFront.alt = `Dudela Shirt — ${catalog.title} ${variant.year}, ${variant.colorLabel}, front`;
        photoBack.src = variant.back;
        photoBack.alt = `Dudela Shirt — ${catalog.title} ${variant.year}, ${variant.colorLabel}, back`;
        photoFront.classList.remove("is-swapping");
        photoBack.classList.remove("is-swapping");
        if (logoDetailImg) {
          logoDetailImg.src = variant.logoDetail;
          logoDetailImg.alt = `${catalog.title} ${variant.year} logo, up close, ${variant.colorLabel}`;
        }
      }, 120);

      if (titleEl) titleEl.textContent = `${catalog.title} ${variant.year}`;
      variantName.textContent = `${variant.colorLabel}, ${variant.year}, ${variant.size}`;
      const priceLabel = `$${Math.round(parseFloat(variant.price))}`;
      priceEl.textContent = priceLabel;
      buyBtn.textContent = `Buy Now — ${priceLabel}`;
      buyBtn.href = `/api/create-checkout-session?product=${variant.key}`;

      // Only one shirt design exists today, so this always publishes — if a
      // second design is ever added, this'll need the same
      // isDefaultForBundle/userInteracted split the hat cards use above.
      currentShirt = {
        key: variant.key,
        label: `${catalog.title} ${variant.year} — ${variant.colorLabel}, ${variant.size}`,
        price: parseFloat(variant.price),
        addon: false,
        image: variant.front,
      };
      updateBundleBar();
    }

    yearContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-shirt-year]");
      if (!btn) return;
      state.year = btn.dataset.shirtYear || state.year;
      render();
    });

    colorContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-shirt-color]");
      if (!btn) return;
      state.color = btn.dataset.shirtColor || state.color;
      render();
    });

    sizeContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-shirt-size]");
      if (!btn) return;
      state.size = btn.dataset.shirtSize || state.size;
      render();
    });

    render();
  });

  // Product Details & Sizing modal — one shared <dialog>, content switched
  // by adding data-type="hat"|"shirt" to it (see the matching CSS below,
  // which shows/hides the two .details-panel blocks accordingly).
  (() => {
    const modal = document.getElementById("details-modal") as HTMLDialogElement | null;
    if (!modal) return;

    document.querySelectorAll<HTMLButtonElement>("[data-open-details]").forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.dataset.type = btn.dataset.openDetails || "hat";
        modal.showModal();
      });
    });

    modal.querySelector("[data-details-close]")?.addEventListener("click", () => modal.close());

    // Click on the backdrop (outside the modal's own padded box) closes it —
    // clicking the modal element itself fires for both the box and the
    // ::backdrop, so this checks the click actually landed on the <dialog>
    // element rather than something inside it.
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });
  })();
</script>

<style>
  .hero {
    padding: 9rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 52ch;
  }
  .product-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .product-nav-link {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--amber-500);
    color: var(--amber-500);
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .product-nav-link:hover {
    background: var(--amber-500);
    color: var(--forest-900, #12180f);
  }
  .notice {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .login-nudge {
    margin-top: 1.25rem;
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    max-width: 52ch;
  }
  .login-nudge a {
    color: var(--amber-500);
    font-weight: 600;
  }
  .bundle-hint {
    margin-top: 1.1rem;
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    max-width: 48ch;
  }

  /* Live Bundle bar — fixed to the bottom of the viewport, mirrors whatever
     hat + shirt the cards below currently have selected. Stays out of the
     way (translated off-screen) until updateBundleBar() in the script above
     has real data to show, which in practice is immediately on load.
     z-index is CSS's actual maximum (2147483647) — originally set this high
     because the SpeakPipe voicemail widget (2147483645) could cover this
     bar's buy button on short/mobile viewports. That widget no longer loads
     on this page at all (BaseLayout's showVoicemailWidget prop now scopes
     it to /voicemail only), but there's no real cost to leaving this bar at
     the actual max — cheap insurance against the next thing that floats. */
  .bundle-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2147483647;
    background: var(--forest-900, #12180f);
    border-top: 1px solid var(--amber-500);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.25);
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }
  .bundle-bar.is-visible {
    transform: translateY(0);
  }
  /* A quick background flash + price bump + thumbnail fade whenever a
     selection actually changes (see the is-updated toggle in
     updateBundleBar()) — makes it obvious that clicking a swatch/size below
     is what just updated the bar, instead of it silently rewriting itself
     at the bottom of the screen. */
  @keyframes bundleBarFlash {
    0% {
      background: var(--forest-900, #12180f);
    }
    35% {
      background: #24361f;
    }
    100% {
      background: var(--forest-900, #12180f);
    }
  }
  @keyframes bundleBarPriceBump {
    0%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.18);
    }
  }
  @keyframes bundleBarThumbIn {
    0% {
      opacity: 0.25;
      transform: scale(0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  .bundle-bar.is-updated {
    animation: bundleBarFlash 0.6s ease;
  }
  .bundle-bar.is-updated .bundle-bar-now {
    display: inline-block;
    animation: bundleBarPriceBump 0.45s ease;
  }
  .bundle-bar.is-updated .bundle-bar-thumb {
    animation: bundleBarThumbIn 0.35s ease;
  }
  /* One-time "flare" (see maybeFlareOnScroll() in the script above) — a
     bounce + glow ring on the collapsed pill the first time someone
     scrolls far enough to plausibly be browsing products, since starting
     collapsed means nothing else announces the bar exists on its own. */
  @keyframes bundleBarFlareBounce {
    0%,
    100% {
      transform: translateY(0);
    }
    20% {
      transform: translateY(-7px);
    }
    40% {
      transform: translateY(0);
    }
    60% {
      transform: translateY(-4px);
    }
    80% {
      transform: translateY(0);
    }
  }
  @keyframes bundleBarFlareGlow {
    0%,
    100% {
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.25), 0 0 0 0 rgba(226, 125, 37, 0.55);
    }
    50% {
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.25), 0 0 0 10px rgba(226, 125, 37, 0);
    }
  }
  .bundle-bar.is-flaring {
    animation: bundleBarFlareBounce 0.9s ease 2, bundleBarFlareGlow 0.9s ease 2;
  }
  /* No .container here on purpose — a centered, fixed-max-width box left
     big empty margins on wide screens that made the bar feel like a
     floating chip rather than a single continuous piece of the page. Its
     own responsive padding stretches the real content close to both edges
     instead, so it reads as one seamless strip rather than something
     cropped in from the sides. */
  .bundle-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.85rem clamp(1rem, 4vw, 3rem);
  }
  .bundle-bar-items {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    flex: 1 1 auto;
  }
  .bundle-bar-thumb {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: var(--cream-100);
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    flex-shrink: 0;
  }
  .bundle-bar-plus {
    color: var(--text-on-dark-muted);
    font-weight: 700;
    flex-shrink: 0;
  }
  .bundle-bar-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .bundle-bar-label {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--amber-500);
  }
  /* Lets the full pick description wrap onto a second line instead of
     truncating with an ellipsis — a label cut off mid-word read as broken,
     not clean. */
  .bundle-bar-picks {
    display: block;
    color: var(--cream-100);
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .bundle-bar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  .bundle-bar-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .bundle-bar-was {
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
    text-decoration: line-through;
  }
  .bundle-bar-now {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--amber-500);
  }
  .bundle-bar-buy {
    white-space: nowrap;
    padding: 0.65rem 1.3rem;
  }
  /* Dismiss/minimize control — hidden on desktop, where the bar is already
     a single slim row with nothing worth collapsing. */
  .bundle-bar-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--cream-100);
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease;
  }
  .bundle-bar-toggle:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  @media (max-width: 640px) {
    .bundle-bar-inner {
      justify-content: center;
      text-align: center;
      transition: padding 0.2s ease;
    }
    .bundle-bar-items {
      flex: 1 1 100%;
      justify-content: center;
    }
    .bundle-bar-toggle {
      display: inline-flex;
    }
    /* Collapsed: down to one compact row — label, live price, and the
       toggle. Thumbnails, the full pick description, the struck-through
       "was" price, and the Buy button all tuck away until it's reopened,
       so the bar isn't permanently eating a chunk of a small screen. */
    .bundle-bar.is-collapsed .bundle-bar-inner {
      padding-top: 0.55rem;
      padding-bottom: 0.55rem;
      flex-wrap: nowrap;
      justify-content: space-between;
    }
    .bundle-bar.is-collapsed .bundle-bar-items {
      flex: 0 1 auto;
      justify-content: flex-start;
    }
    .bundle-bar.is-collapsed .bundle-bar-thumb,
    .bundle-bar.is-collapsed .bundle-bar-plus,
    .bundle-bar.is-collapsed .bundle-bar-picks,
    .bundle-bar.is-collapsed .bundle-bar-was,
    .bundle-bar.is-collapsed .bundle-bar-buy {
      display: none;
    }
    .bundle-bar.is-collapsed .bundle-bar-now {
      font-size: 1.1rem;
    }
    .bundle-bar.is-collapsed .bundle-bar-right {
      gap: 0.6rem;
    }
  }

  .colors {
    padding: var(--space-6) 0;
  }
  .colors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .design-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-light-raised);
    /* A flat 1px border on a light background reads thin/insubstantial on
       its own — the added shadow gives each card real physical weight
       without changing the border itself. */
    box-shadow: 0 1px 2px rgba(18, 24, 15, 0.04), 0 10px 28px rgba(18, 24, 15, 0.07);
  }
  .design-media {
    width: 100%;
    background: var(--cream-100);
    border-bottom: 1px solid var(--border-light);
  }
  /* Two real Printful mockup photos (front + a 3/4 angle showing the left
     side) shown side by side — same "two photos together" feel as the old
     pre-merged pair images, just as two <img>s instead of one baked PNG. */
  .mockup-pair {
    display: flex;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }
  .mockup-photo {
    width: 50%;
    height: 100%;
    object-fit: contain;
    background: var(--cream-100);
    opacity: 1;
    transform: scale(1);
    transform-origin: 50% 50%;
    transition: opacity 0.12s ease, transform 0.25s ease;
    cursor: zoom-in;
  }
  .mockup-photo.is-swapping {
    opacity: 0;
  }
  /* Hover-to-zoom for a closer look at the product — skipped while the
     add-on zoom below is already active on that image, so the two effects
     never fight over the transform. */
  .mockup-photo:hover:not(.is-addon-zoom) {
    transform: scale(1.35);
  }
  /* When the Dude² Dad add-on is selected, the angled (left) photo zooms in
     on the side stitch — a full-hat shot makes it too small to read
     otherwise. Origin is tuned to the add-on's fixed embroidery_left
     position, which is the same on every color/design. */
  .mockup-photo[data-photo-left].is-addon-zoom {
    transform: scale(1.8);
    transform-origin: 85% 55%;
  }
  /* A tight crop of the real chest-logo print file — collapsed behind a
     small icon chip by default (a persistent thumbnail sitting in every
     card whether or not anyone wanted it felt like clutter) and shown on
     demand as a popover anchored to the chip. Lives inside .detail-links
     at the bottom of the card now, alongside the Material/fit chip — see
     that block below. */
  .logo-detail {
    position: relative;
  }
  .logo-detail-popover {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 0;
    z-index: 5;
    padding: 0.6rem;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    box-shadow: 0 -12px 28px rgba(0, 0, 0, 0.18);
  }
  .logo-detail-img {
    display: block;
    width: 200px;
    height: auto;
    border-radius: 4px;
  }
  .design-tagline {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 1.1rem;
  }
  /* Small, muted icon+text row at the very bottom of the card — used to be
     two underlined text links sitting right under the tagline, competing
     with the actual selectors for attention before you'd even picked
     anything. Demoted to secondary, out of the way, after the buy button. */
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.9rem;
  }
  .detail-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--text-on-light-muted);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
  }
  .detail-chip svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .detail-chip:hover {
    color: var(--amber-500);
  }
  .selector {
    margin: 0 0 1.1rem;
  }
  .selector-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-on-light-muted);
    margin-bottom: 0.5rem;
  }
  .thread-swatches,
  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .thread-swatch,
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .thread-swatch {
    background: var(--swatch);
  }
  /* Cap-color swatches use a two-tone gradient dot for two-tone caps
     (e.g. Black crown / Natural mesh bill) so the swatch itself hints at
     what the cap actually looks like, not just a flat color guess. */
  .swatch {
    background: linear-gradient(135deg, var(--swatch) 50%, var(--swatch2) 50%);
  }
  .thread-swatch.active,
  .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }
  /* Add-on toggle — a real button (not a checkbox) styled as a small
     switch-card so it reads as its own product feature, not a form
     afterthought. .active is toggled by the client script above. */
  .addon-toggle {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    text-align: left;
    margin: 0 0 1.1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    background: var(--cream-100);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .addon-toggle:hover {
    border-color: var(--forest-800);
  }
  .addon-toggle.active {
    border-color: var(--forest-800);
    background: var(--bg-light-raised);
  }
  .addon-toggle-switch {
    flex: none;
    width: 2.15rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--border-light);
    position: relative;
    transition: background 0.15s ease;
  }
  .addon-toggle-switch::after {
    content: "";
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }
  .addon-toggle.active .addon-toggle-switch {
    background: var(--forest-800);
  }
  .addon-toggle.active .addon-toggle-switch::after {
    transform: translateX(0.9rem);
  }
  .addon-toggle-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .addon-toggle-title {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-on-light);
  }
  .addon-toggle-price {
    font-weight: 600;
    color: var(--forest-800);
    margin-left: 0.15rem;
  }
  .addon-toggle-sub {
    font-size: 0.78rem;
    color: var(--text-on-light-muted);
  }
  .color-name,
  .variant-name {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-on-light-muted);
  }
  .design-body {
    padding: 2rem 2.1rem 2.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .design-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
  }
  .color-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest-800);
  }
  .design-body .btn {
    width: 100%;
    text-align: center;
    margin-top: auto;
    box-shadow: 0 4px 12px rgba(18, 24, 15, 0.12);
  }

  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.75rem;
  }
  .perk-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--amber-500);
    display: block;
    margin-bottom: 0.5rem;
  }
  .perks-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .perks-grid p {
    color: var(--text-on-dark-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .perks-grid a {
    color: var(--amber-500);
    font-weight: 600;
  }

  /* Cards used to go 2-up here at 720px+, but that's what left a blank
     second column next to the lone shirt design (the grid still reserved
     the slot even with nothing to put in it). Now that each card lays
     itself out in a full-width row (see the 760px block just below) a
     single column is the right call regardless of how many designs are in
     a section — one shirt gets the full width with no empty gap, and two
     hats simply stack instead of squeezing into half-width columns that
     wouldn't leave room for the side-by-side layout to work. */

  /* Above ~760px there's room to put the photos and the buy panel side by
     side instead of stacking them — on a laptop screen the old stacked
     layout meant scrolling past a full-width image before any of the
     color/size/price/CTA info came into view, so nothing about a product
     was visible in one screen at once. Row layout fixes that: the whole
     card (photo + every control + the Buy button) fits in view together
     on typical desktop heights. Below 760px there usually isn't enough
     width left for the info column to stay readable once the photo takes
     its share, so it stays stacked (the original, still-correct
     mobile/tablet behavior). Placed after the base .design-card/
     .design-media/.design-body rules above so it wins the cascade instead
     of being overridden by them. */
  @media (min-width: 760px) {
    .design-card {
      flex-direction: row;
      align-items: stretch;
    }
    .design-media {
      width: 46%;
      flex-shrink: 0;
      border-bottom: none;
      border-right: 1px solid var(--border-light);
    }
    .design-body {
      width: 54%;
    }
  }

  /* Shirt section — reuses most .design-card/.colors-grid styling above;
     only new pieces are the section heading and the size-picker buttons
     (hats don't have a size selector). */
  /* Shirts now leads the page (right after the dark hero) so it keeps its
     normal top padding; hats — now second, directly after another
     .colors.section-light block — loses its top padding instead so the two
     light sections don't stack double spacing between them. */
  .hats-section {
    padding-top: 0;
  }
  .section-divider {
    max-width: 60ch;
    margin: 0 0 2.25rem;
  }
  .section-divider h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 0.6rem;
    color: var(--text-on-light);
  }
  .section-sub {
    color: var(--text-on-light-muted);
    margin: 0;
  }
  .size-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .size-btn {
    min-width: 2.5rem;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 2px solid var(--border-light);
    background: var(--bg-light-raised);
    color: var(--text-on-light);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .size-btn:hover {
    border-color: var(--forest-800);
  }
  .size-btn.active {
    border-color: var(--forest-800);
    background: var(--forest-800);
    color: var(--cream-100);
  }
  /* Year picker — deliberately NOT styled like .size-btn. Sitting right next
     to the size buttons in the same square, dark-active style made it read
     as "just more sizes" instead of "which print you get" — a completely
     different kind of choice. Pill-shaped with the brand amber as its active
     color (same accent used for prices/CTAs) ties it to "this changes the
     design," while size stays the neutral dark square. Short '24/'25/'26/'27
     labels reinforce that these are years, not garment specs. */
  .year-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .year-btn {
    min-width: 2.5rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 2px solid var(--border-light);
    background: var(--bg-light-raised);
    color: var(--text-on-light);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .year-btn:hover {
    border-color: var(--amber-500);
  }
  .year-btn.active {
    border-color: var(--amber-500);
    background: var(--amber-500);
    color: var(--forest-900, #141c10);
  }

  /* Product Details & Sizing — one shared native <dialog>, content panels
     toggled by the dialog's own data-type attribute (set in the script
     above) rather than two separate dialogs. */
  .details-modal {
    position: relative;
    border: none;
    border-radius: var(--radius-md);
    padding: 2rem 2.25rem 2.25rem;
    max-width: 480px;
    width: calc(100% - 2.5rem);
    background: var(--bg-light-raised);
    color: var(--text-on-light);
  }
  .details-modal::backdrop {
    background: rgba(18, 24, 15, 0.6);
  }
  .details-close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-on-light-muted);
    cursor: pointer;
    padding: 0.25rem;
  }
  .details-panel {
    display: none;
  }
  .details-modal[data-type="hat"] .details-panel[data-panel="hat"],
  .details-modal[data-type="shirt"] .details-panel[data-panel="shirt"] {
    display: block;
  }
  .details-panel h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.3rem;
  }
  .details-sub {
    color: var(--text-on-light-muted);
    font-size: 0.85rem;
    margin: 0 0 1.25rem;
  }
  .details-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0 0 1.5rem;
  }
  .details-list dt {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--forest-800);
    margin-bottom: 0.15rem;
  }
  .details-list dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-on-light);
    line-height: 1.5;
  }
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    margin-bottom: 0.6rem;
  }
  .size-table caption {
    text-align: left;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-on-light-muted);
    margin-bottom: 0.5rem;
  }
  .size-table th,
  .size-table td {
    padding: 0.4rem 0.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border-light);
  }
  .size-table th:first-child,
  .size-table td:first-child {
    text-align: left;
  }
  .size-table th {
    font-family: var(--font-label);
    font-weight: 700;
    color: var(--text-on-light-muted);
  }
  .size-note {
    font-size: 0.76rem;
    color: var(--text-on-light-muted);
    margin: 0;
  }
</style>

<!-- Cap-color swatch buttons are created client-side via document.createElement
     (see script above) — they never get the data-astro-cid scoping attribute
     Astro adds to elements written directly in this template, so the scoped
     .swatch rule in the <style> block above silently never applies to them.
     This duplicate, unscoped copy is what actually styles them. Keep it in
     sync with .thread-swatch/.swatch above if those ever change. -->
<style is:global>
  .color-swatches .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid var(--border-light);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    background: linear-gradient(135deg, var(--swatch) 50%, var(--swatch2) 50%);
  }
  .color-swatches .swatch.active {
    border-color: var(--forest-800);
    box-shadow: 0 0 0 2px var(--bg-light-raised), 0 0 0 4px var(--forest-800);
  }

  /* Reserve space at the bottom of the page for the fixed Live Bundle bar so
     it doesn't sit on top of the footer once it's visible — global because
     it targets <body>, which Astro's scoped styles can't reach from this
     component. */
  body:has(.bundle-bar.is-visible) {
    padding-bottom: 84px;
  }
  @media (max-width: 640px) {
    body:has(.bundle-bar.is-visible) {
      padding-bottom: 96px;
    }
  }
</style>
