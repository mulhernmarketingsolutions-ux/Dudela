---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="The Hospital Bag Checklist — Dudela" description="Everything to pack, nothing you don't need. Three bags done right, plus your actual job once you're in the room. Free.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Free Checklist</p>
        <h1>The Hospital Bag Checklist</h1>
        <p class="hero-sub">
          Everything to pack, nothing you don't need. Three bags — hers, baby's, and yours —
          plus what your actual job is once you're in that room.
        </p>
        <form class="email-form" id="hospital-bag-form">
          <input type="hidden" name="magnet" value="hospital-bag-checklist" />
          <input type="hidden" name="source" value="/hospital-bag-checklist" />
          <input type="email" name="email" placeholder="you@email.com" required />
          <button type="submit" class="btn btn-primary">Send Me the Checklist</button>
        </form>
        <p id="hospital-bag-form-status" class="form-status"></p>
      </div>
      <img src="/images/cover-hospital-bag.jpg" alt="The Hospital Bag Checklist — free guide cover" class="cover-img" />
    </div>
  </section>

  <script>
    const form = document.getElementById("hospital-bag-form") as HTMLFormElement | null;
    const status = document.getElementById("hospital-bag-form-status") as HTMLParagraphElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = "Sending…";
      try {
        const res = await fetch("/api/lead-magnet", { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          if (status) status.textContent = "Check your email — the checklist is on its way.";
          form.reset();
        } else {
          if (status) status.textContent = data.error || "Something went wrong. Please try again.";
          btn.disabled = false;
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again.";
        btn.disabled = false;
      }
    });
  </script>

  <section class="whats-inside section-light">
    <div class="container">
      <p class="eyebrow">What's inside</p>
      <div class="inside-grid">
        <div><h3>For her</h3><p>Comfort and recovery essentials — the gaps the hospital doesn't fill.</p></div>
        <div><h3>For baby</h3><p>Only what actually goes home with you, nothing extra.</p></div>
        <div><h3>For you</h3><p>Pack like you're staying too — because you are.</p></div>
        <div><h3>Documents &amp; logistics</h3><p>The unglamorous paperwork that actually holds things up if it's missing.</p></div>
      </div>
      <p class="body-note">
        Plus your actual job once you're in that room — the part no checklist usually covers.
        This is the free starting point — the <a href="/kit">Dudela Prep Kit</a> walks the
        whole hospital stay hour by hour when you're ready for more.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 46ch;
    margin-bottom: 1.75rem;
  }
  .email-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    max-width: 460px;
  }
  .form-status {
    color: var(--text-on-dark-muted);
    font-size: 0.9rem;
    margin-top: 0.75rem;
    min-height: 1.2em;
  }
  .email-form input {
    flex: 1;
    min-width: 200px;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
  }
  .cover-img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid rgba(242, 237, 230, 0.16);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.07) inset,
      0 30px 70px -20px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(0, 0, 0, 0.35);
  }
  .whats-inside {
    padding: var(--space-6) 0;
  }
  .inside-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0 2rem;
  }
  .inside-grid h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }
  .inside-grid p {
    color: var(--text-on-light-muted);
    font-size: 0.92rem;
    margin: 0;
  }
  .body-note {
    max-width: 60ch;
    color: var(--text-on-light-muted);
  }
  .body-note a {
    color: var(--rust-600);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
