---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
---
<BaseLayout title="You're in — The Spit-Up Society" description="Welcome to the Spit-Up Society. Here's what happens next.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">You're in</p>
      <h1>Welcome to the Spit-Up Society.</h1>
      <p class="hero-sub">
        It's free. Check your inbox for a one-click link into the member area. It expires
        in 20 minutes, but you can always log in again at thedudelaco.com/member/login.
      </p>
      <a href="/member/login" class="btn btn-primary">Log in</a>
    </div>
  </section>

  <section class="next section-light">
    <div class="container next-inner">
      <p class="eyebrow">What to expect</p>
      <h2>No app to download. No dues. Just people who get it.</h2>
      <div class="next-grid">
        <div class="next-card">
          <h3>Ask John &amp; Mike</h3>
          <p>Send us your real question from the member area. We answer every one.</p>
        </div>
        <div class="next-card">
          <h3>Womb Watch</h3>
          <p>Follow our co-founder Mike through his wife's pregnancy — new episodes drop week by week in your member home.</p>
        </div>
        <div class="next-card">
          <h3>Early Access</h3>
          <p>The members-only podcast, plus first access to new guides and merch drops.</p>
        </div>
      </div>
      <p class="next-footnote">
        Everything above lives in your member home now — <a href="/member/dashboard">head there</a> whenever you're ready.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 5rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.2rem);
    margin: 0.5rem 0 1.25rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 46ch;
    margin-bottom: 2rem;
  }
  .hero-sub strong {
    color: var(--amber-500);
  }
  .next {
    padding: var(--space-6) 0;
  }
  .next-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .next h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    max-width: 26ch;
    margin: 0.5rem auto 2rem;
  }
  .next-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-align: left;
  }
  .next-card {
    background: var(--cream-100, #f5efe3);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  .next-card h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }
  .next-card p {
    color: var(--text-on-light-muted);
    margin: 0;
    font-size: 0.92rem;
  }
  .next-footnote {
    color: var(--text-on-light-muted);
    font-size: 0.88rem;
    margin-top: 2rem;
    font-style: italic;
  }
  @media (min-width: 700px) {
    .next-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
