---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Testimonials from "../../components/Testimonials.astro";
---
<BaseLayout title="The Spit-Up Society — Dudela" description="The free club for dads-to-be. Follow along, ask us anything, and get every tool in one place.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">The Spit-Up Society &middot; Free</p>
        <h1>The free club for dads-to-be.</h1>
        <p class="hero-sub">
          Follow along, ask us anything, and get every tool in one place. Built by two dads
          who've been through the NICU, the emergency C-section, and the 3 AM panic.
        </p>
        <p class="hero-callout">
          <strong>Free.</strong> No card, no catch. Drop your email and we'll send a one-click link into the member area.
        </p>
        <a href="#join-form" class="btn btn-primary">Join free</a>
      </div>
      <img src="/images/IMG_0839_VSCO.JPG" alt="Mike and John with the kids" class="hero-photo" />
    </div>
  </section>

  <section class="perks section-light">
    <div class="container">
      <p class="eyebrow">What's included</p>
      <div class="perks-grid">
        <div class="perk"><h3>Womb Watch</h3><p>Follow Mike and Abigail's second pregnancy week by week, on video or audio. The real version, not the highlight reel.</p></div>
        <div class="perk"><h3>Ask John &amp; Mike</h3><p>Send us your real question anytime. Once a month we answer the best ones in a short video for members.</p></div>
        <div class="perk"><h3>Every Free Tool, One Place</h3><p>The Dad Prep Guide, plus the hospital bag, birth plan, baby shower, and sleep checklists. No hunting, no extra signups.</p></div>
        <div class="perk"><h3>Member Perks</h3><p>Discounts from brands we actually use: Babysense monitors, Taking Cara Babies sleep classes, and 20% off Dudela merch.</p></div>
        <div class="perk"><h3>Your Week, In Your Inbox</h3><p>Tell us your due date and we'll start sending a short weekly note: what's happening and what she needs from you. Rolling out this fall.</p></div>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="join-cta section-light" id="join-form">
    <div class="container join-cta-inner">
      <h2>Free. No pressure. Just people who get it.</h2>
      {Astro.url.searchParams.get("error") && <p class="join-error">Something went wrong. Check your email and try again.</p>}
      <form method="POST" action="/api/join-free" class="join-form">
        <input type="text" name="name" placeholder="First name" autocomplete="given-name" />
        <input type="email" name="email" placeholder="Email" required autocomplete="email" />
        <label class="due-label">Due date (optional)
          <input type="date" name="due_date" />
        </label>
        <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" class="btn btn-primary">Join free</button>
      </form>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    max-width: 14ch;
    margin: 0.5rem 0 1.25rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }
  .hero-callout {
    background: var(--forest-700);
    border: 1px solid var(--amber-500);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
    max-width: 46ch;
    font-size: 0.92rem;
    margin-bottom: 1.5rem;
  }
  .hero-callout strong {
    color: var(--amber-500);
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-md);
  }
  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .price {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--amber-500);
  }
  .price-label {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: var(--text-on-dark-muted);
  }
  .perks {
    padding: var(--space-6) 0;
  }
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .perk h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }
  .perk p {
    color: var(--text-on-light-muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .join-cta {
    padding: var(--space-6) 0;
    text-align: center;
  }
  .join-cta-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 20ch;
    margin: 0 auto 2rem;
  }
  .join-cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .join-cta-actions .btn-ghost {
    color: var(--text-on-light);
  }
  .join-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 640px;
    margin: 0 auto;
  }
  .join-form input {
    flex: 1 1 180px;
    padding: 0.85rem 1rem;
    border: 1px solid #c9c2b2;
    border-radius: var(--radius-sm);
    font-size: 1rem;
  }
  .due-label {
    flex: 1 1 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-on-light-muted);
  }
  .due-label input {
    flex: 0 1 220px;
  }
  .join-form .hp {
    position: absolute;
    left: -9999px;
  }
  .join-error {
    color: #b3261e;
    margin-bottom: 1rem;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
