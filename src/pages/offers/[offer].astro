---
import BaseLayout from "../../layouts/BaseLayout.astro";
export function getStaticPaths() {
  return ["bag", "prep", "guide"].map(offer => ({ params: { offer } }));
}
const guide = Astro.params.offer === "guide";
const free = Astro.params.offer !== "prep";
const magnet = guide ? "free-guide" : "hospital-bag-checklist";
const download = guide ? "/downloads/dudela-15-things.pdf" : "/downloads/dudela-hospital-bag-checklist.pdf";
const title = guide ? "Baby’s coming. Start here." : free ? "Pack the bag. Know your job." : "Become the dad they can count on.";
const name = guide ? "15 Things Every Dad Should Do Before the Baby Arrives" : free ? "The Hospital Bag Checklist" : "The Dudela Prep Kit";
const points = guide
  ? ["Practical steps for your head, home, and partnership", "Conversation starters to use with your partner", "A clear place to start before baby arrives"]
  : free
  ? ["What to pack for her, baby, and you", "The documents and logistics to sort out now", "Your actual job once you get in the room"]
  : ["Six pillars to help you show up prepared", "Nine printable tools you can actually use", "Real stories from John and Mike", "A pregnancy roadmap organized by trimester"];
---
<BaseLayout title={`${name} | Dudela`} description={title}>
  <header><a href="/" aria-label="Dudela home"><img src="/logo/dudela-logo-white-full.png" alt="Dudela" width="128" /></a><span>Turning dudes into dads</span></header>
  <main>
    <div class="intro"><p class="eyebrow">{guide ? "Your first step into fatherhood" : free ? "One less thing to figure out" : "For the dad who wants to show up"}</p><h1>{title}</h1><p class="sub">{guide ? "You care. You want to be useful. You’re just not sure where to start. Get a practical list from two dads who remember that feeling." : free ? "You don’t need another overwhelming list. You need to know what goes in the bag and how to be useful when it matters." : "There’s a lot you can’t control about becoming a dad. How you prepare doesn’t have to be one of them."}</p></div>
    <section class="offer" aria-label={name}>
      <div class="visual">
        {guide ? <img class="cover" src="/images/free-guide-cover.png" alt="15 Things Every Dad Should Do Before the Baby Arrives cover" /> : free ? <div class="paper"><span>DUDELA FIELD NOTES</span><h2>The Hospital<br />Bag Checklist</h2><p>For her.<br />For baby.<br />For you.</p><div class="rule"></div><small>Pack with a plan.<br />Show up ready.</small></div> : <img class="cover" src="/images/prep-kit-cover.jpeg" alt="The Dudela Prep Kit cover" />}
        <p class="caption">Built by two dads who have been there.</p>
      </div>
      <div class="details"><p class="eyebrow">{guide ? "Free Dad Prep Guide" : free ? "Free PDF checklist" : "Digital guide + printable tools"}</p><h2>{name}</h2><p class="price">{free ? "$0" : "$37"}<span>{free ? "Free. Yours to keep." : "One payment. Yours to keep."}</span></p><ul>{points.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul>
        {free ? <form id="offer-form" data-download={download}><input type="hidden" name="magnet" value={magnet} /><input type="hidden" name="source" value={Astro.url.pathname} /><label for="email">Where should we send it?</label><input id="email" type="email" name="email" autocomplete="email" placeholder="Your email address" required /><button type="submit" class="btn btn-primary">{guide ? "Send me the free guide" : "Send me the free checklist"} <span aria-hidden="true">↗</span></button><p class="fine">We’ll send your free resource and Dudela emails. Unsubscribe anytime.</p><p id="status" role="status" aria-live="polite"></p></form> : <div><a class="btn btn-primary" href="/api/create-checkout-session?product=prep-kit">Get the Prep Kit for $37 <span aria-hidden="true">↗</span></a><p class="fine">Secure checkout through Stripe. Digital download.</p></div>}
      </div>
    </section>
    <aside><p class="eyebrow">From John &amp; Mike</p><p>“This is the thing we wish someone had handed us when we were where you are right now.”</p><span>Two dads. Real experience. Practical help.</span></aside>
  </main>
  <footer><span>© {new Date().getFullYear()} The Dudela Co.</span><a href="/terms">Terms</a><a href="mailto:dude@thedudelaco.com">Need a hand?</a></footer>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>("#offer-form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const status = document.querySelector<HTMLElement>("#status")!;
    const body = new FormData(form);
    const query = new URLSearchParams(location.search);
    const attribution = new URLSearchParams();
    for (const key of ["utm_source", "utm_medium", "utm_campaign", "utm_content"]) {
      const value = query.get(key);
      if (value) attribution.set(key, value.slice(0, 100));
    }
    body.set("source", location.pathname + (attribution.size ? `?${attribution}` : ""));
    button.disabled = true;
    status.textContent = "Getting your download ready…";
    try {
      const response = await fetch("/api/lead-magnet", { method: "POST", body });
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error("delivery");
      if (data.warnings?.includes("confirmation-email")) {
        status.textContent = "We couldn’t send the email. Your download is ready below.";
      } else {
        status.textContent = "You’re all set. Check your inbox, or download it here.";
      }
      const link = document.createElement("a");
      link.href = form.dataset.download!;
      link.textContent = "Get your free download";
      link.style.display = "block";
      status.append(link);
      const next = document.createElement("p");
      next.textContent = "Start with one action today. When you want more help, ";
      const kit = document.createElement("a");
      kit.href = "/offers/prep";
      kit.textContent = "explore the $37 Prep Kit";
      next.append(kit);
      status.append(next);
      button.textContent = "Your download is ready";
      button.style.cursor = "default";
      form.querySelector<HTMLInputElement>("#email")!.disabled = true;
    } catch {
      status.textContent = "We couldn’t send that. Please try again.";
      button.disabled = false;
    }
  });
</script>
<style>
  :global(body){background:#f5efe3}header img{height:48px;width:auto}header{background:#1c2319;color:#c9c2ae;display:flex;align-items:center;justify-content:space-between;padding:24px max(24px,calc((100vw - 1060px)/2));gap:24px}header span{font-size:11px;letter-spacing:.12em;text-transform:uppercase}main{max-width:1060px;margin:auto;padding:54px 24px 30px}.intro{text-align:center;max-width:760px;margin:0 auto 40px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.16em;font-weight:700;color:#5c5a4f}h1{font-family:var(--font-display);font-size:clamp(44px,6vw,70px);line-height:1.03;font-weight:400;margin:18px 0}.sub{max-width:610px;margin:auto;color:#5c5a4f;font-size:16px;line-height:1.7}.offer{display:grid;grid-template-columns:1fr 1fr;border:1px solid #ddd0b4;border-radius:12px;overflow:hidden;background:#fffaf1}.visual{background:#dce0d2;display:flex;align-items:center;justify-content:center;flex-direction:column;padding:38px}.paper{background:#1c2319;color:#f5efe3;box-shadow:10px 15px 0 #b4bcaa;padding:32px;width:100%;max-width:280px;transform:rotate(-3deg)}.paper>span{font-size:9px;letter-spacing:.2em}.paper h2{font-size:34px;line-height:1.05;color:#f5efe3;margin:30px 0}.paper p{font-family:var(--font-display);font-size:26px;line-height:1.3}.paper small{font-size:11px;color:#c9c2ae}.rule{border-top:1px solid #57684a;margin:24px 0}.cover{max-height:385px;object-fit:contain;box-shadow:8px 12px 20px #1c231922;transform:rotate(-3deg)}.caption{font-size:11px;color:#4a5540;margin:30px 0 0}.details{padding:38px}h2{font-family:var(--font-display);font-size:34px;font-weight:400;line-height:1.1;margin:14px 0}.price{font-size:32px;font-weight:600;margin:20px 0}.price span{font-size:12px;font-weight:400;color:#5c5a4f;display:inline-block;margin-left:14px}ul{padding:0;list-style:none;margin:22px 0 28px}li{display:flex;gap:12px;font-size:14px;margin:12px 0}li span{color:#57684a}label{font-size:13px;display:block;margin-bottom:8px}input[type=email]{width:100%;background:white;border:1px solid #b9b5a7;border-radius:4px;padding:14px;font:inherit;font-size:16px;margin-bottom:12px}.btn{display:flex;width:100%;justify-content:space-between;font-size:14px;padding:16px 20px}.fine{font-size:11px;color:#5c5a4f;line-height:1.6;margin:12px 0 0}#status{font-size:13px}aside{text-align:center;max-width:590px;margin:42px auto 12px}aside>p:not(.eyebrow){font-family:var(--font-display);font-size:26px;line-height:1.3;margin:12px 0}aside>span{font-size:11px;color:#5c5a4f}footer{max-width:1060px;padding:24px;margin:auto;border-top:1px solid #ddd0b4;display:flex;gap:24px;font-size:11px;color:#5c5a4f}footer span{margin-right:auto}button:disabled{opacity:.6;cursor:wait}@media(max-width:650px){.details{display:flex;flex-direction:column}.details h2{font-size:28px}.details form{order:1}.details ul{order:2;margin-bottom:0}.visual{order:2}.details{order:1}header{padding:20px 24px}header span{font-size:8px}main{padding-top:34px}.offer{grid-template-columns:1fr}.visual{padding:28px}.paper{max-width:210px;padding:24px}.paper h2{font-size:28px;margin:20px 0}.paper p{font-size:22px}.cover{max-height:260px}.details{padding:26px}.caption{margin-top:22px}.intro{margin-bottom:28px}footer{gap:16px}}
</style>
