---
import BaseLayout from "../layouts/BaseLayout.astro";
// Ad landing page for the Prep Kit (built 2026-10-16). Deliberately NO Nav or
// Footer: one job, one button. Warm/on-site visitors use /kit instead.
// noindex so it doesn't compete with /kit in search.
const BUY = "/api/create-checkout-session?product=prep-kit";
const track = "window.fbq && fbq('track', 'InitiateCheckout', { value: 37, currency: 'USD', content_name: 'Prep Kit' })";
const quotes = [
  { who: "Jessica", where: "New mom in Nebraska", text: "The biggest thing? I didn't have to ask him to do every little thing. We actually talked about what I needed, and he started handling stuff. That took a lot off me." },
  { who: "Sam", where: "Expecting dad in Colorado", text: "Honestly, I needed someone to spell it out. 'Be supportive' could mean anything. Now I have a much better idea of what to actually do." },
  { who: "Craig", where: "Expecting dad in California", text: "We did the exercises together, which I thought might be awkward. Ended up having a really good conversation about what we were both worried about. Abigail's Corner was probably my favorite part." },
];
---
<BaseLayout title="The Dudela Prep Kit — A real plan for expecting dads" description="Your no-nonsense guide to showing up strong. Six pillars, nine printable tools, real stories from two dads who've been there. $37, instant download." noindex>
  <div class="lp">
    <header class="brand"><span>DUDELA</span></header>

    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="label">For expecting dads</p>
          <h1>You don't have to know everything. You do need somewhere honest to start.</h1>
          <p class="lede">The Dudela Prep Kit is a 31-page plan you and your partner work through together: what matters during the birth, who owns what at home, and how you'll handle the first days with a newborn.</p>
          <a href={BUY} class="cta" onclick={track}>Get the Prep Kit · $37</a>
          <p class="fine">Instant download · Read it on your phone or print it</p>
        </div>
        <div class="phones">
          <div class="phone back"><img src="/images/kit-phones/kit-phone-readiness.jpg" alt="The Readiness Map page" /></div>
          <div class="phone front"><img src="/images/kit-phones/kit-phone-cover.jpg" alt="The Dudela Prep Kit cover" /></div>
        </div>
      </div>
    </section>

    <!-- PAIN -->
    <section class="band alt">
      <div class="wrap narrow">
        <h2>Someone asks if you're excited. You say "Yeah, absolutely."</h2>
        <p>Because explaining the other six feelings would take a while.</p>
        <p>You want this baby more than anything. You're also quietly wondering what you signed up for. She's doing most of the reading and the planning, and you're starting to feel like a passenger. Everyone says "be supportive." Nobody says what that means on a Tuesday night.</p>
        <p class="strong">Nobody handed you a plan. This is the plan.</p>
      </div>
    </section>

    <!-- STORY + PHOTOS -->
    <section class="band">
      <div class="wrap">
        <p class="label center">Two dads who've been there</p>
        <h2 class="center">Neither of us got the birth we planned for.</h2>
        <div class="stories">
          <figure class="story">
            <img src="/images/john-viv-walking.jpg" alt="John and Viv walking with their twin daughters" />
            <figcaption>
              <strong>John &amp; Viv</strong>
              <p>Our twins came at 34 weeks and spent a month in the NICU. I'd hold it together upstairs, break for a few minutes in the parking garage, then go back up.</p>
            </figcaption>
          </figure>
          <figure class="story">
            <img src="/images/mike-abigail.jpg" alt="Mike and Abigail" />
            <figcaption>
              <strong>Mike &amp; Abigail</strong>
              <p>The birth plan turned into an emergency C-section in about ninety seconds. The plan was gone. She still needed me there.</p>
            </figcaption>
          </figure>
        </div>
        <p class="center sub">We built the Prep Kit to be what we wish someone had handed us: honest, practical, and made to do together.</p>
      </div>
    </section>

    <!-- INSIDE -->
    <section class="band alt">
      <div class="wrap">
        <p class="label center">What's inside</p>
        <h2 class="center">Six pillars. Nine tools you actually fill out.</h2>
        <div class="trio">
          <div>
            <div class="phone sm"><img src="/images/kit-phones/kit-phone-readiness.jpg" alt="Readiness Map" /></div>
            <h3>Find your gaps in 10 minutes</h3>
            <p>The Readiness Map shows what's handled, what's not, and the one thing to do today.</p>
          </div>
          <div>
            <div class="phone sm"><img src="/images/kit-phones/kit-phone-abigail.jpg" alt="Abigail's Corner" /></div>
            <h3>Her side of it, too</h3>
            <p>Abigail's Corner, from a Board Certified Behavior Analyst, turns "be more helpful" into routines you can keep.</p>
          </div>
          <div>
            <div class="phone sm"><img src="/images/kit-phones/kit-phone-first72.jpg" alt="First 72 Hours Plan" /></div>
            <h3>The first days home, mapped</h3>
            <p>Feeding support, safe sleep, rest, meals, and visitors, planned before you're exhausted.</p>
          </div>
        </div>
        <ul class="checks">
          <li>Get Your Head Right</li><li>Get Your Money Ready</li><li>Be The Partner She Needs</li>
          <li>Know What You're Walking Into</li><li>Decide What Kind of Dad You Want to Be</li><li>First Days Home Playbook</li>
        </ul>
        <div class="center"><a href={BUY} class="cta" onclick={track}>Get the Prep Kit · $37</a></div>
      </div>
    </section>

    <!-- HOUR -->
    <section class="band">
      <div class="wrap hour-grid">
        <div class="phone"><img src="/images/kit-phones/kit-phone-firsthour.jpg" alt="Your first useful hour" /></div>
        <div>
          <p class="label">How it works</p>
          <h2>Your first useful hour.</h2>
          <ol>
            <li><b>10 min</b> Find your gaps with the Readiness Map.</li>
            <li><b>20 min</b> Sit down together and hear what feels heaviest for her.</li>
            <li><b>20 min</b> Build the plan for the birth and the first days home.</li>
            <li><b>10 min</b> Name who owns the next three things, and by when.</li>
          </ol>
          <p class="strong">One hour in, you'll know who to call, how you're getting to the hospital, what she wants you to handle, and who can help once you're home.</p>
        </div>
      </div>
    </section>

    <!-- PROOF -->
    <section class="band alt">
      <div class="wrap">
        <h2 class="center">From families who've used it</h2>
        <div class="quotes">
          {quotes.map((q) => (
            <figure><blockquote>"{q.text}"</blockquote><figcaption><b>{q.who}</b> · {q.where}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="band close">
      <div class="wrap narrow center">
        <img src="/images/kit-phones/kit-phone-cover.jpg" alt="" class="close-phone" />
        <h2>The Dudela Prep Kit</h2>
        <p class="sub">31 pages · 6 pillars · 9 printable tools · Abigail's Corner · Instant PDF</p>
        <p class="price">$37</p>
        <a href={BUY} class="cta big" onclick={track}>Get the Prep Kit</a>
        <p class="fine">Not medical advice. We point you to your care team for that, every time.</p>
        <p class="sig">"You don't have to walk into this certain. You can walk in willing to learn." John &amp; Mike</p>
      </div>
    </section>

    <footer class="mini">© The Dudela Co. · <a href="/terms">Terms</a></footer>
  </div>
</BaseLayout>

<style>
  .lp { --ink: #1c2319; --muted: #5a6150; --paper: #fffdf9; --alt: #f5f0e6; --line: #e6dccb; --rust: #a3492b; --amber: #e27d25;
        background: var(--paper); color: var(--ink); font-size: 17px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .narrow { max-width: 680px; }
  .center { text-align: center; }
  .brand { text-align: center; padding: 18px 0 6px; font-family: var(--font-label); font-weight: 700; letter-spacing: 0.32em; font-size: 0.8rem; color: var(--ink); }
  .label { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.75rem; color: var(--rust); font-weight: 600; margin: 0 0 0.6rem; }
  h1, h2 { font-family: var(--font-display); font-weight: 400; color: var(--ink); line-height: 1.1; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); margin: 0 0 1rem; }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); margin: 0 0 1rem; }
  h3 { font-family: var(--font-label); font-size: 1.05rem; margin: 1rem 0 0.35rem; }
  p { color: var(--muted); line-height: 1.6; margin: 0 0 1rem; }
  .strong { color: var(--ink); font-weight: 600; }
  .sub { color: var(--muted); }
  .band { padding: 72px 0; }
  .band.alt { background: var(--alt); }

  .cta { display: inline-block; background: var(--amber); color: #1a1208; font-weight: 700; padding: 16px 28px; border-radius: 8px; text-decoration: none; font-size: 1.05rem; box-shadow: 0 6px 18px -8px rgba(226,125,37,.8); }
  .cta:hover { background: #c66815; }
  .cta.big { padding: 18px 40px; font-size: 1.15rem; }
  .fine { font-size: 0.85rem; margin-top: 0.8rem; color: var(--muted); }

  .hero { padding: 28px 0 64px; }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  .lede { font-size: 1.1rem; }

  .phone { border: 9px solid #15190f; border-radius: 34px; overflow: hidden; background: #15190f; box-shadow: 0 30px 60px -25px rgba(28,35,25,.55); aspect-ratio: 9 / 19.5; position: relative; }
  .phone::before { content: ""; position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 34%; height: 16px; background: #15190f; border-radius: 10px; z-index: 2; }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .phones { position: relative; height: 520px; max-width: 420px; margin: 0 auto; width: 100%; }
  .phones .phone { position: absolute; width: 230px; }
  .phones .back { right: 0; top: 30px; transform: rotate(5deg); opacity: .96; }
  .phones .front { left: 10px; top: 0; transform: rotate(-3deg); }

  .stories { display: grid; gap: 28px; margin: 36px 0 28px; }
  .story { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .story img { width: 100%; height: 440px; object-fit: cover; object-position: center 30%; display: block; }
  .story figcaption { padding: 18px 22px 8px; }
  .story strong { font-family: var(--font-label); }
  .story p { margin: 6px 0 12px; }

  .trio { display: grid; gap: 40px; margin: 36px 0; }
  .trio > div { text-align: center; }
  .phone.sm { width: 200px; margin: 0 auto; }
  .checks { list-style: none; padding: 0; margin: 0 auto 36px; display: grid; gap: 10px 24px; max-width: 760px; }
  .checks li { padding-left: 28px; position: relative; color: var(--ink); font-weight: 500; }
  .checks li::before { content: "✓"; position: absolute; left: 0; color: var(--rust); font-weight: 700; }

  .hour-grid { display: grid; gap: 40px; align-items: center; }
  .hour-grid > .phone { width: 240px; margin: 0 auto; }
  ol { padding: 0; list-style: none; margin: 0 0 1.2rem; }
  ol li { padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--muted); }
  ol li b { display: inline-block; min-width: 64px; color: var(--rust); font-family: var(--font-label); }

  .quotes { display: grid; gap: 20px; margin-top: 32px; }
  .quotes figure { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
  .quotes blockquote { margin: 0 0 14px; line-height: 1.6; color: var(--ink); }
  .quotes figcaption { font-family: var(--font-label); font-size: 0.85rem; color: var(--rust); }

  .close-phone { width: 150px; border: 7px solid #15190f; border-radius: 26px; aspect-ratio: 9/19.5; object-fit: cover; object-position: top; box-shadow: 0 24px 50px -22px rgba(28,35,25,.55); margin-bottom: 18px; }
  .price { font-family: var(--font-display); font-size: 3rem; color: var(--ink); margin: 0.2rem 0 1rem; }
  .sig { font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--ink); margin-top: 2rem; }
  .mini { text-align: center; padding: 24px; font-size: 0.8rem; color: var(--muted); border-top: 1px solid var(--line); }
  .mini a { color: var(--muted); }

  @media (min-width: 860px) {
    .hero-grid { grid-template-columns: 1.1fr 0.9fr; }
    .stories { grid-template-columns: 1fr 1fr; }
    .trio { grid-template-columns: repeat(3, 1fr); }
    .checks { grid-template-columns: repeat(3, 1fr); }
    .hour-grid { grid-template-columns: 0.7fr 1.3fr; }
    .quotes { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 520px) {
    .band { padding: 52px 0; }
    .phones { height: 430px; }
    .phones .phone { width: 190px; }
  }
</style>
