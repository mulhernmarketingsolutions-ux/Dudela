---
import BaseLayout from "../layouts/BaseLayout.astro";

// Mirrors the real link-in-bio page (used in Instagram/TikTok bios), plus
// the Prep Kit checkout (own Stripe checkout, see /api/create-checkout-session)
// and the Taking Cara Babies sleep affiliate link.
//
// Laid out in three tiers by priority, not just one flat list:
//   1. The podcast — the single highest-intent thing IG traffic is looking
//      for, gets its own featured card up top. Links to /podcast (the
//      on-site episode list + Apple/Spotify/YouTube follow links) rather
//      than straight to Spotify, so it doesn't pick one platform for people.
//   2. New Merch + Spit-Up Society — the two things we're actively pushing
//      right now, one step down from the podcast.
//   3. Everything else, below a divider.
const podcastLink = {
  label: "The Dudela Podcast",
  sub: "John & Mike, unfiltered — new episode every other Tuesday",
  href: "/podcast",
};

const tierTwoLinks = [
  { label: "Shop New Merch", sub: "Fresh shirt designs just dropped", href: "/merch#shirts", tag: null },
  { label: "Join the Spit-Up Society", sub: "Live Q&A calls, twice a month", href: "/join/spit-up-society", tag: "$5/mo" },
];

const links = [
  { label: "Get the Free Dad Prep Guide", href: "/guide", tag: "Free" },
  { label: "The Dudela Prep Kit", href: "/api/create-checkout-session?product=prep-kit", tag: "$37" },
  { label: "Steady Dad: Before Birth Workshop", href: "/workshop", tag: "$100" },
  { label: "Steady Dad Cohort", href: "/cohort", tag: "Waitlist" },
  // The highest-value offer on the site had no path from the link-in-bio
  // page at all — cold social traffic could reach everything up through
  // the Cohort but never discover 1:1 coaching exists.
  { label: "The Turn — 1:1 Coaching", sub: "With John & Mike", href: "/turn", tag: "$1,800" },
  { label: "Taking Cara Babies", sub: "The sleep resource we recommend to every dad", href: "https://www.takingcarababies.com?sca_ref=11694397.hvn2tySyLaykC", tag: null, external: true },
  { label: "Leave Us a Voicemail", href: "/voicemail", tag: null },
];
---
<BaseLayout title="Start Here — Dudela" description="Everything Dudela, in one place.">
  <main class="start-here">
    <div class="start-here-inner">
      <a href="/" class="wordmark"><img src="/logo/dudela-wordmark-cream.png" alt="Dudela" /></a>
      <p class="tagline">Turning Dudes Into Dads</p>

      <a href={podcastLink.href} class="podcast-hero">
        <span class="podcast-hero-eyebrow">Listen Now</span>
        <span class="podcast-hero-title">{podcastLink.label}</span>
        <span class="podcast-hero-sub">{podcastLink.sub}</span>
      </a>

      <div class="tier-two">
        {tierTwoLinks.map((l) => (
          <a class="link-btn featured" href={l.href}>
            <span class="link-btn-text">
              <span class="link-btn-label">{l.label}</span>
              {l.sub && <span class="link-btn-sub">{l.sub}</span>}
            </span>
            {l.tag && <span class="tag">{l.tag}</span>}
          </a>
        ))}
      </div>

      <div class="tier-divider"><span>More from Dudela</span></div>

      <div class="link-list">
        {links.map((l) => (
          <a
            class="link-btn"
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener" : undefined}
          >
            <span class="link-btn-text">
              <span class="link-btn-label">{l.label}</span>
              {l.sub && <span class="link-btn-sub">{l.sub}</span>}
            </span>
            {l.tag && <span class="tag">{l.tag}</span>}
          </a>
        ))}
      </div>

      <div class="socials">
        <a href="https://instagram.com/the_dudela_official" target="_blank" rel="noopener">Instagram</a>
        <a href="https://www.tiktok.com/@the_dudela_official" target="_blank" rel="noopener">TikTok</a>
        <a href="https://www.youtube.com/@TheDudela-Official/videos" target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .start-here {
    min-height: 100svh;
    background: var(--forest-900);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }
  .start-here-inner {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .wordmark img {
    height: 56px;
    width: auto;
    display: block;
  }
  .tagline {
    font-family: var(--font-display);
    color: var(--text-on-dark-muted);
    font-size: 1.1rem;
    margin: 0.5rem 0 2rem;
  }

  /* Tier 1: podcast hero */
  .podcast-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    padding: 1.6rem 1.5rem;
    margin-bottom: 1.6rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--amber-500);
    background: var(--amber-500);
    color: var(--forest-900);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .podcast-hero:hover {
    background: var(--amber-600);
    border-color: var(--amber-600);
    transform: translateY(-2px);
  }
  .podcast-hero-eyebrow {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.75;
  }
  .podcast-hero-title {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1.15;
  }
  .podcast-hero-sub {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    opacity: 0.85;
  }

  /* Tier 2: new merch + spit-up society */
  .tier-two {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    margin-bottom: 1.6rem;
  }

  /* Tier divider, above the rest of the links */
  .tier-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-bottom: 1.2rem;
  }
  .tier-divider::before,
  .tier-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--forest-600);
  }
  .tier-divider span {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    white-space: nowrap;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
  }
  .link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    text-decoration: none;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .link-btn:hover {
    border-color: var(--amber-500);
    transform: translateY(-2px);
  }
  .link-btn.featured {
    border-color: var(--amber-500);
  }
  .link-btn-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }
  .link-btn-sub {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.78rem;
    opacity: 0.7;
    text-transform: none;
    letter-spacing: normal;
  }
  .tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--amber-500);
    font-weight: 700;
    flex-shrink: 0;
  }
  .socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .socials a {
    color: var(--text-on-dark-muted);
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.9rem;
  }
</style>
