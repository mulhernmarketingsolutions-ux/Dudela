---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SpitUpBanner from "../components/SpitUpBanner.astro";
import { episodes, slugify, SPOTIFY_URL, YOUTUBE_URL, APPLE_URL, TOTAL_EPISODES } from "../data/episodes.js";

function formatDate(d) {
  return new Date(d + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

const platforms = [
  { key: "podbean", label: "Podbean" },
  { key: "apple", label: "Apple Podcasts" },
  { key: "spotify", label: "Spotify" },
  { key: "youtube", label: "YouTube" },
];
---
<BaseLayout title="The Dudela Podcast" description="John & Mike, unfiltered. Every episode of The Dudela Podcast — listen on Podbean, Apple Podcasts, Spotify, or YouTube.">
  <Nav />

  <section class="page-hero section-dark">
    <div class="container">
      <p class="eyebrow">The Dudela Podcast</p>
      <h1>John &amp; Mike, unfiltered.</h1>
      <p class="hero-sub">New episode every other Tuesday.</p>
      <div class="follow-row">
        <span class="follow-label">Follow the show:</span>
        <a href={APPLE_URL} target="_blank" rel="noopener" class="follow-link">Apple Podcasts</a>
        <a href={SPOTIFY_URL} target="_blank" rel="noopener" class="follow-link">Spotify</a>
        <a href={YOUTUBE_URL} target="_blank" rel="noopener" class="follow-link">YouTube</a>
      </div>
    </div>
  </section>

  <section class="episode-list section-light">
    <div class="container">
      <div class="episodes">
        {episodes.map((ep, i) => (
          <div class="episode-row" id={slugify(ep.title)}>
            <img src={ep.img} alt={ep.title} class="episode-thumb" loading="lazy" />
            <div class="episode-info">
              {/* Counts DOWN from the real, confirmed episode number
                  (TOTAL_EPISODES) by this row's position in the newest-first
                  array — same math as the homepage's ghost numeral. Accurate
                  for the recent episodes; older rows may drift by a few
                  since this file is missing several early, never-transcribed
                  episodes (see the header comment above the `episodes`
                  export) — accepted tradeoff per 2026-08-18 conversation. */}
              <h3>Episode {TOTAL_EPISODES - i}: {ep.title}</h3>
              <p class="episode-date">{formatDate(ep.date)}</p>
              <div class="episode-links">
                <a href={ep.link} target="_blank" rel="noopener" class="listen-link">Podbean</a>
                <a href={ep.apple} target="_blank" rel="noopener" class="listen-link">Apple</a>
                <a href={SPOTIFY_URL} target="_blank" rel="noopener" class="listen-link">Spotify</a>
                <a href={ep.youtube || YOUTUBE_URL} target="_blank" rel="noopener" class="listen-link">YouTube</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="episode-note">
        Apple and Podbean links go straight to that episode. Spotify and YouTube link to the show —
        we're still working on exact episode links for those two.
      </p>
    </div>
  </section>

  <section class="podcast-cta section-light">
    <div class="container podcast-cta-inner">
      <p class="eyebrow">What's Next</p>
      <h2>Enough listening. What do you actually need right now?</h2>
      <p class="body-text">
        If you're just getting started, the free guide is the place to go. If you want real,
        1:1 access to John and Mike instead of another episode, that's The Turn.
      </p>
      <div class="podcast-cta-actions">
        <a href="/guide" class="btn btn-ghost podcast-cta-ghost">Get the Free Dad Prep Guide</a>
        <a href="/turn" class="btn btn-primary">Apply for The Turn</a>
      </div>
    </div>
  </section>

  <SpitUpBanner />

  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 9rem 0 3.5rem;
  }
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin: 0.5rem 0 0.75rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin: 0 0 1.25rem;
  }
  .follow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .follow-label {
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
  }
  .follow-link {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cream-100);
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--forest-600);
    border-radius: 999px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .follow-link:hover {
    border-color: var(--amber-500);
    background: var(--forest-700);
  }
  .episode-list {
    padding: var(--space-6) 0;
  }
  .episodes {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .episode-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-on-light);
    scroll-margin-top: 6rem;
  }
  .episode-row:target {
    animation: episode-highlight 2s ease;
  }
  @keyframes episode-highlight {
    0%, 100% { background: transparent; }
    20% { background: var(--bg-light-raised); }
  }
  .episode-thumb {
    width: 140px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .episode-info h3 {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0 0 0.3rem;
  }
  .episode-date {
    font-size: 0.85rem;
    color: var(--text-on-light-muted);
    margin: 0 0 0.6rem;
  }
  .episode-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .listen-link {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--forest-800);
    border: 1px solid var(--border-light);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .listen-link:hover {
    border-color: var(--forest-800);
  }
  .episode-note {
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--text-on-light-muted);
  }
  .podcast-cta {
    padding: var(--space-6) 0;
    text-align: center;
  }
  .podcast-cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }
  .podcast-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    margin: 0.5rem 0 1rem;
  }
  .podcast-cta .body-text {
    color: var(--text-on-light-muted);
    margin: 0 auto 1.75rem;
  }
  .podcast-cta-actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .podcast-cta-ghost {
    color: var(--text-on-light);
  }
</style>
