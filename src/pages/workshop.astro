---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { WORKSHOP_DATES, WORKSHOP_PRICE, WORKSHOP_TIME, WORKSHOP_MIN_DADS, WORKSHOP_MAX_DADS } from "../data/workshop";
// Replaced the old "Steady Dad — Fall Cohort Waitlist" page 2026-10-16.
// Dates live in src/data/workshop.ts. Past dates are hidden client-side
// (this page is prerendered), and the checkout route rejects them too.
---
<BaseLayout title="The Dudela Workshop — Live with John & Mike — Dudela" description={`A live 90-minute small-group workshop on Zoom for expecting dads. First Thursday of every month, ${WORKSHOP_TIME}. ${WORKSHOP_PRICE}.`}>
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">The Dudela Workshop</p>
      <h1>Build your plan with dads who get it.</h1>
      <p class="hero-sub">
        90 minutes, live on Zoom, with John and Mike and a handful of other expecting dads.
        You bring the questions you've been carrying around. You leave with a plan you and your
        partner can actually use.
      </p>
      <p class="hero-meta">First Thursday of every month &middot; {WORKSHOP_TIME} &middot; {WORKSHOP_PRICE}</p>
      <a href="#dates" class="btn btn-primary">Pick your date</a>
    </div>
  </section>

  <section class="details section-light">
    <div class="container details-grid">
      <div><h3>Small on purpose</h3><p>{WORKSHOP_MIN_DADS} to {WORKSHOP_MAX_DADS} dads. Not a webinar. Everyone talks, everyone gets heard.</p></div>
      <div><h3>Built on the Prep Kit</h3><p>We work through the same six pillars: your head, your money, your partner, the birth, the dad you want to be, and the first days home.</p></div>
      <div><h3>Real dads, real stories</h3><p>John's twins spent a month in the NICU. Mike's birth plan changed in 90 seconds. We'll tell you what we wish we'd known.</p></div>
    </div>
  </section>

  <section class="dates section-light" id="dates">
    <div class="container dates-inner">
      <p class="eyebrow">Upcoming sessions</p>
      <h2>Pick your Thursday.</h2>
      <p class="dates-sub">All sessions run {WORKSHOP_TIME} on Zoom. Your Zoom link and a short prep note arrive by email before the session.</p>
      <ul class="date-list">
        {WORKSHOP_DATES.map((d) => (
          <li class="date-row" data-iso={d.iso}>
            <div>
              <p class="date-label">{d.label}</p>
              <p class="date-time">{WORKSHOP_TIME} &middot; Zoom</p>
            </div>
            <a class="btn btn-primary" href={`/api/create-checkout-session?product=workshop&date=${d.iso}`}>Save my seat &middot; {WORKSHOP_PRICE}</a>
          </li>
        ))}
      </ul>
      <p class="no-dates" id="no-dates" hidden>New dates are on the way. Check back soon, or <a href="/guide">grab the free guide</a> in the meantime.</p>

      <div class="guarantee">
        <h3>Our small-group promise</h3>
        <p>
          A session runs once at least {WORKSHOP_MIN_DADS} dads are in. If yours doesn't fill, you choose:
          move to the next date, swap it for a 1:1 call with John or Mike, or get a full refund. No awkward
          half-empty room, no lost money.
        </p>
      </div>
    </div>
  </section>

  <section class="turn section-light">
    <div class="container">
      <p class="turn-note">
        Haven't grabbed the Prep Kit yet? <a href="/kit">Start there for $37 &rarr;</a><br />
        Want it fully 1:1? <a href="/turn">The Turn: 1:1 Coaching with John &amp; Mike &rarr;</a>
      </p>
    </div>
  </section>

  <script>
    // Hide sessions whose booking cutoff (5pm MT day-of) has passed.
    const rows = document.querySelectorAll<HTMLLIElement>(".date-row");
    let visible = 0;
    rows.forEach((row) => {
      const iso = row.dataset.iso;
      if (iso && new Date() >= new Date(`${iso}T17:00:00-07:00`)) row.remove();
      else visible++;
    });
    if (visible === 0) document.getElementById("no-dates")?.removeAttribute("hidden");
    if (new URLSearchParams(location.search).get("purchase") === "canceled") {
      document.getElementById("dates")?.scrollIntoView();
    }
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero { padding: 9rem 0 4rem; text-align: center; }
  .hero-inner { max-width: 600px; margin: 0 auto; }
  .hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3rem); margin: 0.5rem 0 1.25rem; }
  .hero-sub { color: var(--text-on-dark-muted); margin-bottom: 1rem; }
  .hero-meta { font-family: var(--font-label); color: var(--amber-500); font-size: 0.9rem; margin-bottom: 1.75rem; }
  .details { padding: var(--space-6) 0 0; }
  .details-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .details-grid h3 { font-family: var(--font-display); font-size: 1.2rem; margin: 0 0 0.5rem; }
  .details-grid p { color: var(--text-on-light-muted); margin: 0; font-size: 0.95rem; }
  .dates { padding: var(--space-6) 0; }
  .dates-inner { max-width: 720px; margin: 0 auto; }
  .dates h2 { font-family: var(--font-display); font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin: 0.4rem 0 0.6rem; }
  .dates-sub { color: var(--text-on-light-muted); margin: 0 0 1.5rem; }
  .date-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .date-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 1rem 1.25rem; border: 1px solid var(--border-light); border-radius: var(--radius-sm); }
  .date-label { font-family: var(--font-display); font-size: 1.15rem; margin: 0; }
  .date-time { font-family: var(--font-label); font-size: 0.85rem; color: var(--text-on-light-muted); margin: 0.2rem 0 0; }
  .no-dates { margin-top: 1rem; color: var(--text-on-light-muted); }
  .guarantee { margin-top: 2rem; padding: 1.25rem 1.5rem; border-left: 3px solid var(--rust-600); background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); }
  .guarantee h3 { font-family: var(--font-display); font-size: 1.1rem; margin: 0 0 0.4rem; }
  .guarantee p { margin: 0; color: var(--text-on-light-muted); font-size: 0.95rem; }
  .turn { padding: 0 0 var(--space-6); }
  .turn-note { padding-top: 1.75rem; border-top: 1px solid var(--border-light); font-family: var(--font-label); font-size: 0.9rem; color: var(--text-on-light-muted); text-align: center; line-height: 1.9; }
  .turn-note a { color: var(--rust-600); font-weight: 700; }
</style>
