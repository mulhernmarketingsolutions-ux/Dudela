---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getAuthedMember } from "../../lib/auth";
import { getEmbed } from "../../lib/embed";
import { NEXT_CALL } from "../../lib/next-call";
import { getMerchOrdersByEmail } from "../../lib/db";
import { getHatVariant, hatLabel, getShirtVariant, shirtLabel } from "../../lib/printful";

const env = (Astro.locals as any).runtime.env;
const member = await getAuthedMember(Astro.cookies, env);
if (!member) {
  return Astro.redirect("/member/login");
}

// "Your Orders" — every hat/shirt purchase tied to this email (see
// getMerchOrdersByEmail's comment in lib/db.ts for why it's email-matched
// rather than a member_id column). `color` is really "which HAT_CATALOG or
// SHIRT_CATALOG key", a holdover from when hats were the only merch
// product — resolve it to the real variant the same way the Stripe webhook's
// receipt copy does (getHatVariant/getShirtVariant), so the thumbnail,
// title, and "Order again" link can't drift out of sync with what the buyer
// actually bought. Title/subtitle are split out (rather than reusing the
// long single-line hatLabel()/shirtLabel() strings) so the card can show a
// short product name with the color/size/stitching detail underneath it,
// like a real order history line item.
const merchOrders = await getMerchOrdersByEmail(env, member.email);
const orders = merchOrders.map((o) => {
  const hat = getHatVariant(o.color);
  const shirt = hat ? undefined : getShirtVariant(o.color);

  let title = o.color;
  let subtitle = "";
  let image: string | null = null;
  let reorderHref = "/merch";

  if (hat) {
    title = hat.designLabel;
    subtitle = `${hat.colorLabel} · ${hat.threadLabel} Stitching${hat.addon ? " · Dude to Dad Stitch" : ""}`;
    image = hat.frontImage;
    reorderHref = "/merch#hats";
  } else if (shirt) {
    title = `${shirt.designLabel} Shirt`;
    subtitle = `${shirt.colorLabel} · Size ${shirt.size}`;
    image = shirt.frontImage;
    reorderHref = "/merch#shirts";
  }

  const price = typeof o.amount_total === "number" ? `$${(o.amount_total / 100).toFixed(2)}` : null;
  const dateLabel = new Date(o.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  return { id: o.id, title, subtitle, image, price, dateLabel, reorderHref };
});

const firstName = member.name ? member.name.split(" ")[0] : "there";
const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  "no-billing-account": "We don't have a billing account on file for you yet — email dude@thedudelaco.com and we'll sort it out.",
  portal: "Couldn't open the billing portal just now. Try again in a minute, or email dude@thedudelaco.com.",
};
const errorMessage = error ? errorMessages[error] || "" : "";

// Next live Q&A details now live in one shared file (lib/next-call.ts),
// reused by the join confirmation email and the join thank-you page too —
// update that one file, not this one, when a new call gets scheduled.
const nextCall = NEXT_CALL;

// Countdown text for the badge — computed per request since this page is
// already SSR (not prerendered), so it's always accurate without any client
// JS or a tick interval. Compares calendar dates (not raw ms) so "Today"/
// "Tomorrow" are right regardless of what time of day someone loads this.
const today = new Date();
today.setHours(0, 0, 0, 0);
const callDay = new Date(nextCall.date);
callDay.setHours(0, 0, 0, 0);
const daysUntilCall = Math.round((callDay.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
const countdownLabel =
  daysUntilCall <= 0 ? "Today" : daysUntilCall === 1 ? "Tomorrow" : `In ${daysUntilCall} days`;

// Welcome video from Mike & John, thanking new members for joining. Paste
// the real link in once it's filmed/uploaded (YouTube unlisted is easiest)
// — no admin UI for this one since it's a single fixed video, not a feed.
const welcomeVideo = {
  videoUrl: "",
  thumbnailUrl: "",
};
const welcomeEmbed = getEmbed(welcomeVideo.videoUrl);

// Feather-style stroke icons, same pattern used in Roadmap.astro — rendered
// via set:html since these are raw SVG strings, not components.
const ICONS = {
  mic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`,
  message: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  video: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`,
  card: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  play: `<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>`,
};
---
<BaseLayout title="Member Dashboard — Dudela" description="Your Spit-Up Society member area.">
  <Nav isAuthed />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Spit-Up Society</p>
      <h1>Hey {firstName}.</h1>
      {member.status === "canceled" ? (
        <p class="hero-sub status-canceled">
          Your membership lapsed, so some of this is on pause. Rejoin any time — <a href="/join/spit-up-society">$5/mo →</a>
        </p>
      ) : (
        <p class="hero-sub">You're an active member. Mike and John are both actually reading this stuff — here's everything in one place.</p>
      )}

      <div class="welcome-video" data-episode>
        {welcomeEmbed ? (
          <div class="video-media" data-media>
            <div class="video-thumb" data-thumb style={welcomeVideo.thumbnailUrl ? `background-image:url(${welcomeVideo.thumbnailUrl})` : ""}>
              {!welcomeVideo.thumbnailUrl && <div class="thumb-fallback" set:html={ICONS.video} />}
              <button type="button" class="play-btn" data-play aria-label="Play welcome video" set:html={ICONS.play}></button>
            </div>
            <div class="video-embed" data-embed hidden>
              {welcomeEmbed.kind === "file" ? (
                <video controls preload="none" src={welcomeEmbed.src}></video>
              ) : (
                <iframe
                  src=""
                  data-src={welcomeEmbed.src}
                  title="Welcome to the Spit-Up Society"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              )}
            </div>
          </div>
        ) : (
          // Real video isn't filmed yet — a real photo + a real note from
          // Mike & John beats a dashed "coming soon" box. Swap this whole
          // branch out once welcomeVideo.videoUrl above is filled in;
          // nothing else about the page needs to change.
          <div class="welcome-fallback">
            <img src="/images/IMG_3499_VSCO.JPG" alt="Mike and John" class="welcome-photo" />
            <p class="welcome-blurb">
              Hey — welcome. We're Mike and John, and we're genuinely glad you're here.
              We built this because we wished someone had built it for us. A real welcome
              video from the two of us is on its way — for now, just know we read
              everything that comes through here ourselves.
            </p>
          </div>
        )}
      </div>
      <p class="welcome-cta">New here? Once you've watched it, <a href="/member/community">tell us a bit about you →</a></p>
    </div>
  </section>

  <section class="grid section-light">
    <div class="container featured-row">
      <div class="card card-featured">
        <div class="featured-inner">
          <!-- A real calendar badge instead of the generic video icon — gives
               the card an actual visual anchor so the join button doesn't
               read as the only thing in a very wide, mostly-empty box. -->
          <div class="date-badge" aria-hidden="true">
            <span class="date-month">{nextCall.dateLabel.split(", ")[1]?.split(" ")[0] || "TBD"}</span>
            <span class="date-day">{nextCall.dateLabel.match(/\d+/)?.[0] || "?"}</span>
            <span class="date-weekday">{nextCall.dateLabel.split(",")[0]}</span>
          </div>
          <div class="featured-content">
            <p class="featured-eyebrow">
              <span set:html={ICONS.video} /> Next Live Q&amp;A
              <span class="countdown-inline">{countdownLabel}</span>
            </p>
            <h3>{nextCall.dateLabel}</h3>
            <p class="call-when">{nextCall.timeLabel}</p>
            <a href={nextCall.meetUrl} target="_blank" rel="noopener" class="btn btn-primary join-btn">Join with Google Meet →</a>
            <p class="call-dial">
              <span set:html={ICONS.phone} /> Or dial in: {nextCall.phone} <span class="pin">PIN {nextCall.pin}</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="container card-grid">
      <a href="/member/womb-watch" class="card">
        <div class="card-icon" set:html={ICONS.mic} />
        <h3>Womb Watch</h3>
        <p>Coming soon — one of our own community dads gives us a behind-the-scenes look at his pregnancy journey, week by week.</p>
        <span class="card-cta">Take a look →</span>
      </a>

      <a href="/member/community" class="card">
        <div class="card-icon" set:html={ICONS.users} />
        <h3>The Circle</h3>
        <p>Read one thing a few other dads in here have learned — then add yours for the next dad to read.</p>
        <span class="card-cta">Read a few →</span>
      </a>

      <a href="/member/ask" class="card">
        <div class="card-icon" set:html={ICONS.message} />
        <h3>Ask Us Anything</h3>
        <p>No support ticket, no bot — Mike and John read every question themselves and answer real ones live first.</p>
        <span class="card-cta">Send a question →</span>
      </a>

      <a href={member.stripe_customer_id ? "/api/create-portal-session" : "/member/dashboard?error=no-billing-account"} class="card">
        <div class="card-icon" set:html={ICONS.card} />
        <h3>Manage Membership</h3>
        <p>Update your card, see billing history, or cancel — handled directly by Stripe.</p>
        <span class="card-cta">Open billing portal →</span>
      </a>
    </div>

    {errorMessage && <p class="dash-error container">{errorMessage}</p>}

    <div class="container orders-section">
      <h2 class="orders-heading">Your Orders</h2>
      {orders.length > 0 ? (
        <ul class="orders-list">
          {orders.map((o) => (
            <li class="order-row">
              <div class="order-thumb">
                {o.image ? (
                  <img src={o.image} alt={o.title} loading="lazy" />
                ) : (
                  <div class="order-thumb-fallback" aria-hidden="true">D</div>
                )}
              </div>
              <div class="order-info">
                <p class="order-title">{o.title}</p>
                {o.subtitle && <p class="order-subtitle">{o.subtitle}</p>}
                <p class="order-date">{o.dateLabel}</p>
              </div>
              <div class="order-actions">
                {o.price && <span class="order-price">{o.price}</span>}
                <a href={o.reorderHref} class="order-again-btn">Order again →</a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="orders-empty">
          Nothing yet — <a href="/merch">check out the hats &amp; shirts →</a>
        </p>
      )}
    </div>

    <div class="container logout-row">
      <a href="/api/auth/logout" class="logout-link">Log out</a>
    </div>
  </section>

  <script>
    // Click-to-play for the welcome video — same lazy-embed pattern used on
    // /member/womb-watch, just scoped to the single hero video here.
    document.querySelectorAll<HTMLElement>("[data-episode]").forEach((card) => {
      const playBtn = card.querySelector<HTMLButtonElement>("[data-play]");
      const thumb = card.querySelector<HTMLElement>("[data-thumb]");
      const embedWrap = card.querySelector<HTMLElement>("[data-embed]");
      playBtn?.addEventListener("click", () => {
        const iframe = embedWrap?.querySelector<HTMLIFrameElement>("iframe[data-src]");
        if (iframe && !iframe.src) iframe.src = iframe.dataset.src || "";
        const video = embedWrap?.querySelector<HTMLVideoElement>("video");
        thumb?.setAttribute("hidden", "");
        embedWrap?.removeAttribute("hidden");
        video?.play().catch(() => {});
      });
    });
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 8rem 0 3.5rem;
  }
  .hero-inner {
    max-width: 640px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
  }
  .status-canceled a {
    color: var(--amber-500);
    font-weight: 700;
    text-decoration: none;
  }
  .welcome-video {
    margin-top: 2rem;
    max-width: 480px;
  }
  .video-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-color: var(--forest-700);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .welcome-fallback {
    border-radius: var(--radius-md);
    background: var(--forest-700);
    border: 1px solid var(--forest-600);
    overflow: hidden;
  }
  .welcome-photo {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 25%;
    display: block;
  }
  .welcome-blurb {
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
    padding: 1rem 1.2rem 1.2rem;
  }
  .thumb-fallback {
    width: 40px;
    height: 40px;
    color: rgba(245, 239, 227, 0.3);
  }
  .thumb-fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  .play-btn {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(20, 24, 17, 0.55);
    border: 2px solid var(--cream-100);
    color: var(--cream-100);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .play-btn:hover {
    transform: scale(1.06);
    background: var(--amber-500);
    border-color: var(--amber-500);
  }
  .play-btn :global(svg) {
    width: 20px;
    height: 20px;
    margin-left: 3px;
  }
  .video-embed {
    width: 100%;
    height: 100%;
  }
  .video-embed iframe,
  .video-embed video {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #000;
  }
  .welcome-cta {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
  }
  .welcome-cta a {
    color: var(--amber-500);
    font-weight: 600;
    text-decoration: none;
  }
  .grid {
    padding: var(--space-5) 0 var(--space-6);
  }
  /* Centers the featured Q&A card at the same width as a single card in
     the grid below it, instead of stretching it across both columns —
     a card-grid-width card in a flex row centers itself for free. */
  .featured-row {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .card-featured {
    width: 100%;
  }
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .card {
    display: block;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--text-on-light);
    transition: transform 0.2s var(--ease-out), border-color 0.2s ease;
  }
  a.card:hover {
    transform: translateY(-2px);
    border-color: var(--amber-500);
  }
  .card-icon {
    width: 38px;
    height: 38px;
    padding: 0.55rem;
    margin-bottom: 0.9rem;
    border-radius: 50%;
    background: var(--forest-700);
    color: var(--amber-500);
  }
  .card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }
  .card p {
    color: var(--text-on-light-muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .card-cta {
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--rust-600);
  }
  .card-featured {
    background: var(--forest-800, #1c231a);
    border-color: var(--forest-600);
    color: var(--cream-100);
  }
  .card-featured h3 {
    color: var(--cream-100);
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }
  .featured-inner {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }
  /* A small torn-calendar-page badge — real visual content instead of a
     generic icon, so the wide featured card reads as "a scheduled event"
     rather than just a big empty box around a button. */
  .date-badge {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 84px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--cream-100);
    box-shadow: 0 8px 20px -8px rgba(0, 0, 0, 0.4);
  }
  /* Countdown as plain inline text next to the eyebrow, not a pinned/rotated
     chip — a previous version absolutely-positioned it on the badge corner
     and it ended up overlapping the "AUGUST" label instead of sitting
     cleanly next to it. Inline flow can't overlap anything and reflows fine
     on mobile regardless of how long the label text is ("Today" vs
     "In 23 days"). */
  .countdown-inline {
    background: var(--amber-500);
    color: var(--forest-900);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .date-month {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--rust-600);
    color: var(--cream-100);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0;
  }
  .date-day {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1.3;
    color: var(--forest-900);
  }
  .date-weekday {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
    padding-bottom: 0.45rem;
  }
  .featured-content {
    flex: 1;
    min-width: 0;
    max-width: 420px;
  }
  .featured-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber-500);
    margin: 0 0 0.5rem;
  }
  .featured-eyebrow :global(svg) {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .call-when {
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    margin-bottom: 1.1rem;
  }
  .join-btn {
    width: 100%;
    max-width: 320px;
    justify-content: center;
    margin-bottom: 1.1rem;
  }
  @media (max-width: 560px) {
    .featured-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .date-badge {
      width: 72px;
    }
    .join-btn {
      max-width: none;
    }
  }
  .call-dial {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-on-dark-muted);
    margin: 0;
  }
  .call-dial :global(svg) {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .pin {
    white-space: nowrap;
  }
  .dash-error {
    margin-top: 1.5rem;
    color: var(--rust-600);
    font-size: 0.9rem;
  }
  .orders-section {
    margin-top: 2.5rem;
  }
  .orders-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 0.9rem;
  }
  .orders-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .order-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
