---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getAuthedMember } from "../../lib/auth";

const env = (Astro.locals as any).runtime.env;
const member = await getAuthedMember(Astro.cookies, env);
if (member) {
  return Astro.redirect("/member/dashboard");
}

const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  "missing-token": "That link looks incomplete. Request a new one below.",
  expired: "That link's expired or was already used. Request a new one below.",
  server: "Something went wrong on our end. Try again in a minute.",
};
const errorMessage = error && error !== "not-a-member" ? errorMessages[error] || "Something went wrong. Try again." : "";
const notAMember = error === "not-a-member";
---
<BaseLayout title="Member Login — Dudela" description="Log into the Spit-Up Society member area.">
  <Nav />

  {notAMember ? (
    <section class="hero section-dark">
      <div class="container hero-inner">
        <p class="eyebrow">Spit-Up Society</p>
        <h1>That email isn't in the Spit-Up Society yet</h1>
        <p class="hero-sub">
          We couldn't find an active membership for that address — so there's nothing to log into yet.
          If that's not right, double check the email you joined with below. Otherwise, come on in.
        </p>

        <a href="/join/spit-up-society" class="btn btn-primary invite-cta">Join the Spit-Up Society &rarr;</a>

        <form class="login-form retry-form" id="login-form">
          <input type="email" name="email" placeholder="Try a different email" required />
          <button type="submit" class="btn btn-ghost">Send Me a Login Link</button>
        </form>
        <p id="login-form-status" class="form-status"></p>
      </div>
    </section>
  ) : (
    <section class="hero section-dark">
      <div class="container hero-inner">
        <p class="eyebrow">Spit-Up Society</p>
        <h1>Member Login</h1>
        <p class="hero-sub">
          Enter the email you joined with — we'll send you a one-click link, no password to remember.
        </p>

        {errorMessage && <p class="form-error">{errorMessage}</p>}

        <form class="login-form" id="login-form">
          <input type="email" name="email" placeholder="you@email.com" required />
          <button type="submit" class="btn btn-primary">Send Me a Login Link</button>
        </form>
        <p id="login-form-status" class="form-status"></p>

        <p class="hero-footnote">
          Not a member yet? <a href="/join/spit-up-society">Join the Spit-Up Society →</a>
        </p>
      </div>
    </section>
  )}

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const status = document.getElementById("login-form-status") as HTMLParagraphElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = "Sending…";
      try {
        const res = await fetch("/api/auth/request-link", { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          if (status) status.textContent = "Check your inbox — your login link is on its way.";
          form.reset();
        } else {
          if (status) status.textContent = data.error || "Something went wrong. Please try again.";
          btn.disabled = false;
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again.";
        btn.disabled = false;
      }
    });
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 6rem;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .hero-inner {
    max-width: 460px;
    margin: 0 auto;
    text-align: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 2rem;
  }
  .form-error {
    background: rgba(226, 125, 37, 0.12);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .login-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .login-form input {
    flex: 1;
    min-width: 220px;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
  }
  .form-status {
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    margin-top: 0.9rem;
    min-height: 1.2em;
  }
  .hero-footnote {
    margin-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--text-on-dark-muted);
  }
  .hero-footnote a {
    color: var(--amber-500);
    font-weight: 600;
    text-decoration: none;
  }
  .invite-cta {
    display: inline-flex;
    margin-bottom: 2.5rem;
  }
  .retry-form {
    padding-top: 1.75rem;
    border-top: 1px solid var(--forest-600);
  }
</style>
