---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getAuthedMember } from "../../lib/auth";
import { listCommunityNotes, getCommunityNoteByMemberId } from "../../lib/db";

const env = (Astro.locals as any).runtime.env;
const member = await getAuthedMember(Astro.cookies, env);
if (!member) {
  return Astro.redirect("/member/login");
}

const notes = await listCommunityNotes(env);
const myNote = await getCommunityNoteByMemberId(env, member.id);

// Kept intentionally broad and few — this is a quick "where are you at"
// tag for a bubble card, not the full 11-stage roadmap taxonomy used
// elsewhere on the site.
const STAGES = [
  { id: "expecting", label: "Expecting" },
  { id: "newborn", label: "Newborn (0–3mo)" },
  { id: "infant", label: "Infant (3–12mo)" },
  { id: "toddler", label: "Toddler (1–3yr)" },
  { id: "preschool", label: "Preschooler (3–5yr)" },
  { id: "school-age", label: "School Age (5+)" },
  { id: "multiple", label: "Multiple Kids" },
];
const stageLabel = (id: string | null) => STAGES.find((s) => s.id === id)?.label || id || "";

// Three accent tints cycling by index, so cards read as varied rather
// than one flat color — same three brand accents used everywhere else on
// the site (amber/rust/forest), just distributed across cards.
const TINTS = ["tint-amber", "tint-rust", "tint-forest"];
---
<BaseLayout title="The Circle — Dudela" description="A snapshot of the dads in the Spit-Up Society.">
  <Nav isAuthed />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Spit-Up Society</p>
      <h1>The Circle</h1>
      <p class="hero-sub">
        Not a group chat, not another feed to check. Real dads in the Society, sharing one
        thing they've learned — a few at a time, so it's actually easy to sit with — then add
        your own below for the next dad to read.
      </p>
      <a href="/member/dashboard" class="back-link">← Back to dashboard</a>
    </div>
  </section>

  <section class="bubble-section section-light">
    <div class="container">
      {notes.length === 0 ? (
        <p class="empty-state">Nobody's added their bubble yet — be the first below.</p>
      ) : (
        <div class="circle-wall">
          <p class="wall-label">
            A few dads at a time
            <span class="wall-count">{notes.length} in the Circle</span>
          </p>
          <div class="wall-viewport">
            <div
              class="wall-track"
              id="circle-wall"
              data-notes={JSON.stringify(
                notes.map((n, i) => ({
                  first: n.first_name,
                  city: n.city || "",
                  stage: n.dad_stage ? stageLabel(n.dad_stage) : "",
                  advice: n.advice,
                  tint: TINTS[i % TINTS.length],
                }))
              )}
            />
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="form-section section-dark">
    <div class="container form-inner">
      <h2>{myNote ? "Update your bubble" : "Add yours to the mix"}</h2>
      <p class="form-sub">
        Takes ten seconds. One sentence is plenty — the goal is a snapshot, not an essay.
      </p>

      <form class="note-form" id="note-form">
        <div class="row">
          <label>
            First name
            <input type="text" name="first_name" maxlength="40" required value={myNote?.first_name || member.name?.split(" ")[0] || ""} />
          </label>
          <label>
            <span>City <span class="hint">(optional)</span></span>
            <input type="text" name="city" maxlength="60" placeholder="Austin, TX" value={myNote?.city || ""} />
          </label>
        </div>
        <label>
          Dad stage
          <select name="dad_stage">
            <option value="">— Select —</option>
            {STAGES.map((s) => (
              <option value={s.id} selected={myNote?.dad_stage === s.id}>{s.label}</option>
            ))}
          </select>
        </label>
        <label>
          <span>One thing you've learned as a dad <span class="hint">(160 characters, keep it tight)</span></span>
          <textarea name="advice" rows="2" maxlength="160" required placeholder="Sleep when you can, but let the dishes wait.">{myNote?.advice || ""}</textarea>
        </label>
        <button type="submit" class="btn btn-primary">{myNote ? "Update My Bubble" : "Add My Bubble"}</button>
      </form>
      <p id="note-form-status" class="form-status"></p>
    </div>
  </section>

  <script>
    // "A few dads at a time" carousel — replaces the earlier ambient field
    // (15+ bubbles at once, too fast to read), the one-at-a-time spotlight
    // (readable, but a slow single-file crawl through 29 notes), and the
    // staggered-slot version (readable, but static/grid-like — John wanted
    // continuous motion, like a carousel spinning by, with cards fading in
    // and out at the edges rather than popping in place).
    //
    // This is a continuous horizontal marquee: the note list is rendered
    // twice back-to-back into one flex track, which is animated from
    // translateX(0) to translateX(-50%) — since the second copy is an exact
    // duplicate of the first, the moment it scrolls fully into the first
    // copy's starting position the loop is seamless (no jump, no reset).
    // The viewport masks its left/right edges to transparent, so cards fade
    // in/out smoothly as they cross rather than clipping abruptly.
    const wall = document.getElementById("circle-wall");
    if (wall) {
      type WallNote = { first: string; city: string; stage: string; advice: string; tint: string };
      const notes: WallNote[] = JSON.parse(wall.dataset.notes || "[]");
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function renderBubble(note: WallNote): string {
        const initial = (note.first.charAt(0) || "?").toUpperCase();
        const cityPart = note.city ? ` &middot; ${note.city}` : "";
        const stagePart = note.stage ? `<span class="bubble-stage">${note.stage}</span>` : "";
        return `<div class="bubble ${note.tint}">
          <div class="bubble-head">
            <span class="bubble-avatar">${initial}</span>
            <div class="bubble-headtext">
              <p class="bubble-who">${note.first}${cityPart}</p>
              ${stagePart}
            </div>
          </div>
          <p class="bubble-advice">&ldquo;${note.advice}&rdquo;</p>
        </div>`;
      }

      const cardsHtml = notes.map(renderBubble).join("");

      if (prefersReducedMotion || notes.length < 2) {
        // No motion — just lay every card out in a wrapping row so nothing
        // is lost for people who've asked for reduced motion (or the rare
        // one-note case, where a scrolling loop of one card would be silly).
        wall.innerHTML = cardsHtml;
        wall.classList.add("is-static");
      } else {
        // Two back-to-back copies is what makes the loop seamless.
        wall.innerHTML = cardsHtml + cardsHtml;
        requestAnimationFrame(() => {
          const singleSetWidth = wall.scrollWidth / 2;
          const PX_PER_SECOND = 40; // constant visual speed regardless of note count
          const duration = Math.max(18, singleSetWidth / PX_PER_SECOND);
          wall.style.setProperty("--wall-duration", `${duration}s`);
          wall.classList.add("is-animating");
        });
      }
    }

    const form = document.getElementById("note-form") as HTMLFormElement | null;
    const status = document.getElementById("note-form-status") as HTMLParagraphElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = "Saving…";
      try {
        const res = await fetch("/api/member/community", { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          if (status) status.textContent = "Saved — refreshing the mix…";
          setTimeout(() => window.location.reload(), 600);
        } else {
          if (status) status.textContent = data.error || "Something went wrong. Please try again.";
          btn.disabled = false;
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again.";
        btn.disabled = false;
      }
    });
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 8rem 0 3rem;
  }
  .hero-inner {
    max-width: 640px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.5vw, 2.9rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.5rem;
  }
  .back-link {
    color: var(--amber-500);
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 600;
  }

  .bubble-section {
    padding: var(--space-5) 0;
  }
  .empty-state {
    color: var(--text-on-light-muted);
    text-align: center;
  }
  /* "A few dads at a time" — a continuous horizontal carousel (see the
     <script> above for how the seamless loop works) instead of the earlier
     ambient overlapping field (lively, but 15+ cards fading too fast to
     read), one-at-a-time spotlight (readable, but a slow single-file crawl
     through 29 notes), or staggered-slot grid (readable, but static — no
     motion at all). */
  .circle-wall {
    max-width: 1100px;
    margin: 0 auto;
  }
  .wall-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
    margin-bottom: 1rem;
  }
  /* Masks the left/right edges of the carousel to transparent, so cards
     fade in and out smoothly as they cross the boundary instead of being
     abruptly clipped by overflow:hidden. */
  .wall-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }
  .wall-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
  }
  .wall-track.is-animating {
    animation: wall-scroll var(--wall-duration, 30s) linear infinite;
  }
  /* Pausing on hover/focus so a card can actually be read mid-scroll if
     someone wants to stop and look — the loop resumes exactly where it
     left off since this only pauses the animation, it doesn't reset it. */
  .wall-track.is-animating:hover,
  .wall-track.is-animating:focus-within {
    animation-play-state: paused;
  }
  @keyframes wall-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* :global() on every .bubble* selector below — these elements are built
     client-side via document.createElement/innerHTML (see the <script>
     above), and Astro's scoped-style hashing only touches elements present
     in the compiled template at build time. Without :global() here, none of
     this card styling (background, border, shadow, avatar circle color)
     applies to the rotating content at all — it was rendering as plain
     unstyled text. Same root cause as the merch-page photo-pair bug fixed
     earlier this session. */
  :global(.bubble) {
    flex: 0 0 320px;
    width: 320px;
    padding: 1.5rem 1.6rem;
    border-radius: 18px 18px 18px 4px;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
    box-shadow: 0 10px 28px -10px rgba(28, 35, 25, 0.28);
    text-align: left;
  }
  :global(.bubble-head) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.75rem;
  }
  :global(.bubble-avatar) {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--cream-100);
  }
  :global(.tint-amber .bubble-avatar) {
    background: var(--amber-500);
  }
  :global(.tint-rust .bubble-avatar) {
    background: var(--rust-600);
  }
  :global(.tint-forest .bubble-avatar) {
    background: var(--forest-500);
  }
  :global(.bubble-headtext) {
    min-width: 0;
  }
  :global(.bubble-who) {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0;
    color: var(--text-on-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.bubble-stage) {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
  }
  :global(.bubble-advice) {
    font-size: 1.05rem;
    color: var(--text-on-light);
    margin: 0;
    line-height: 1.55;
  }
  .wall-count {
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    opacity: 0.75;
  }
  @media (max-width: 640px) {
    .circle-wall {
      max-width: 100%;
    }
    :global(.bubble) {
      flex-basis: 260px;
      width: 260px;
      padding: 1.25rem 1.35rem;
    }
    :global(.bubble-advice) {
      font-size: 1rem;
    }
  }
  /* Static (reduced-motion / single-note) fallback lays cards out in a
     wrapping row instead of one continuous unscrollable line. */
  .wall-track.is-static {
    flex-wrap: wrap;
    justify-content: center;
  }

  .form-section {
    padding: var(--space-5) 0 var(--space-6);
  }
  .form-inner {
    max-width: 560px;
  }
  .form-inner h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    margin: 0 0 0.5rem;
  }
  .form-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
    font-size: 0.95rem;
  }
  .note-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .row label {
    flex: 1;
    min-width: 180px;
  }
  .note-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cream-100);
  }
  .hint {
    font-weight: 400;
    opacity: 0.65;
    text-transform: none;
    letter-spacing: normal;
  }
  .note-form input,
  .note-form select,
  .note-form textarea {
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    resize: vertical;
  }
  .note-form button {
    align-self: flex-start;
    margin-top: 0.4rem;
  }
  .form-status {
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    margin-top: 0.9rem;
    min-height: 1.2em;
  }
</style>
