---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getAuthedMember } from "../../lib/auth";
import { listCommunityNotes, getCommunityNoteByMemberId } from "../../lib/db";

const env = (Astro.locals as any).runtime.env;
const member = await getAuthedMember(Astro.cookies, env);
if (!member) {
  return Astro.redirect("/member/login");
}

const notes = await listCommunityNotes(env);
const myNote = await getCommunityNoteByMemberId(env, member.id);

// Kept intentionally broad and few — this is a quick "where are you at"
// tag for a bubble card, not the full 11-stage roadmap taxonomy used
// elsewhere on the site.
const STAGES = [
  { id: "expecting", label: "Expecting" },
  { id: "newborn", label: "Newborn (0–3mo)" },
  { id: "infant", label: "Infant (3–12mo)" },
  { id: "toddler", label: "Toddler (1–3yr)" },
  { id: "preschool", label: "Preschooler (3–5yr)" },
  { id: "school-age", label: "School Age (5+)" },
  { id: "multiple", label: "Multiple Kids" },
];
const stageLabel = (id: string | null) => STAGES.find((s) => s.id === id)?.label || id || "";

// Three accent tints cycling by index, so the bubble field reads as varied
// rather than one flat color — same three brand accents used everywhere
// else on the site (amber/rust/forest), just distributed across cards.
const TINTS = ["tint-amber", "tint-rust", "tint-forest"];

// Hand-picked positions (left%/top%) spread across the field so bubbles
// don't clump in the middle — cycles if there are more notes than slots.
// Kept safely inside 0–100 (unlike the old roaming version) since these
// bubbles pop in and out in place rather than traveling around.
const SLOTS: [number, number][] = [
  [2, 2], [26, 6], [50, 0], [74, 8], [4, 28],
  [30, 32], [56, 26], [80, 34], [2, 56],
  [28, 60], [54, 54], [78, 62], [8, 82],
  [34, 84], [58, 80], [80, 86], [46, 36], [16, 8],
];
---
<BaseLayout title="The Circle — Dudela" description="A snapshot of the dads in the Spit-Up Society.">
  <Nav />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Spit-Up Society</p>
      <h1>The Circle</h1>
      <p class="hero-sub">
        Not a group chat, not another feed to check — just a snapshot of who else is in this with you.
        Every bubble is a real dad in the Society: first name, where he's from, what stage he's in,
        and one thing he's learned. Add yours below.
      </p>
      <a href="/member/dashboard" class="back-link">← Back to dashboard</a>
    </div>
  </section>

  <section class="bubble-section section-light">
    <div class="container">
      {notes.length === 0 ? (
        <p class="empty-state">Nobody's added their bubble yet — be the first below.</p>
      ) : (
        <div class="bubble-field">
          {notes.map((note, i) => {
            const [left, top] = SLOTS[i % SLOTS.length];
            const duration = 9 + (i % 5) * 1.6; // 9–15.4s full pop cycle, varies per bubble
            const delay = -(i % 11) * 1.3; // negative delay so each starts mid-cycle — a staggered feed, not a synchronized flash
            const initial = note.first_name.charAt(0).toUpperCase();
            return (
              <div
                class={`bubble ${TINTS[i % TINTS.length]}`}
                style={`left: ${left}%; top: ${top}%; animation-duration: ${duration}s; animation-delay: ${delay}s;`}
              >
                <div class="bubble-head">
                  <span class="bubble-avatar">{initial}</span>
                  <div class="bubble-headtext">
                    <p class="bubble-who">
                      {note.first_name}{note.city ? ` · ${note.city}` : ""}
                    </p>
                    {note.dad_stage && <span class="bubble-stage">{stageLabel(note.dad_stage)}</span>}
                  </div>
                </div>
                <p class="bubble-advice">&ldquo;{note.advice}&rdquo;</p>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <section class="form-section section-dark">
    <div class="container form-inner">
      <h2>{myNote ? "Update your bubble" : "Add yours to the mix"}</h2>
      <p class="form-sub">
        Takes ten seconds. One sentence is plenty — the goal is a snapshot, not an essay.
      </p>

      <form class="note-form" id="note-form">
        <div class="row">
          <label>
            First name
            <input type="text" name="first_name" maxlength="40" required value={myNote?.first_name || member.name?.split(" ")[0] || ""} />
          </label>
          <label>
            City <span class="hint">(optional)</span>
            <input type="text" name="city" maxlength="60" placeholder="Austin, TX" value={myNote?.city || ""} />
          </label>
        </div>
        <label>
          Dad stage
          <select name="dad_stage">
            <option value="">— Select —</option>
            {STAGES.map((s) => (
              <option value={s.id} selected={myNote?.dad_stage === s.id}>{s.label}</option>
            ))}
          </select>
        </label>
        <label>
          One thing you've learned as a dad <span class="hint">(160 characters, keep it tight)</span>
          <textarea name="advice" rows="2" maxlength="160" required placeholder="Sleep when you can, but let the dishes wait.">{myNote?.advice || ""}</textarea>
        </label>
        <button type="submit" class="btn btn-primary">{myNote ? "Update My Bubble" : "Add My Bubble"}</button>
      </form>
      <p id="note-form-status" class="form-status"></p>
    </div>
  </section>

  <script>
    const form = document.getElementById("note-form") as HTMLFormElement | null;
    const status = document.getElementById("note-form-status") as HTMLParagraphElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = "Saving…";
      try {
        const res = await fetch("/api/member/community", { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          if (status) status.textContent = "Saved — refreshing the mix…";
          setTimeout(() => window.location.reload(), 600);
        } else {
          if (status) status.textContent = data.error || "Something went wrong. Please try again.";
          btn.disabled = false;
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again.";
        btn.disabled = false;
      }
    });
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 8rem 0 3rem;
  }
  .hero-inner {
    max-width: 640px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.5vw, 2.9rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.5rem;
  }
  .back-link {
    color: var(--amber-500);
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 600;
  }

  .bubble-section {
    padding: var(--space-5) 0;
  }
  .empty-state {
    color: var(--text-on-light-muted);
    text-align: center;
  }
  .bubble-field {
    position: relative;
    height: 560px;
    max-width: 100%;
  }
  /* Chat/comment-card style instead of the old organic blob: a rounded
     card with a squared-off bottom-left corner (the classic "message
     bubble" tell), a colored avatar initial, and a soft drop shadow so it
     reads as a card floating above the page — like a comment or
     notification popping in, not a cell drifting around. */
  .bubble {
    position: absolute;
    width: 240px;
    padding: 1rem 1.2rem;
    border-radius: 18px 18px 18px 4px;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
    box-shadow: 0 10px 28px -10px rgba(28, 35, 25, 0.28);
    text-align: left;
    opacity: 0;
    transform: scale(0.6) translateY(14px);
    animation-name: pop-in;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  /* Pop in with a little overshoot, hold so it's actually readable, then
     fade back out and wait off-cycle before popping in again — the
     "someone just commented" rhythm rather than continuous movement. */
  @keyframes pop-in {
    0% {
      opacity: 0;
      transform: scale(0.6) translateY(14px);
    }
    8% {
      opacity: 1;
      transform: scale(1.05) translateY(0);
    }
    14% {
      transform: scale(1) translateY(0);
    }
    72% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    88% {
      opacity: 0;
      transform: scale(0.88) translateY(-8px);
    }
    100% {
      opacity: 0;
      transform: scale(0.6) translateY(14px);
    }
  }
  .bubble-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }
  .bubble-avatar {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--cream-100);
  }
  .tint-amber .bubble-avatar {
    background: var(--amber-500);
  }
  .tint-rust .bubble-avatar {
    background: var(--rust-600);
  }
  .tint-forest .bubble-avatar {
    background: var(--forest-500);
  }
  .bubble-headtext {
    min-width: 0;
  }
  .bubble-who {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.85rem;
    margin: 0;
    color: var(--text-on-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bubble-stage {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
  }
  .bubble-advice {
    font-size: 0.85rem;
    color: var(--text-on-light);
    margin: 0;
    line-height: 1.45;
  }
  @media (max-width: 640px) {
    .bubble-field {
      height: 880px;
    }
    .bubble {
      width: 200px;
      padding: 0.9rem 1.05rem;
    }
  }

  .form-section {
    padding: var(--space-5) 0 var(--space-6);
  }
  .form-inner {
    max-width: 560px;
  }
  .form-inner h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    margin: 0 0 0.5rem;
  }
  .form-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
    font-size: 0.95rem;
  }
  .note-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .row label {
    flex: 1;
    min-width: 180px;
  }
  .note-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cream-100);
  }
  .hint {
    font-weight: 400;
    opacity: 0.65;
    text-transform: none;
    letter-spacing: normal;
  }
  .note-form input,
  .note-form select,
  .note-form textarea {
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    resize: vertical;
  }
  .note-form button {
    align-self: flex-start;
    margin-top: 0.4rem;
  }
  .form-status {
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    margin-top: 0.9rem;
    min-height: 1.2em;
  }
</style>
