---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getAuthedMember } from "../../lib/auth";
import { listCommunityNotes, getCommunityNoteByMemberId } from "../../lib/db";

const env = (Astro.locals as any).runtime.env;
const member = await getAuthedMember(Astro.cookies, env);
if (!member) {
  return Astro.redirect("/member/login");
}

const notes = await listCommunityNotes(env);
const myNote = await getCommunityNoteByMemberId(env, member.id);

// Kept intentionally broad and few — this is a quick "where are you at"
// tag for a bubble card, not the full 11-stage roadmap taxonomy used
// elsewhere on the site.
const STAGES = [
  { id: "expecting", label: "Expecting" },
  { id: "newborn", label: "Newborn (0–3mo)" },
  { id: "infant", label: "Infant (3–12mo)" },
  { id: "toddler", label: "Toddler (1–3yr)" },
  { id: "preschool", label: "Preschooler (3–5yr)" },
  { id: "school-age", label: "School Age (5+)" },
  { id: "multiple", label: "Multiple Kids" },
];
const stageLabel = (id: string | null) => STAGES.find((s) => s.id === id)?.label || id || "";

// Three accent tints cycling by index, so cards read as varied rather
// than one flat color — same three brand accents used everywhere else on
// the site (amber/rust/forest), just distributed across cards.
const TINTS = ["tint-amber", "tint-rust", "tint-forest"];
---
<BaseLayout title="The Circle — Dudela" description="A snapshot of the dads in the Spit-Up Society.">
  <Nav isAuthed />

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Spit-Up Society</p>
      <h1>The Circle</h1>
      <p class="hero-sub">
        Not a group chat, not another feed to check. Read one thing a few real dads in the
        Society have learned — one at a time, so it's actually easy to sit with — then add
        your own below for the next dad to read.
      </p>
      <a href="/member/dashboard" class="back-link">← Back to dashboard</a>
    </div>
  </section>

  <section class="bubble-section section-light">
    <div class="container">
      {notes.length === 0 ? (
        <p class="empty-state">Nobody's added their bubble yet — be the first below.</p>
      ) : (
        <div class="spotlight">
          <p class="spotlight-label">
            One dad at a time
            <span class="spotlight-counter"><span id="spotlight-current">1</span> of {notes.length}</span>
          </p>
          <div class="spotlight-viewport" id="spotlight-viewport">
            {notes.map((note, i) => {
              const initial = note.first_name.charAt(0).toUpperCase();
              return (
                <div class={`bubble ${TINTS[i % TINTS.length]}`} data-index={i}>
                  <div class="bubble-head">
                    <span class="bubble-avatar">{initial}</span>
                    <div class="bubble-headtext">
                      <p class="bubble-who">
                        {note.first_name}{note.city ? ` · ${note.city}` : ""}
                      </p>
                      {note.dad_stage && <span class="bubble-stage">{stageLabel(note.dad_stage)}</span>}
                    </div>
                  </div>
                  <p class="bubble-advice">&ldquo;{note.advice}&rdquo;</p>
                </div>
              );
            })}
          </div>
          {notes.length > 1 && (
            <div class="spotlight-controls">
              <button type="button" class="spotlight-btn" id="spotlight-prev" aria-label="Previous dad">&larr;</button>
              {notes.length <= 8 && (
                <div class="spotlight-dots" id="spotlight-dots">
                  {notes.map((_, i) => (
                    <button type="button" class="spotlight-dot" data-index={i} aria-label={`Go to dad ${i + 1}`}></button>
                  ))}
                </div>
              )}
              <button type="button" class="spotlight-btn" id="spotlight-next" aria-label="Next dad">&rarr;</button>
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="form-section section-dark">
    <div class="container form-inner">
      <h2>{myNote ? "Update your bubble" : "Add yours to the mix"}</h2>
      <p class="form-sub">
        Takes ten seconds. One sentence is plenty — the goal is a snapshot, not an essay.
      </p>

      <form class="note-form" id="note-form">
        <div class="row">
          <label>
            First name
            <input type="text" name="first_name" maxlength="40" required value={myNote?.first_name || member.name?.split(" ")[0] || ""} />
          </label>
          <label>
            City <span class="hint">(optional)</span>
            <input type="text" name="city" maxlength="60" placeholder="Austin, TX" value={myNote?.city || ""} />
          </label>
        </div>
        <label>
          Dad stage
          <select name="dad_stage">
            <option value="">— Select —</option>
            {STAGES.map((s) => (
              <option value={s.id} selected={myNote?.dad_stage === s.id}>{s.label}</option>
            ))}
          </select>
        </label>
        <label>
          One thing you've learned as a dad <span class="hint">(160 characters, keep it tight)</span>
          <textarea name="advice" rows="2" maxlength="160" required placeholder="Sleep when you can, but let the dishes wait.">{myNote?.advice || ""}</textarea>
        </label>
        <button type="submit" class="btn btn-primary">{myNote ? "Update My Bubble" : "Add My Bubble"}</button>
      </form>
      <p id="note-form-status" class="form-status"></p>
    </div>
  </section>

  <script>
    // One-card-at-a-time spotlight — replaces the old ambient overlapping
    // field. That version looked lively but crammed 15+ animated cards
    // into one viewport, which on a phone-width screen meant nothing was
    // actually readable. The whole point of this section is "read one
    // thing a few dads have learned," so only ever show one, with
    // prev/next, dots, swipe, and a slow auto-advance.
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#spotlight-viewport .bubble"));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".spotlight-dot"));
    const counterEl = document.getElementById("spotlight-current");
    const prevBtn = document.getElementById("spotlight-prev");
    const nextBtn = document.getElementById("spotlight-next");
    const viewport = document.getElementById("spotlight-viewport");

    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function show(i: number) {
      if (!cards.length) return;
      current = ((i % cards.length) + cards.length) % cards.length;
      cards.forEach((c, idx) => c.classList.toggle("is-current", idx === current));
      dots.forEach((d, idx) => d.classList.toggle("is-current", idx === current));
      if (counterEl) counterEl.textContent = String(current + 1);
    }

    function restartAutoAdvance() {
      if (timer) clearInterval(timer);
      if (cards.length > 1) {
        timer = setInterval(() => show(current + 1), 6000);
      }
    }

    if (cards.length) {
      show(0);
      restartAutoAdvance();
    }

    prevBtn?.addEventListener("click", () => {
      show(current - 1);
      restartAutoAdvance();
    });
    nextBtn?.addEventListener("click", () => {
      show(current + 1);
      restartAutoAdvance();
    });
    dots.forEach((d) => {
      d.addEventListener("click", () => {
        show(Number(d.dataset.index || 0));
        restartAutoAdvance();
      });
    });

    let touchStartX = 0;
    viewport?.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true }
    );
    viewport?.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) {
          show(current + (dx < 0 ? 1 : -1));
          restartAutoAdvance();
        }
      },
      { passive: true }
    );

    const form = document.getElementById("note-form") as HTMLFormElement | null;
    const status = document.getElementById("note-form-status") as HTMLParagraphElement | null;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (status) status.textContent = "Saving…";
      try {
        const res = await fetch("/api/member/community", { method: "POST", body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          if (status) status.textContent = "Saved — refreshing the mix…";
          setTimeout(() => window.location.reload(), 600);
        } else {
          if (status) status.textContent = data.error || "Something went wrong. Please try again.";
          btn.disabled = false;
        }
      } catch {
        if (status) status.textContent = "Something went wrong. Please try again.";
        btn.disabled = false;
      }
    });
  </script>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 8rem 0 3rem;
  }
  .hero-inner {
    max-width: 640px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.5vw, 2.9rem);
    margin: 0.5rem 0 1rem;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.5rem;
  }
  .back-link {
    color: var(--amber-500);
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 600;
  }

  .bubble-section {
    padding: var(--space-5) 0;
  }
  .empty-state {
    color: var(--text-on-light-muted);
    text-align: center;
  }
  /* One card at a time — the whole point of this section is "read one
     thing a few dads have learned," not an ambient wall of chat bubbles.
     The old overlapping animated field looked lively but on a phone-width
     screen it crammed 15+ cards on top of each other and nothing was
     readable. This is deliberately boring and clear instead: a single
     card, prev/next + dots + swipe, slow auto-advance. */
  .spotlight {
    max-width: 460px;
    margin: 0 auto;
  }
  .spotlight-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
    margin-bottom: 1rem;
  }
  .spotlight-counter {
    font-variant-numeric: tabular-nums;
  }
  .spotlight-viewport {
    position: relative;
    min-height: 190px;
  }
  /* Same chat/comment-card look as before (rounded card, squared-off
     bottom-left corner, colored avatar initial, soft drop shadow) — just
     shown one at a time instead of scattered and animated. */
  .bubble {
    display: none;
    width: 100%;
    padding: 1.5rem 1.6rem;
    border-radius: 18px 18px 18px 4px;
    background: var(--bg-light-raised);
    border: 1px solid var(--border-light);
    box-shadow: 0 10px 28px -10px rgba(28, 35, 25, 0.28);
    text-align: left;
  }
  .bubble.is-current {
    display: block;
    animation: card-in 0.35s ease;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .bubble-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.75rem;
  }
  .bubble-avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--cream-100);
  }
  .tint-amber .bubble-avatar {
    background: var(--amber-500);
  }
  .tint-rust .bubble-avatar {
    background: var(--rust-600);
  }
  .tint-forest .bubble-avatar {
    background: var(--forest-500);
  }
  .bubble-headtext {
    min-width: 0;
  }
  .bubble-who {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0;
    color: var(--text-on-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bubble-stage {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-light-muted);
  }
  .bubble-advice {
    font-size: 1.05rem;
    color: var(--text-on-light);
    margin: 0;
    line-height: 1.55;
  }
  .spotlight-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .spotlight-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-light);
    background: var(--bg-light-raised);
    color: var(--text-on-light);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .spotlight-btn:hover {
    background: var(--border-light);
  }
  .spotlight-dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 220px;
  }
  .spotlight-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--border-light);
    cursor: pointer;
    padding: 0;
  }
  .spotlight-dot.is-current {
    background: var(--forest-500);
  }
  @media (max-width: 640px) {
    .spotlight {
      max-width: 100%;
    }
    .bubble {
      padding: 1.25rem 1.35rem;
    }
    .bubble-advice {
      font-size: 1rem;
    }
  }

  .form-section {
    padding: var(--space-5) 0 var(--space-6);
  }
  .form-inner {
    max-width: 560px;
  }
  .form-inner h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    margin: 0 0 0.5rem;
  }
  .form-sub {
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
    font-size: 0.95rem;
  }
  .note-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .row label {
    flex: 1;
    min-width: 180px;
  }
  .note-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cream-100);
  }
  .hint {
    font-weight: 400;
    opacity: 0.65;
    text-transform: none;
    letter-spacing: normal;
  }
  .note-form input,
  .note-form select,
  .note-form textarea {
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    resize: vertical;
  }
  .note-form button {
    align-self: flex-start;
    margin-top: 0.4rem;
  }
  .form-status {
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
    margin-top: 0.9rem;
    min-height: 1.2em;
  }
</style>
