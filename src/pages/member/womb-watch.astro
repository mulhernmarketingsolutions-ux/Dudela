---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PreviewBanner from "../../components/PreviewBanner.astro";
import { getViewingMember } from "../../lib/auth";
import { listPosts, getReactionCounts, getMemberReactions, listComments } from "../../lib/db";
import { getEmbed, toRelativeMediaUrl } from "../../lib/embed";

const env = (Astro.locals as any).runtime.env;
const viewing = await getViewingMember(Astro.cookies, env);
if (!viewing) {
  return Astro.redirect("/member/login");
}
const { member, isPreview } = viewing;

const posts = await listPosts(env, "womb-watch");

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
}
function formatShortDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric" });
}
function parseWeekNumber(label: string | null) {
  if (!label) return null;
  const m = label.match(/\d+/);
  return m ? parseInt(m[0], 10) : null;
}
function commentCountLabel(n: number) {
  if (n === 0) return "Be the first to comment";
  return n === 1 ? "1 comment" : `${n} comments`;
}
// Two-letter monogram for the avatar chips. Comment author names are
// stored first-name-only (see /api/member/womb-watch-comment.ts), so this
// is almost always just the first two letters of that name.
function initials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
}
// Up to 3 most-recent, de-duplicated commenters — powers the little avatar
// stack on the comment-toggle pill so a card with activity in it visibly
// shows "people are already here" before anyone clicks to expand.
function recentAuthors(comments: { author_name: string }[]) {
  const seen: string[] = [];
  for (let i = comments.length - 1; i >= 0; i--) {
    const name = comments[i].author_name;
    if (!seen.includes(name)) seen.push(name);
    if (seen.length === 3) break;
  }
  return seen;
}
// Splits a post body into a punchy lead line (the hook, always shown) and
// everything after it (collapsed by default behind "Keep reading"). Nothing
// gets cut — if no sentence break turns up in the first ~160 characters,
// the whole body just renders as the hook with no toggle at all.
function splitHook(body: string | null) {
  const trimmed = (body || "").trim();
  if (!trimmed) return { hook: "", rest: "" };
  const match = trimmed.match(/^([\s\S]{0,160}?[.!?])(\s+|$)([\s\S]*)$/);
  if (match && match[3] && match[3].trim()) {
    return { hook: match[1].trim(), rest: match[3].trim() };
  }
  return { hook: trimmed, rest: "" };
}

// Three fixed reaction kinds — keep this list in sync with VALID_REACTIONS
// in /api/member/womb-watch-react.ts. A member can toggle any/all of them
// independently per episode.
const REACTIONS = [
  { id: "been-there", emoji: "😅", label: "Been there" },
  { id: "needed-this", emoji: "🙌", label: "Needed this" },
  { id: "same-boat", emoji: "💪", label: "Same boat" },
];

// N small DB round-trips per post (counts, my-reactions, comments) rather
// than one hand-rolled dynamic IN-clause query — post volume here is
// episodes (currently 5, capped by real pregnancy weeks at ~40), not
// comments-on-comments, so this stays cheap. Revisit with batched queries
// if Womb Watch ever needs a real activity-feed scale.
const episodes = await Promise.all(
  posts.map(async (post) => {
    const embed = getEmbed(post.video_url);
    const thumb = toRelativeMediaUrl(post.thumbnail_url);
    const weekNumber = parseWeekNumber(post.week_label);
    const [counts, myReactions, comments] = await Promise.all([
      getReactionCounts(env, post.id),
      getMemberReactions(env, post.id, member.id),
      listComments(env, post.id),
    ]);
    return { post, embed, thumb, weekNumber, counts, myReactions, comments };
  })
);

const TOTAL_WEEKS = 40;
const byWeek = new Map<number, (typeof episodes)[number]>();
for (const ep of episodes) {
  if (ep.weekNumber) byWeek.set(ep.weekNumber, ep);
}
const latestWeek = episodes.reduce((max, ep) => (ep.weekNumber && ep.weekNumber > max ? ep.weekNumber : max), 0);
const progressPct = latestWeek > 0 ? Math.min(100, (latestWeek / TOTAL_WEEKS) * 100) : 0;
const timelineWeeks = Array.from({ length: TOTAL_WEEKS }, (_, i) => i + 1).map((week) => ({
  week,
  episode: byWeek.get(week) || null,
}));

// Feather-style stroke icons, same pattern as Roadmap.astro — rendered via
// set:html below since these are raw SVG strings, not components.
const ICONS = {
  mic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>`,
  play: `<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>`,
  close: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  send: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>`,
  chevron: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>`,
};

// Data the client script needs to run the lightbox — id -> playable source.
// Astro escapes the JSON string fine inside a script tag via set:html since
// JSON.stringify never emits an unescaped "</script>" for this data shape.
const episodesData = episodes.map(({ post, embed }) => ({
  id: post.id,
  title: post.title,
  kind: embed?.kind || null,
  src: embed?.src || null,
  poster: toRelativeMediaUrl(post.thumbnail_url),
}));
---
<BaseLayout
  title="Womb Watch — Dudela"
  description="Follow Mike & Abigail's pregnancy week by week — real talk, no script, exclusively for Spit-Up Society members."
>
  <Nav isAuthed />
  {isPreview && <PreviewBanner member={member} />}

  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Spit-Up Society</p>
      <span class="segment-tag">🎙️ Straight from co-founder Mike</span>
      <h1>Womb Watch</h1>
      <p class="hero-sub">
        Week by week, real-time — from our own co-founder. Mike and Abigail are mid-pregnancy
        and he's telling you exactly what's going on — the good, the queasy, the "we're having
        a girl again." He's done this before, and he's still not faking his way through it.
        Nothing polished, nothing scripted.
      </p>
      <p class="hero-note">You're already subscribed — new episodes land in your inbox the second they drop.</p>
      <a href="/member/dashboard" class="back-link">← Back to dashboard</a>
    </div>
  </section>

  {episodes.length === 0 ? (
    <section class="posts section-light">
      <div class="container posts-inner">
        <p class="empty-state">Nothing posted yet — check back soon.</p>
      </div>
    </section>
  ) : (
    <Fragment>
      <section class="timeline section-light">
        <div class="container">
          <p class="eyebrow">Follow the journey</p>
          <h2>Week by Week</h2>
          <p class="timeline-sub">
            Every episode drops right where it happened in the pregnancy. Scroll the timeline, or
            just read down below.
          </p>

          <div class="track-wrap">
            <div class="track" id="ww-track">
              <div class="track-line"></div>
              <div class="track-fill" style={`width:${progressPct}%`}></div>
              {timelineWeeks.map(({ week, episode }) => {
                const playable = episode && episode.embed && episode.embed.kind !== "link";
                const linkOnly = episode && episode.embed && episode.embed.kind === "link";
                if (episode && playable) {
                  return (
                    <button
                      type="button"
                      class="stop stop-episode"
                      data-open-lightbox
                      data-episode-id={episode.post.id}
                      aria-label={`Play: ${episode.post.title}`}
                    >
                      <span
                        class="stop-thumb"
                        style={episode.thumb ? `background-image:url(${episode.thumb})` : ""}
                      >
                        {!episode.thumb && <span class="stop-thumb-fallback" set:html={ICONS.mic} />}
                        <span class="stop-play" set:html={ICONS.play} />
                      </span>
                      <span class="stop-week">Wk {week}</span>
                    </button>
                  );
                }
                if (episode && linkOnly) {
                  return (
                    <a class="stop stop-episode" href={episode.embed!.src} target="_blank" rel="noopener">
                      <span class="stop-thumb">
                        <span class="stop-thumb-fallback" set:html={ICONS.doc} />
                      </span>
                      <span class="stop-week">Wk {week}</span>
                    </a>
                  );
                }
                if (episode) {
                  return (
                    <a class="stop stop-episode" href={`#ep-${episode.post.id}`}>
                      <span class="stop-thumb">
                        <span class="stop-thumb-fallback" set:html={ICONS.doc} />
                      </span>
                      <span class="stop-week">Wk {week}</span>
                    </a>
                  );
                }
                return (
                  <span class="stop stop-empty" class:list={{ "stop-past": week <= latestWeek }}>
                    <span class="stop-dot"></span>
                    <span class="stop-week">{week}</span>
                  </span>
                );
              })}
            </div>
            <div class="track-fade" id="ww-track-fade" aria-hidden="true"></div>
            <div class="scroll-hint" id="ww-scroll-hint" aria-hidden="true">
              <span class="scroll-hint-arrow">&rarr;</span>
            </div>
          </div>
        </div>
      </section>

      <section class="posts section-light">
        <div class="container posts-inner">
          <div class="episode-feed">
            {episodes.map(({ post, embed, thumb, counts, myReactions, comments }) => {
              const playable = embed && embed.kind !== "link";
              const linkOnly = embed && embed.kind === "link";
              const { hook, rest } = splitHook(post.body);
              const restParagraphs = rest ? rest.split(/\n+/).filter(Boolean) : [];
              const chips = recentAuthors(comments);
              return (
                <article class="ep-card" id={`ep-${post.id}`}>
                  <div class="ep-media">
                    {playable ? (
                      <button type="button" class="ep-thumb" data-open-lightbox data-episode-id={post.id} aria-label={`Play ${post.title}`}>
                        <span class="ep-thumb-img" style={thumb ? `background-image:url(${thumb})` : ""}>
                          {!thumb && <span class="ep-thumb-fallback" set:html={ICONS.mic} />}
                        </span>
                        <span class="ep-play" set:html={ICONS.play} />
                        {post.week_label && <span class="week-badge">{post.week_label}</span>}
                      </button>
                    ) : linkOnly ? (
                      <a class="ep-thumb ep-thumb-static" href={embed!.src} target="_blank" rel="noopener">
                        <span class="ep-thumb-img" style={thumb ? `background-image:url(${thumb})` : ""}>
                          {!thumb && <span class="ep-thumb-fallback" set:html={ICONS.doc} />}
                        </span>
                        {post.week_label && <span class="week-badge">{post.week_label}</span>}
                        <span class="watch-link">Watch here ↗</span>
                      </a>
                    ) : (
                      <div class="ep-thumb ep-thumb-static">
                        <span class="ep-thumb-img" style={thumb ? `background-image:url(${thumb})` : ""}>
                          {!thumb && <span class="ep-thumb-fallback" set:html={ICONS.doc} />}
                        </span>
                        {post.week_label && <span class="week-badge">{post.week_label}</span>}
                      </div>
                    )}
                  </div>

                  <div class="ep-body">
                    <p class="ep-date">{formatDate(post.published_at)}</p>
                    <h2>{post.title}</h2>

                    <div class="ep-text">
                      <p class="ep-hook">{hook}</p>
                      {rest && (
                        <>
                          <div class="ep-rest" data-ep-rest hidden>
                            {restParagraphs.map((para) => (
                              <p>{para}</p>
                            ))}
                          </div>
                          <button type="button" class="ep-toggle" data-ep-toggle>
                            Keep reading →
                          </button>
                        </>
                      )}
                    </div>

                    <div class="ep-interact">
                      <div class="reaction-row" data-reactions data-post-id={post.id}>
                        {REACTIONS.map((r) => (
                          <button
                            type="button"
                            class="reaction-btn"
                            class:list={{ active: myReactions.has(r.id) }}
                            data-reaction={r.id}
                            title={r.label}
                            disabled={isPreview}
                          >
                            <span class="reaction-emoji">{r.emoji}</span>
                            <span class="reaction-label">{r.label}</span>
                            <span class="reaction-count" data-count>{counts[r.id] || 0}</span>
                          </button>
                        ))}
                      </div>

                      <button
                        type="button"
                        class="comment-toggle"
                        data-comment-toggle
                        aria-expanded="false"
                        aria-controls={`comments-${post.id}`}
                      >
                        {chips.length > 0 && (
                          <span class="avatar-stack" aria-hidden="true">
                            {chips.map((name) => (
                              <span class="avatar">{initials(name)}</span>
                            ))}
                          </span>
                        )}
                        <span class="comment-toggle-icon" set:html={ICONS.chat} />
                        <span data-comment-count>{commentCountLabel(comments.length)}</span>
                        <span class="comment-toggle-chevron" set:html={ICONS.chevron} />
                      </button>
                    </div>

                    <div class="ep-comments" data-comments id={`comments-${post.id}`} hidden>
                      {comments.length > 0 && (
                        <div class="comment-list" data-comment-list class:list={{ "is-collapsed": comments.length > 1 }}>
                          {comments.length > 1 && (
                            <button type="button" class="comment-expand" data-comment-expand>
                              See all {comments.length} comments
                            </button>
                          )}
                          {comments.map((c) => (
                            <div class="comment">
                              <span class="comment-avatar" aria-hidden="true">{initials(c.author_name)}</span>
                              <div class="comment-body">
                                <p class="comment-meta">
                                  <span class="comment-author">{c.author_name}</span>
                                  <span class="comment-date">{formatShortDate(c.created_at)}</span>
                                </p>
                                <p class="comment-text">{c.body}</p>
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                      {isPreview ? (
                        <p class="preview-note">Commenting is disabled while previewing.</p>
                      ) : (
                        <form class="comment-form" data-comment-form data-post-id={post.id}>
                          <textarea placeholder="Relate hard? Got a question for Mike? Drop it here." maxlength="600" required></textarea>
                          <button type="submit" class="comment-send" aria-label="Post comment">
                            <span set:html={ICONS.send} />
                          </button>
                        </form>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    </Fragment>
  )}

  <div class="lightbox" id="ww-lightbox" hidden>
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-panel">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close" set:html={ICONS.close}></button>
      <p class="lightbox-title" id="ww-lightbox-title"></p>
      <div class="lightbox-video" id="ww-lightbox-video"></div>
    </div>
  </div>

  <script type="application/json" id="ww-episodes-data" set:html={JSON.stringify(episodesData)} />

  <script>
    // --- Lightbox: click any thumbnail (timeline or library card) to play,
    // instead of the old inline-swap that could shove page text out of the
    // way. A single overlay is reused for every episode rather than one
    // player per card. ---
    const episodesData: Array<{ id: string; title: string; kind: string | null; src: string | null; poster: string | null }> =
      JSON.parse(document.getElementById("ww-episodes-data")?.textContent || "[]");
    const byId = new Map(episodesData.map((e) => [e.id, e]));

    const lightbox = document.getElementById("ww-lightbox");
    const lightboxTitle = document.getElementById("ww-lightbox-title");
    const lightboxVideo = document.getElementById("ww-lightbox-video");

    function openLightbox(id: string) {
      const ep = byId.get(id);
      if (!ep || !lightbox || !lightboxTitle || !lightboxVideo) return;

      lightboxTitle.textContent = ep.title;
      lightboxVideo.innerHTML = "";

      if (ep.kind === "file" && ep.src) {
        const video = document.createElement("video");
        video.src = ep.src;
        video.controls = true;
        video.autoplay = true;
        // playsInline (both the property and the attribute) keeps mobile
        // Safari from hijacking playback into its own native fullscreen
        // player the instant .play() fires — without it, tapping play
        // covered the whole screen with an OS chrome that looked broken.
        video.playsInline = true;
        video.setAttribute("playsinline", "");
        if (ep.poster) video.poster = ep.poster;
        lightboxVideo.appendChild(video);
      } else if (ep.src) {
        const iframe = document.createElement("iframe");
        iframe.src = ep.src;
        iframe.title = ep.title;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        lightboxVideo.appendChild(iframe);
      }

      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightbox || !lightboxVideo) return;
      lightbox.hidden = true;
      lightboxVideo.innerHTML = ""; // stop playback rather than just hiding it
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLElement>("[data-open-lightbox]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        const id = el.dataset.episodeId;
        if (id) openLightbox(id);
      });
    });
    document.querySelectorAll<HTMLElement>("[data-lightbox-close]").forEach((el) => {
      el.addEventListener("click", closeLightbox);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeLightbox();
    });

    // --- Reactions: toggle on click, optimistic count update from the
    // server's { active } response. ---
    document.querySelectorAll<HTMLElement>("[data-reactions]").forEach((wrap) => {
      const postId = wrap.dataset.postId;
      wrap.querySelectorAll<HTMLButtonElement>("[data-reaction]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const reaction = btn.dataset.reaction;
          if (!reaction || !postId || btn.disabled) return;
          btn.disabled = true;
          try {
            const res = await fetch("/api/member/womb-watch-react", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ postId, reaction }),
            });
            const data = await res.json();
            if (data.ok) {
              const countEl = btn.querySelector("[data-count]");
              if (countEl) {
                const current = parseInt(countEl.textContent || "0", 10) || 0;
                countEl.textContent = String(Math.max(0, current + (data.active ? 1 : -1)));
              }
              btn.classList.toggle("active", !!data.active);
            }
          } catch (err) {
            console.error("Reaction failed", err);
          } finally {
            btn.disabled = false;
          }
        });
      });
    });

    // --- "Keep reading" toggle for the long-form part of a description. ---
    document.querySelectorAll<HTMLButtonElement>("[data-ep-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const rest = btn.closest(".ep-text")?.querySelector<HTMLElement>("[data-ep-rest]");
        if (!rest) return;
        const wasHidden = rest.hidden;
        rest.hidden = !wasHidden;
        btn.textContent = wasHidden ? "Show less" : "Keep reading →";
      });
    });

    // --- Comment panel: collapsed by default so a busy thread doesn't
    // stretch the card; the pill shows who's already talking. ---
    document.querySelectorAll<HTMLButtonElement>("[data-comment-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const panel = document.getElementById(btn.getAttribute("aria-controls") || "");
        if (!panel) return;
        const wasExpanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!wasExpanded));
        panel.hidden = wasExpanded;
        if (!wasExpanded) panel.querySelector<HTMLTextAreaElement>("textarea")?.focus();
      });
    });

    // --- Comment list: only the latest comment shows by default (the
    // "peek"); this reveals the rest. ---
    document.querySelectorAll<HTMLButtonElement>("[data-comment-expand]").forEach((btn) => {
      btn.addEventListener("click", () => {
        btn.closest(".comment-list")?.classList.remove("is-collapsed");
        btn.remove();
      });
    });

    // --- Comments: post via fetch, append to the list without a reload. ---
    function escapeHtml(str: string) {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    function initialsClient(name: string) {
      const parts = name.trim().split(/\s+/).filter(Boolean);
      if (parts.length === 0) return "?";
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + parts[1][0]).toUpperCase();
    }

    document.querySelectorAll<HTMLFormElement>("[data-comment-form]").forEach((form) => {
      const postId = form.dataset.postId;
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const textarea = form.querySelector<HTMLTextAreaElement>("textarea");
        const body = textarea?.value.trim();
        if (!body || !postId) return;
        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        try {
          const res = await fetch("/api/member/womb-watch-comment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ postId, body }),
          });
          const data = await res.json();
          if (data.ok) {
            const card = form.closest(".ep-card");
            const commentsWrap = form.closest("[data-comments]");
            let list = commentsWrap?.querySelector<HTMLElement>("[data-comment-list]");
            if (!list && commentsWrap) {
              list = document.createElement("div");
              list.className = "comment-list";
              list.setAttribute("data-comment-list", "");
              commentsWrap.insertBefore(list, form);
            }
            if (list) {
              const div = document.createElement("div");
              div.className = "comment";
              div.innerHTML = `<span class="comment-avatar" aria-hidden="true">${escapeHtml(
                initialsClient(data.comment.authorName)
              )}</span><div class="comment-body"><p class="comment-meta"><span class="comment-author">${escapeHtml(
                data.comment.authorName
              )}</span><span class="comment-date">${escapeHtml(data.comment.date)}</span></p><p class="comment-text">${escapeHtml(
                data.comment.body
              )}</p></div>`;
              list.appendChild(div);
              const expandBtn = list.querySelector<HTMLButtonElement>("[data-comment-expand]");
              if (expandBtn) expandBtn.textContent = `See all ${list.querySelectorAll(".comment").length} comments`;
            }
            if (textarea) textarea.value = "";
            const countLabel = card?.querySelector("[data-comment-count]");
            if (countLabel) {
              const n = list?.querySelectorAll(".comment").length || 0;
              countLabel.textContent = n === 1 ? "1 comment" : `${n} comments`;
            }
          } else {
            alert(data.error || "Something went wrong. Please try again.");
          }
        } catch (err) {
          console.error("Comment failed", err);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });

    // --- Timeline scroll-hint, same one-time "peek" pattern as Roadmap.astro ---
    const track = document.getElementById("ww-track");
    const scrollHint = document.getElementById("ww-scroll-hint");
    const trackFade = document.getElementById("ww-track-fade");

    function hideHint() {
      scrollHint?.classList.add("hint-hidden");
      trackFade?.classList.add("hint-hidden");
    }

    if (track) {
      if (track.scrollWidth <= track.clientWidth + 4) {
        hideHint();
      } else {
        track.addEventListener(
          "scroll",
          () => {
            hideHint();
          },
          { passive: true, once: true }
        );
        // Scroll near the current week by default so a member returning
        // mid-series lands on "now" instead of week 1 every time.
        const activeStop = track.querySelector(".stop-episode:last-of-type") as HTMLElement | null;
        if (activeStop) {
          setTimeout(() => activeStop.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" }), 300);
        }
      }
    }
  </script>

  <Footer />
</BaseLayout>

