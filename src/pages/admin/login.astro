---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdminAuthed } from "../../lib/auth";

const env = (Astro.locals as any).runtime.env;
const authed = await isAdminAuthed(Astro.cookies, env);
if (authed) {
  return Astro.redirect("/admin");
}

const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  "wrong-password": "Wrong password.",
  "not-configured": "ADMIN_PASSWORD isn't set yet — run `wrangler secret put ADMIN_PASSWORD`.",
};
const errorMessage = error ? errorMessages[error] || "Something went wrong." : "";
---
<BaseLayout title="Admin Login — Dudela" description="">
  <section class="hero section-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Dudela Admin</p>
      <h1>Admin Login</h1>
      {errorMessage && <p class="form-error">{errorMessage}</p>}
      <form class="login-form" method="POST" action="/api/admin/login">
        <input type="password" name="password" placeholder="Password" required autofocus />
        <button type="submit" class="btn btn-primary">Log In</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .hero-inner {
    max-width: 400px;
    margin: 0 auto;
    text-align: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.5rem 0 1.75rem;
  }
  .form-error {
    background: rgba(226, 125, 37, 0.12);
    border: 1px solid var(--amber-500);
    color: var(--cream-100);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .login-form input {
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-700);
    color: var(--cream-100);
    font-family: var(--font-sans);
  }
</style>
