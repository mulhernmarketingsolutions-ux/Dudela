---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { isAdminAuthed, PREVIEW_MEMBER_COOKIE } from "../../lib/auth";
import { HAT_CATALOG, SHIRT_CATALOG, hatLabel, shirtLabel } from "../../lib/printful";
import { listActiveMembers, getMemberById } from "../../lib/db";

// Real admin home page — didn't exist before. /admin/login used to dump
// straight into /admin/womb-watch because Womb Watch posting was the only
// admin tool that existed when that page was built. Everything added since
// (hat/shirt order testing, mockup regeneration, Printful debug endpoints)
// only had raw URLs, nothing linking to them. This page is that missing
// front door — /api/admin/login.ts and /admin/login.astro both redirect
// here now instead of straight to Womb Watch.
const env = (Astro.locals as any).runtime.env;
const authed = await isAdminAuthed(Astro.cookies, env);
if (!authed) {
  return Astro.redirect("/admin/login");
}

// "Preview as a subscriber" — lets Mike/John see exactly what a real member
// sees (Womb Watch, dashboard, the rest of /member/*) without logging out
// of admin or logging into a separate member account. See getViewingMember
// in lib/auth.ts for how the member-facing pages pick this up, and
// /api/admin/preview.ts for the start/stop endpoint this panel links to.
const previewMembers = await listActiveMembers(env);
const previewingId = Astro.cookies.get(PREVIEW_MEMBER_COOKIE)?.value;
const previewingMember = previewingId ? await getMemberById(env, previewingId) : null;
---
<BaseLayout title="Admin — Dudela" description="">
  <section class="admin-shell">
    <div class="container admin-inner">
      <div class="admin-header">
        <p class="eyebrow">Dudela Admin</p>
        <h1>Admin</h1>
        <a href="/api/admin/logout" class="logout-link">Log out</a>
      </div>

      <p class="section-label">Content</p>

      <div class="panel panel-preview">
        <h2>Preview as a subscriber</h2>
        {previewingMember ? (
          <>
            <p class="panel-sub">
              You're currently previewing as <strong>{previewingMember.name || previewingMember.email}</strong>.
              Every member page shows exactly what they see (interactions are turned off) until you exit.
            </p>
            <a href="/api/admin/preview?exit=1" class="btn btn-primary">Exit preview</a>
          </>
        ) : previewMembers.length === 0 ? (
          <p class="panel-sub">No active Spit-Up Society members yet — this fills in once someone joins.</p>
        ) : (
          <>
            <p class="panel-sub">
              Pick a real member and see the member area exactly as they see it — no separate login, no
              guessing. Read-only: reactions and comments are disabled while previewing.
            </p>
            <div class="tester-row">
              <select id="preview-select">
                {previewMembers.map((m) => (
                  <option value={m.id}>{m.name ? `${m.name} — ${m.email}` : m.email}</option>
                ))}
              </select>
              <a id="preview-go" href="#" class="btn btn-ghost">Preview as this member</a>
            </div>
          </>
        )}
      </div>

      <div class="panel">
        <h2>Womb Watch</h2>
        <p class="panel-sub">Post a new update or manage existing ones.</p>
        <a href="/admin/womb-watch" class="btn btn-primary">Open Womb Watch posting</a>
      </div>

      <p class="section-label">Merch order testing</p>

      <div class="panel">
        <p class="panel-sub">
          Places a real Printful order for the picked color/size using the exact code the live site
          uses, but leaves it as an unconfirmed draft — free, no charge. Open Printful → Orders to
          check it, then delete the draft. Add <code>&confirm=1</code> to a link below to actually
          confirm it into production instead — a real charge, same as a live order.
        </p>
        <div class="tester-row">
          <span class="tester-label">Hat</span>
          <select id="hat-select">
            {HAT_CATALOG.map((h) => (
              <option value={h.key}>{hatLabel(h)}</option>
            ))}
          </select>
          <a id="hat-go" href="#" class="btn btn-ghost" target="_blank" rel="noopener">Create test draft</a>
        </div>
        <div class="tester-row">
          <span class="tester-label">Shirt</span>
          <select id="shirt-select">
            {SHIRT_CATALOG.map((s) => (
              <option value={s.key}>{shirtLabel(s)}</option>
            ))}
          </select>
          <a id="shirt-go" href="#" class="btn btn-ghost" target="_blank" rel="noopener">Create test draft</a>
        </div>
      </div>

      <details class="panel panel-advanced">
        <summary>Advanced / debug tools</summary>
        <div class="advanced-body">
          <div class="advanced-group">
            <h3>Printful / mockup debug tools</h3>
            <p class="panel-sub">Read-only or idempotent — safe to open. Mostly useful when adding a new product or troubleshooting mockups.</p>
            <ul class="tool-list">
              <li><a href="/api/admin/printful-debug?all=1" target="_blank" rel="noopener">List every published Printful product</a> — name, color, sync_variant_id, mockup URL for each.</li>
              <li><a href="/api/admin/printful-debug" target="_blank" rel="noopener">Raw sync/products list</a></li>
              <li><a href="/api/admin/mockups" target="_blank" rel="noopener">Hat mockup regeneration tool</a> — pass <code>?start=1</code> to kick off, <code>?poll=&lt;keys&gt;</code> to check status.</li>
              <li><a href="/api/admin/mockups-shirt" target="_blank" rel="noopener">Shirt mockup regeneration tool</a> — same pattern, superseded by the real Printful dashboard renders currently live on /merch.</li>
            </ul>
          </div>
          <div class="advanced-group">
            <h3>Shipping tracking emails</h3>
            <p class="panel-sub">
              One-time setup so buyers get a real Dudela-branded email with tracking info when their order ships
              (Printful fires a webhook to us; before this existed, the receipt's "we'll email you when it ships" line wasn't backed by anything).
              Requires the <code>PRINTFUL_WEBHOOK_TOKEN</code> secret to be set first — run
              <code>wrangler secret put PRINTFUL_WEBHOOK_TOKEN</code> (any random string) if it isn't yet.
            </p>
            <ul class="tool-list">
              <li><a href="/api/admin/printful-webhook-setup" target="_blank" rel="noopener">Register this site with Printful</a> — safe to re-run any time the URL or token changes.</li>
            </ul>
          </div>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>

<script>
  function wireTester(selectId: string, goId: string, endpoint: string) {
    const select = document.getElementById(selectId) as HTMLSelectElement | null;
    const go = document.getElementById(goId) as HTMLAnchorElement | null;
    if (!select || !go) return;
    function update() {
      go!.href = `${endpoint}?color=${encodeURIComponent(select!.value)}`;
    }
    select.addEventListener("change", update);
    update();
  }
  wireTester("hat-select", "hat-go", "/api/admin/test-hat-order");
  wireTester("shirt-select", "shirt-go", "/api/admin/test-shirt-order");

  const previewSelect = document.getElementById("preview-select") as HTMLSelectElement | null;
  const previewGo = document.getElementById("preview-go") as HTMLAnchorElement | null;
  if (previewSelect && previewGo) {
    const updatePreview = () => {
      previewGo.href = `/api/admin/preview?memberId=${encodeURIComponent(previewSelect.value)}`;
    };
    previewSelect.addEventListener("change", updatePreview);
    updatePreview();
  }
</script>

<style>
  .admin-shell {
    min-height: 100vh;
    padding: 4rem 0 6rem;
  }
  .admin-inner {
    max-width: 760px;
  }
  .admin-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .section-label {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin: 2.25rem 0 0.85rem;
  }
  .section-label:first-of-type {
    margin-top: 0;
  }
  .admin-header h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0.25rem 1rem 0 0;
  }
  .logout-link {
    margin-left: auto;
    color: var(--text-on-dark-muted);
    font-size: 0.85rem;
  }
  .panel {
    background: var(--forest-700);
    border: 1px solid var(--forest-600);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
  }
  .panel h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
  .panel-sub {
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    margin: 0 0 1rem;
    max-width: 60ch;
  }
  .panel-hint {
    color: var(--text-on-dark-muted);
    font-size: 0.8rem;
    margin: 0.75rem 0 0;
  }
  .panel-hint code,
  .tool-list code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  .tester-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tester-row + .tester-row {
    margin-top: 0.85rem;
  }
  .tester-label {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-on-dark-muted);
    width: 42px;
    flex: 0 0 auto;
  }
  .tester-row select {
    flex: 1;
    min-width: 220px;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--forest-600);
    background: var(--forest-800, #101710);
    color: var(--cream-100);
    font-family: var(--font-sans);
  }
  .tool-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .tool-list a {
    color: var(--amber-500);
    font-weight: 600;
  }
  .panel-preview {
    border-color: var(--amber-500);
  }

  /* Rarely-touched engineering tools, tucked behind a native <details> so
     the page reads short and current-task-focused (Content, then Merch
     testing) by default — nothing here is hidden, just collapsed. */
  .panel-advanced {
    padding: 0;
    overflow: hidden;
  }
  .panel-advanced summary {
    padding: 1.1rem 1.75rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--cream-100);
    list-style: none;
  }
  .panel-advanced summary::-webkit-details-marker {
    display: none;
  }
  .panel-advanced summary::before {
    content: "▸";
    display: inline-block;
    margin-right: 0.6rem;
    color: var(--amber-500);
    transition: transform 0.15s ease;
  }
  .panel-advanced[open] summary::before {
    transform: rotate(90deg);
  }
  .panel-advanced[open] summary {
    border-bottom: 1px solid var(--forest-600);
  }
  .advanced-body {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .advanced-group h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    margin: 0 0 0.5rem;
    color: var(--cream-100);
  }
</style>
