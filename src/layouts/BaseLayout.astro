---
import "../styles/tokens.css";
import { episodes } from "../data/episodes.js";

export interface Props {
  title?: string;
  description?: string;
  // The SpeakPipe voicemail tab used to float on every single page — easy
  // to stumble into (it covered the checkout button on mobile /merch, see
  // merch.astro's bundle-bar z-index comment) and easy to forget it was
  // even there otherwise. Now it only renders where it's actually the
  // point: /voicemail ("Ask Another Dad"), which every other page already
  // links to directly (Footer, start-here, member/ask) instead of relying
  // on people noticing a floating tab.
  showVoicemailWidget?: boolean;
  // "article" for blog posts (adds og:type=article + published-time meta,
  // which is what tells Google/social crawlers/AI answer engines this is a
  // dated piece of content rather than a static marketing page). Defaults
  // to "website" for everything else.
  type?: "website" | "article";
  publishedTime?: string; // ISO 8601 (e.g. "2026-09"), article type only
  ogImage?: string; // absolute or root-relative override of the default OG image
  // Ad landing pages (e.g. /get-the-kit) set this so they don't compete with
  // the on-site pages in search results.
  noindex?: boolean;
}
const {
  title = "Dudela — Turning Dudes Into Dads",
  description = "Fatherhood doesn't come with instructions. Dudela is the roadmap, the community, and the confidence system for dads getting ready to become who their family needs.",
  showVoicemailWidget = false,
  type = "website",
  publishedTime,
  ogImage,
  noindex = false,
} = Astro.props;

const ogImageUrl = new URL(ogImage ?? "/og-image.jpg", Astro.site ?? Astro.url).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
// New-episode pulse: every link to /podcast gets a soft amber pulse on the
// day the newest episode drops and the day after (the every-other-Tuesday
// release, so Tuesday + Wednesday). Keyed off the newest date in
// episodes.js, so it turns on by itself whenever a new episode is added
// there, and off again two days later. Checked client-side in Mountain
// time because marketing pages are prerendered. Preview anytime with ?pulse=1.
const latestEpisodeDate = episodes[0]?.date ?? "";
---
<!doctype html>
<html lang="en" data-latest-episode={latestEpisodeDate}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var d = document.documentElement;
          var latest = d.getAttribute("data-latest-episode");
          var forced = /[?&]pulse=1\b/.test(location.search);
          if (!latest && !forced) return;
          var today = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Denver" }).format(new Date());
          var days = (Date.parse(today) - Date.parse(latest)) / 864e5;
          if (forced || (days >= 0 && days <= 1)) d.classList.add("new-episode-window");
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Stops iOS Safari from auto-detecting number-like sequences (dates,
         phone numbers, the "01" "02" stage/episode indices sprinkled all
         over this site) and rendering them as blue underlined links. -->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo/dudela-badge-green.png" />
    <link rel="apple-touch-icon" href="/logo/dudela-badge-green.png" />

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="Dudela" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      .new-episode-window a[href="/podcast"]:not(.btn) {
        position: relative;
      }
      .new-episode-window a[href="/podcast"]:not(.btn)::after {
        content: "";
        position: absolute;
        top: -0.15em;
        right: -0.6em;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--amber-500, #e27d25);
        animation: dudela-dot-pulse 1.8s ease-out infinite;
        pointer-events: none;
      }
      .new-episode-window a.btn[href="/podcast"] {
        animation: dudela-btn-pulse 2.2s ease-out infinite;
      }
      @keyframes dudela-dot-pulse {
        0% { box-shadow: 0 0 0 0 rgba(226, 125, 37, 0.7); }
        70% { box-shadow: 0 0 0 8px rgba(226, 125, 37, 0); }
        100% { box-shadow: 0 0 0 0 rgba(226, 125, 37, 0); }
      }
      @keyframes dudela-btn-pulse {
        0% { box-shadow: 0 0 0 0 rgba(226, 125, 37, 0.55); }
        70% { box-shadow: 0 0 0 12px rgba(226, 125, 37, 0); }
        100% { box-shadow: 0 0 0 0 rgba(226, 125, 37, 0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .new-episode-window a[href="/podcast"]:not(.btn)::after,
        .new-episode-window a.btn[href="/podcast"] { animation: none; }
      }
    </style>
    <!-- Meta Pixel (dataset "Dudela Website", ad account Dudela). Fires
         PageView on every page; InitiateCheckout fires from /kit and Purchase
         from /kit/thank-you. Added 2026-10-16 for the Prep Kit ad test. -->
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1645170497121257');
      fbq('track', 'PageView');
    </script>
    <!-- Microsoft Clarity (free heatmaps + session recordings), project "Dudela". Added 2026-10-16. -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yysy97bfvz");
    </script>
    <noscript><img height="1" width="1" style="display:none" alt=""
      src="https://www.facebook.com/tr?id=1645170497121257&ev=PageView&noscript=1" /></noscript>
  <!-- Keep the Meta ad click id (fbclid) as a first-party _fbc cookie, even
     when the pixel script is blocked, so server-side Purchases (lib/meta-capi.ts)
     still match back to the ad. Same format the pixel itself writes. -->
<script is:inline>(function(){try{var id=new URLSearchParams(location.search).get("fbclid");if(!id||/(^|; )_fbc=/.test(document.cookie))return;document.cookie="_fbc=fb.1."+Date.now()+"."+id+"; path=/; max-age=7776000; SameSite=Lax; Secure";}catch(e){}})();</script>
</head>
  <body>
    <slot />

    {showVoicemailWidget && (
      <!-- SpeakPipe — same voicemail widget used on the live site. Renders
           its own floating tab; no container div needed. Only loaded here,
           on /voicemail — see the showVoicemailWidget prop comment above. -->
      <script
        is:inline
        type="text/javascript"
        src="https://www.speakpipe.com/loader/h06rk7j4thx5m863wodhtbetbdi6pl2n.js"
        async
      ></script>
    )}

  </body>
</html>
