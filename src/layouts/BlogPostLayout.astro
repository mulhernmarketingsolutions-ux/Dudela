---
// Shared shell for every /blog/[slug] post. Mirrors the hero pattern used
// on /podcast and /prepare (eyebrow + h1 + hero-sub on a dark section) so a
// blog post reads like the rest of the site instead of a bolted-on
// WordPress-style template. Body content is the default slot — each post
// page writes its own <p>/<h2>/<PhotoPlaceholder> markup directly rather
// than going through a markdown pipeline, since none is wired up yet (see
// blog plan doc: no @astrojs/mdx dependency exists in package.json).
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  eyebrow: string;
  dek: string; // one-line hook under the h1, same role as hero-sub elsewhere
  date: string; // e.g. "September 2026" — deliberately not day-precise; see blog data file comment
  readTime: string; // e.g. "6 min read"
  ctaHeading: string;
  ctaBody: string;
  ctaHref: string;
  ctaLabel: string;
  // SEO/AEO: image is the post's hero photo (root-relative path, e.g.
  // "/images/blog/receipts-budget.jpg"), used for og:image and the
  // BlogPosting JSON-LD. isoMonth is "September 2026" as ISO-8601
  // (e.g. "2026-09") for article:published_time and datePublished —
  // month-precision only, matching blogPosts.js's deliberate choice not
  // to claim a specific publish day we don't actually have. faqs is an
  // optional list of {q, a} pairs: rendered as a visible "Common
  // questions" section AND as FAQPage structured data, which is what
  // actually gets a post pulled into Google's People Also Ask / AI
  // Overviews and cited by answer engines like ChatGPT/Perplexity
  // instead of just generically indexed.
  image: string;
  isoMonth: string;
  faqs?: { q: string; a: string }[];
}
const { title, description, eyebrow, dek, date, readTime, ctaHeading, ctaBody, ctaHref, ctaLabel, image, isoMonth, faqs } = Astro.props;

const siteUrl = Astro.site ?? Astro.url; // Astro.site comes from astro.config.mjs's `site` (https://thedudelaco.com)
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: imageUrl,
  datePublished: isoMonth,
  dateModified: isoMonth,
  author: { "@type": "Organization", name: "Dudela", url: siteUrl },
  publisher: {
    "@type": "Organization",
    name: "Dudela",
    logo: { "@type": "ImageObject", url: new URL("/logo/dudela-badge-green.png", siteUrl).toString() },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
};

const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<BaseLayout title={`${title} — Dudela`} description={description} type="article" publishedTime={isoMonth} ogImage={image}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <Nav />

  <section class="hero section-dark">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-sub">{dek}</p>
      <p class="meta">{date} · {readTime}</p>
    </div>
  </section>

  <section class="post-body section-light">
    <div class="container prose">
      <slot />

      {faqs && faqs.length > 0 && (
        <div class="faq-block">
          <h2>Common questions</h2>
          {faqs.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="post-cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>{ctaHeading}</h2>
        <p class="hero-sub cta-body">{ctaBody}</p>
      </div>
      <a href={ctaHref} class="btn btn-primary">{ctaLabel} →</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 9rem 0 3rem;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin: 0.5rem 0 1rem;
    max-width: 20ch;
  }
  .hero-sub {
    color: var(--text-on-dark-muted);
    max-width: 56ch;
    margin: 0 0 1rem;
  }
  .meta {
    font-family: var(--font-label);
    font-size: 0.85rem;
    color: var(--text-on-dark-muted);
    opacity: 0.8;
  }
  .post-body {
    padding: var(--space-6) 0;
  }
  .prose {
    max-width: 68ch;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 2.5rem 0 1rem;
  }
  .prose :global(p) {
    color: var(--text-on-light-muted);
    margin: 0 0 1.25rem;
  }
  .prose :global(strong) {
    color: var(--text-on-light);
  }
  .prose :global(ul) {
    color: var(--text-on-light-muted);
    padding-left: 1.25rem;
    margin: 0 0 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(.photo-placeholder) {
    margin: 2rem 0;
  }
  .prose :global(a) {
    color: var(--rust-600);
  }
  .prose :global(.pull-quote) {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    color: var(--text-on-light);
    border-left: 3px solid var(--action);
    padding-left: 1.25rem;
    margin: 2.5rem 0;
  }
  /* Common-questions block -- deliberately plain (no accordion/JS) so the
     Q/A text is always in the rendered HTML for crawlers and answer
     engines to actually read, not hidden behind a click. */
  .faq-block {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-light);
  }
  .faq-block h2 {
    margin-bottom: 1.5rem;
  }
  .faq-item {
    margin-bottom: 1.75rem;
  }
  .faq-item h3 {
    font-family: var(--font-label);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-on-light);
    margin: 0 0 0.4rem;
  }
  .faq-item p {
    color: var(--text-on-light-muted);
    margin: 0;
  }
  .post-cta {
    /* Deliberately light, not dark -- a dark CTA here sits directly above
       the (also dark) Footer, and even with a border between them the two
       read as one fused block, so the CTA gets skipped as "more footer".
       Going light is the actual break: it's unmistakably a different
       section, not just a differently-shaded one. */
    background: var(--bg-light);
    color: var(--text-on-light);
    padding: var(--space-5) 0;
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .cta-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0.5rem 0 0.75rem;
  }
  .cta-body {
    margin: 0;
    /* .hero-sub (shared with the dark hero above) sets a light muted color
       meant for dark backgrounds -- override it here now that this section
       is light. */
    color: var(--text-on-light-muted);
  }
  @media (min-width: 768px) {
    .cta-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .cta-inner > div {
      max-width: 60ch;
    }
  }
</style>
